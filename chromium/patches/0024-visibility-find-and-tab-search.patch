+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: find in page. A floating card in the 2.1 palette; Chromium's own
+// find bar widget is replaced (see vis_find_bar.cc).
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from './browser.mojom-webui.js';
+import {getCss} from './vis_find.css.js';
+import {getHtml} from './vis_find.html.js';
+import {t} from './vis_settings.js';
+
+export class VisFindElement extends CrLitElement {
+  static get is() {
+    return 'vis-find';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      query: {state: true, type: String},
+      active: {state: true, type: Number},
+      total: {state: true, type: Number},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor query: string = '';
+  accessor active: number = 0;
+  accessor total: number = 0;
+
+  readonly t = t;
+
+  show(text: string) {
+    if (text !== '' || !this.open) {
+      this.query = text;
+    }
+    this.open = true;
+    this.updateComplete.then(() => {
+      const input = this.shadowRoot.querySelector('input');
+      input?.focus();
+      input?.select();
+    });
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  setResult(active: number, total: number) {
+    this.active = active;
+    this.total = total;
+  }
+
+  private find_(forward: boolean, findNext: boolean) {
+    browserProxyFactory.getInstance().handler.findInPage(
+        this.query, forward, false, findNext);
+  }
+
+  protected onInput(e: Event) {
+    this.query = (e.target as HTMLInputElement).value;
+    this.find_(true, false);
+  }
+
+  protected onKeydown(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      e.preventDefault();
+      this.find_(!e.shiftKey, true);
+    } else if (e.key === 'Escape') {
+      e.preventDefault();
+      this.onCloseClick();
+    }
+  }
+
+  protected onPrevClick() {
+    this.find_(false, true);
+  }
+
+  protected onNextClick() {
+    this.find_(true, true);
+  }
+
+  protected onCloseClick() {
+    this.open = false;
+    browserProxyFactory.getInstance().handler.closeFindBar(false);
+  }
+
+  protected counter(): string {
+    if (this.query === '') {
+      return '';
+    }
+    return this.total === 0 ? t('findNone') : `${this.active}/${this.total}`;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-find': VisFindElement;
+  }
+}
+
+customElements.define(VisFindElement.is, VisFindElement);
