+void WebUIBrowserPageHandler::FindInPage(const std::string& text,
+                                         bool forward,
+                                         bool match_case,
+                                         bool find_next) {
+  FindBarController* controller = FindBarController::From(GetBrowser());
+  if (!controller || !controller->web_contents()) {
+    return;
+  }
+  std::u16string text16 = base::UTF8ToUTF16(text);
+  if (FindBar* bar = controller->find_bar()) {
+    static_cast<VisFindBar*>(bar)->SetTypedText(text16);
+  }
+  controller->OnUserChangedFindText(text16);
+  find_in_page::FindTabHelper* helper =
+      find_in_page::FindTabHelper::FromWebContents(controller->web_contents());
+  if (!helper) {
+    return;
+  }
+  if (text16.empty()) {
+    helper->StopFinding(find_in_page::SelectionAction::kClear);
+    return;
+  }
+  helper->StartFinding(text16, forward, match_case, /*find_match=*/true);
+}
+
+void WebUIBrowserPageHandler::CloseFindBar(bool activate) {
+  if (FindBarController* controller = FindBarController::From(GetBrowser())) {
+    controller->EndFindSession(
+        activate ? find_in_page::SelectionAction::kActivate
+                 : find_in_page::SelectionAction::kKeep,
+        activate ? find_in_page::ResultAction::kClear
+                 : find_in_page::ResultAction::kKeep);
+  }
+}
