+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {VisTabSearchElement} from './vis_tab_search.js';
+
+export function getHtml(this: VisTabSearchElement) {
+  return html`<!--_html_template_start_-->
+<div class="backdrop" @click="${this.onBackdropClick}"></div>
+<section class="panel" role="dialog" aria-label="${this.t('tabSearch')}"
+    @keydown="${this.onKeydown}">
+  <input type="text" .value="${this.query}" @input="${this.onInput}"
+      placeholder="${this.t('tabSearchPlaceholder')}" spellcheck="false"
+      aria-label="${this.t('tabSearchPlaceholder')}">
+  <div class="list" role="listbox">
+    ${this.filtered().length === 0 ?
+      html`<div class="empty">${this.t('tabSearchEmpty')}</div>` :
+      html`${this.filtered().map((tab, i) => html`
+        <button class="item ${i === this.selected ? 'selected' : ''}"
+            role="option" aria-selected="${i === this.selected}"
+            data-index="${i}" @click="${this.onItemClick}">
+          <span class="ico"
+              style="background-image: url('${tab.favicon}')"></span>
+          <span class="text">
+            <span class="title">${tab.title || tab.url}</span>
+            <span class="url">${tab.url}</span>
+          </span>
+          ${tab.isActive ?
+            html`<span class="badge">${this.t('tabSearchCurrent')}</span>` :
+            html``}
+        </button>`)}`}
+  </div>
+</section>
+<!--_html_template_end_-->`;
+}
