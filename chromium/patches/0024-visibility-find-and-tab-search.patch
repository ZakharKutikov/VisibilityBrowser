index 0000000..8c937c4
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_tab_search.ts
@@ -0,0 +1,122 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: tab search (Ctrl+Shift+A in 2.1). A centered card with a filter
+// field and the open tabs; Enter or a click switches to the tab.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './vis_tab_search.css.js';
+import {getHtml} from './vis_tab_search.html.js';
+import {t} from './vis_settings.js';
+
+export interface SearchableTab {
+  id: string;
+  title: string;
+  url: string;
+  favicon: string;
+  isActive: boolean;
+}
+
+export class VisTabSearchElement extends CrLitElement {
+  static get is() {
+    return 'vis-tab-search';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      query: {state: true, type: String},
+      tabs: {state: true, type: Array},
+      selected: {state: true, type: Number},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor query: string = '';
+  accessor tabs: SearchableTab[] = [];
+  accessor selected: number = 0;
+  private onPick_: ((id: string) => void)|null = null;
+
+  readonly t = t;
+
+  show(tabs: SearchableTab[], onPick: (id: string) => void) {
+    this.tabs = tabs;
+    this.onPick_ = onPick;
+    this.query = '';
+    this.selected = 0;
+    this.open = true;
+    this.updateComplete.then(
+        () => this.shadowRoot.querySelector('input')?.focus());
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  filtered(): SearchableTab[] {
+    const q = this.query.trim().toLowerCase();
+    if (q === '') {
+      return this.tabs;
+    }
+    return this.tabs.filter(
+        tab => tab.title.toLowerCase().includes(q) ||
+            tab.url.toLowerCase().includes(q));
+  }
+
+  protected onInput(e: Event) {
+    this.query = (e.target as HTMLInputElement).value;
+    this.selected = 0;
+  }
+
+  protected onKeydown(e: KeyboardEvent) {
+    const list = this.filtered();
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      this.hide();
+    } else if (e.key === 'ArrowDown') {
+      e.preventDefault();
+      this.selected = Math.min(this.selected + 1, list.length - 1);
+    } else if (e.key === 'ArrowUp') {
+      e.preventDefault();
+      this.selected = Math.max(this.selected - 1, 0);
+    } else if (e.key === 'Enter' && list[this.selected]) {
+      e.preventDefault();
+      this.pick(list[this.selected]!);
+    }
+  }
+
+  protected onItemClick(e: Event) {
+    const index = Number((e.currentTarget as HTMLElement).dataset['index']);
+    const tab = this.filtered()[index];
+    if (tab) {
+      this.pick(tab);
+    }
+  }
+
+  protected pick(tab: SearchableTab) {
+    this.hide();
+    this.onPick_?.(tab.id);
+  }
+
+  protected onBackdropClick() {
+    this.hide();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-tab-search': VisTabSearchElement;
+  }
+}
+
+customElements.define(VisTabSearchElement.is, VisTabSearchElement);
