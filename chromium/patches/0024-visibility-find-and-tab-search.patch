@@ -0,0 +1,96 @@
+#include "chrome/browser/ui/webui_browser/vis_find_bar.h"
+
+#include "chrome/browser/ui/webui_browser/browser.mojom.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_window.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/find_in_page/find_notification_details.h"
+
+VisFindBar::VisFindBar(WebUIBrowserWindow* window) : window_(window) {}
+
+VisFindBar::~VisFindBar() = default;
+
+FindBarController* VisFindBar::GetFindBarController() const {
+  return controller_;
+}
+
+void VisFindBar::SetFindBarController(FindBarController* controller) {
+  controller_ = controller;
+}
+
+void VisFindBar::Show(bool animate, bool focus) {
+  visible_ = true;
+  if (webui_browser::mojom::Page* page = window_->GetWebUIBrowserUI()->page()) {
+    page->ShowFindBar(base::UTF16ToUTF8(text_));
+  }
+}
+
+void VisFindBar::Hide(bool animate) {
+  visible_ = false;
+  if (webui_browser::mojom::Page* page = window_->GetWebUIBrowserUI()->page()) {
+    page->HideFindBar();
+  }
+}
+
+void VisFindBar::SetFocusAndSelection() {
+  if (visible_) {
+    Show(false, true);
+  }
+}
+
+void VisFindBar::ClearResults(
+    const find_in_page::FindNotificationDetails& results) {
+  PushResult(0, 0);
+}
+
+void VisFindBar::SetFindTextAndSelectedRange(const std::u16string& find_text,
+                                             const gfx::Range& selected_range) {
+  text_ = find_text;
+  if (visible_) {
+    Show(false, true);
+  }
+}
+
+std::u16string_view VisFindBar::GetFindText() const {
+  return text_;
+}
+
+gfx::Range VisFindBar::GetSelectedRange() const {
+  return gfx::Range(0, text_.size());
+}
+
+void VisFindBar::UpdateUIForFindResult(
+    const find_in_page::FindNotificationDetails& result,
+    const std::u16string& find_text) {
+  PushResult(result.active_match_ordinal(), result.number_of_matches());
+}
+
+bool VisFindBar::IsFindBarVisible() const {
+  return visible_;
+}
+
+bool VisFindBar::HasGlobalFindPasteboard() const {
+  return false;
+}
+
+bool VisFindBar::CanPopulateFromSelectedText() {
+  return true;
+}
+
+const FindBarTesting* VisFindBar::GetFindBarTesting() const {
+  return nullptr;
+}
+
+bool VisFindBar::HasFocus() const {
+  return visible_;
+}
+
+views::Widget* VisFindBar::GetHostWidget() {
+  return nullptr;
+}
+
+void VisFindBar::PushResult(int active, int total) {
+  if (webui_browser::mojom::Page* page = window_->GetWebUIBrowserUI()->page()) {
+    page->SetFindResult(active < 0 ? 0 : active, total < 0 ? 0 : total);
+  }
+}
diff --git a/chrome/browser/ui/webui_browser/vis_find_bar.h b/chrome/browser/ui/webui_browser/vis_find_bar.h
