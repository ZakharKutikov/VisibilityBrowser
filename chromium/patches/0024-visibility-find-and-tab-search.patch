diff --git a/chrome/browser/resources/webui_browser/vis_find.css b/chrome/browser/resources/webui_browser/vis_find.css
new file mode 100644
index 0000000..7651219
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_find.css
@@ -0,0 +1,96 @@
+/* Copyright 2026 The Chromium Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  position: fixed;
+  top: 98px;
+  right: 24px;
+  z-index: 940;
+  display: none;
+  font-family: 'Inter', 'Segoe UI Variable Text', 'Segoe UI', system-ui,
+      sans-serif;
+  font-size: 13px;
+  color: #f8fafc;
+}
+
+:host([open]) {
+  display: block;
+}
+
+.card {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  padding: 6px 6px 6px 12px;
+  background: #1e202a;
+  border: 1px solid rgba(255, 255, 255, 14%);
+  border-radius: 12px;
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 55%);
+}
+
+input {
+  width: 190px;
+  background: transparent;
+  border: none;
+  outline: none;
+  color: inherit;
+  font: inherit;
+  user-select: text;
+}
+
+input::placeholder {
+  color: rgba(255, 255, 255, 45%);
+}
+
+.count {
+  min-width: 34px;
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+  color: #94a3b8;
+  font-size: 12px;
+}
+
+.count.none {
+  color: #f55;
+}
+
+.sep {
+  width: 1px;
+  height: 16px;
+  margin: 0 4px;
+  background: rgba(255, 255, 255, 14%);
+}
+
+.btn {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 26px;
+  height: 26px;
+  padding: 0;
+  border: none;
+  border-radius: 8px;
+  background: transparent;
+  color: #94a3b8;
+  cursor: pointer;
+}
+
+.btn:hover {
+  background: rgba(255, 255, 255, 8%);
+  color: #f8fafc;
+}
+
+:focus-visible {
+  outline: 2px solid #818cf8;
+  outline-offset: 1px;
+}
+
+input:focus-visible {
+  outline: none;
+}
diff --git a/chrome/browser/resources/webui_browser/vis_find.html.ts b/chrome/browser/resources/webui_browser/vis_find.html.ts
new file mode 100644
index 0000000..b2c1473
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_find.html.ts
@@ -0,0 +1,39 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {VisFindElement} from './vis_find.js';
+
+export function getHtml(this: VisFindElement) {
+  return html`<!--_html_template_start_-->
+<div class="card" role="search" @keydown="${this.onKeydown}">
+  <input type="text" .value="${this.query}" @input="${this.onInput}"
+      placeholder="${this.t('findPlaceholder')}" spellcheck="false"
+      aria-label="${this.t('findPlaceholder')}">
+  <span class="count ${this.total === 0 && this.query !== '' ? 'none' : ''}">
+    ${this.counter()}</span>
+  <span class="sep"></span>
+  <button class="btn" title="${this.t('findPrev')}" @click="${this.onPrevClick}">
+    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
+        stroke="currentColor" stroke-width="2" stroke-linecap="round"
+        stroke-linejoin="round" aria-hidden="true">
+      <polyline points="18,15 12,9 6,15"/></svg>
+  </button>
+  <button class="btn" title="${this.t('findNext')}" @click="${this.onNextClick}">
+    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
+        stroke="currentColor" stroke-width="2" stroke-linecap="round"
+        stroke-linejoin="round" aria-hidden="true">
+      <polyline points="6,9 12,15 18,9"/></svg>
+  </button>
+  <button class="btn" title="${this.t('close')}" @click="${this.onCloseClick}">
+    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
+        stroke="currentColor" stroke-width="2" stroke-linecap="round"
+        stroke-linejoin="round" aria-hidden="true">
+      <line x1="18" y1="6" x2="6" y2="18"/>
+      <line x1="6" y1="6" x2="18" y2="18"/></svg>
+  </button>
+</div>
+<!--_html_template_end_-->`;
+}
