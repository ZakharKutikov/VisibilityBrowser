new file mode 100644
index 0000000..ffe7c5f
--- /dev/null
+++ b/chrome/browser/resources/new_tab_page_visibility/BUILD.gn
@@ -0,0 +1,40 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//ui/webui/resources/tools/build_webui.gni")
+
+assert(!is_android)
+
+build_webui("build") {
+  grd_prefix = "new_tab_page_visibility"
+
+  # app.css is linked from the page as-is, not imported as a Lit style. The
+  # font is served as a file: a data: URL font is fetched through the WebUI
+  # loader, which only accepts chrome:// and kills the page's renderer.
+  static_files = [
+    "new_tab_page_visibility.html",
+    "app.css",
+    "fonts/GolosText.ttf",
+  ]
+
+  ts_files = [
+    "app.ts",
+    "lib/sky.ts",
+    "lib/weather.ts",
+    "lib/sites.ts",
+    "lib/suggestions.ts",
+  ]
+
+
+  mojo_files_deps =
+      [ "//chrome/browser/ui/webui/new_tab_page_visibility:mojo_bindings_ts__generator" ]
+  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/new_tab_page_visibility/new_tab_page_visibility.mojom-webui.ts" ]
+
+  ts_deps = [
+    "//ui/webui/resources/js:build_ts",
+    "//ui/webui/resources/mojo:build_ts",
+  ]
+
+  webui_context_type = "trusted"
+}
diff --git a/chrome/browser/resources/new_tab_page_visibility/app.css b/chrome/browser/resources/new_tab_page_visibility/app.css
new file mode 100644
index 0000000..cc1abd7
--- /dev/null
+++ b/chrome/browser/resources/new_tab_page_visibility/app.css
@@ -0,0 +1,460 @@
+/* Copyright 2026 The Chromium Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* Visibility new tab: the start page of Visibility 2.1 -- clock and greeting
+ * in the middle, a pill search field, round brand shortcuts, a glass weather
+ * card and recent visits below. Ported from ntp-extension/newtab.css. */
+@font-face {
+  font-family: 'Golos Text';
+  src: url(fonts/GolosText.ttf) format('truetype');
+  font-weight: 400 900;
+  font-display: block;
+}
+
+:root {
+  color-scheme: dark;
+  --bg-primary: #0d0e12;
+  --bg-secondary: #15171e;
+  --bg-hover: rgba(255, 255, 255, .06);
+  --text-primary: #f8fafc;
+  --text-secondary: #94a3b8;
+  --text-muted: rgba(255, 255, 255, .45);
+  --accent: #818cf8;
+  --accent-hover: #6366f1;
+  --border: rgba(255, 255, 255, .08);
+  --danger: #ff8a8a;
+  --radius-md: 12px;
+  --ease-ios: cubic-bezier(.32, .72, 0, 1);
+}
+
+* { box-sizing: border-box; }
+
+html,
+ body { min-height: 100%;
+ margin: 0; }
+
+body {
+  background: radial-gradient(ellipse at 50% 25%, #181a28 0%, var(--bg-primary) 70%) fixed, var(--bg-primary);
+  color: var(--text-primary);
+  font: 400 14px/1.45 'Golos Text', 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+
+h2,
+ p,
+ ul { margin: 0;
+ padding: 0; }
+
+ul { list-style: none; }
+
+button,
+ input { font: inherit;
+ color: inherit; }
+
+a { color: inherit;
+ text-decoration: none; }
+
+[hidden] { display: none !important; }
+
+:focus-visible { outline: 2px solid var(--accent);
+ outline-offset: 3px; }
+
+.page {
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: 0 20px;
+}
+
+/* ---------- clock and greeting ---------- */
+
+.hero { text-align: center;
+ padding-top: 12vh;
+ margin-bottom: 32px; }
+
+.clock {
+  display: block;
+  font-size: 72px;
+  font-weight: 200;
+  line-height: 1;
+  letter-spacing: -2px;
+  font-variant-numeric: tabular-nums;
+}
+
+.greeting { margin-top: 8px;
+ font-size: 20px;
+ letter-spacing: .02em;
+ color: var(--text-secondary); }
+
+/* ---------- search ---------- */
+
+.search {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  width: 580px;
+  max-width: 90vw;
+  height: 48px;
+  margin-bottom: 32px;
+  padding: 0 20px;
+  border: 1px solid rgba(255, 255, 255, .1);
+  border-radius: 24px;
+  background: rgba(255, 255, 255, .04);
+  box-shadow: 0 8px 32px rgba(0, 0, 0, .4);
+  backdrop-filter: blur(16px);
+  color: var(--text-muted);
+  transition: background .22s var(--ease-ios), border-color .22s var(--ease-ios), box-shadow .22s var(--ease-ios);
+}
+
+.search:hover { background: rgba(255, 255, 255, .07);
+ border-color: rgba(255, 255, 255, .18);
+ box-shadow: 0 10px 36px rgba(0, 0, 0, .5); }
+
+.search:focus-within {
+  border-color: var(--accent);
+  background: rgba(22, 22, 28, .95);
+  box-shadow: 0 0 0 3px rgba(129, 140, 248, .3), 0 12px 40px rgba(0, 0, 0, .6);
+}
+
+.search svg { flex-shrink: 0; }
+
+.search input {
+  flex: 1;
+  min-width: 0;
+  height: 100%;
+  border: 0;
+  outline: 0;
+  background: none;
+  color: var(--text-primary);
+  font-size: 15px;
+}
+
+.search input::placeholder { color: var(--text-muted); }
+
+/* ---------- search suggestions (ported from 2.1) ---------- */
+
+.suggestions {
+  position: fixed;
+  background: rgba(24, 24, 28, .94);
+  border: 1px solid rgba(255, 255, 255, .12);
+  border-radius: 14px;
+  box-shadow: 0 16px 48px rgba(0, 0, 0, .6), 0 0 0 1px rgba(255, 255, 255, .05);
+  z-index: 10000;
+  overflow-y: auto;
+  max-height: 380px;
+  padding: 6px;
+  backdrop-filter: blur(24px);
+  box-sizing: border-box;
+}
+
+.suggestions::-webkit-scrollbar { width: 4px; }
+
+.suggestions::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, .12);
+ border-radius: 10px; }
+
+.suggestion-item {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 9px 12px;
+  margin-bottom: 2px;
+  border-radius: 10px;
+  cursor: pointer;
+  transition: all .18s var(--ease-ios);
+}
+
+.suggestion-item:last-child { margin-bottom: 0; }
+
+.suggestion-item:hover,
+ .suggestion-item.selected {
+  background: rgba(255, 255, 255, .08);
+  transform: translateX(2px);
+}
+
+.suggestion-icon {
+  width: 28px;
+  height: 28px;
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--accent);
+  background: rgba(255, 255, 255, .05);
+  border: 1px solid rgba(255, 255, 255, .06);
+  border-radius: 8px;
+  overflow: hidden;
+  transition: transform .15s, background .15s;
+}
+
+.suggestion-item:hover .suggestion-icon,
+ .suggestion-item.selected .suggestion-icon {
+  transform: scale(1.06);
+  background: rgba(255, 255, 255, .1);
+}
+
+.suggestion-icon img { width: 16px;
+ height: 16px;
+ object-fit: contain; }
+
+.suggestion-content { flex: 1;
+ min-width: 0; }
+
+.suggestion-text { font-size: 13px;
+ font-weight: 500;
+ color: var(--text-primary);
+ white-space: nowrap;
+ overflow: hidden;
+ text-overflow: ellipsis; }
+
+.suggestion-url { margin-top: 2px;
+ font-size: 11px;
+ color: var(--text-muted);
+ white-space: nowrap;
+ overflow: hidden;
+ text-overflow: ellipsis; }
+
+.suggestion-type {
+  flex-shrink: 0;
+  font-size: 10px;
+  font-weight: 600;
+  padding: 3px 8px;
+  border-radius: 12px;
+}
+
+.suggestion-type.type-history {
+  background: rgba(255, 255, 255, .05);
+  color: rgba(255, 255, 255, .55);
+  border: 1px solid rgba(255, 255, 255, .08);
+}
+
+.suggestion-type.type-search {
+  background: rgba(129, 140, 248, .12);
+  color: #93c5fd;
+  border: 1px solid rgba(129, 140, 248, .22);
+}
+
+/* ---------- shortcuts ---------- */
+
+.shortcuts {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 16px;
+  max-width: 800px;
+  margin-bottom: 32px;
+}
+
+.shortcut {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8px;
+  width: 72px;
+  border-radius: 12px;
+  transition: transform .15s var(--ease-ios);
+}
+
+.shortcut:hover { transform: scale(1.08); }
+
+.shortcut:active { transform: scale(.96); }
+
+.shortcut-icon {
+  display: grid;
+  place-items: center;
+  width: 48px;
+  height: 48px;
+  overflow: hidden;
+  border-radius: 50%;
+  background: var(--bg-secondary);
+  box-shadow: 0 2px 8px rgba(0, 0, 0, .25);
+  transition: transform .15s var(--ease-ios), box-shadow .15s var(--ease-ios);
+}
+
+.shortcut:hover .shortcut-icon { transform: scale(1.1);
+ box-shadow: 0 4px 16px rgba(0, 0, 0, .35); }
+
+.shortcut-name {
+  max-width: 72px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 11px;
+  font-weight: 500;
+  color: var(--text-muted);
+  text-align: center;
+}
+
+/* ---------- weather card ---------- */
+
+.weather-card {
+  min-width: 280px;
+  max-width: 360px;
+  margin-bottom: 40px;
+  border: 1px solid rgba(255, 255, 255, .08);
+  border-radius: 16px;
+  background: rgba(255, 255, 255, .06);
+  backdrop-filter: blur(20px);
+  transition: background .2s var(--ease-ios);
+}
+
+.weather-card:hover { background: rgba(255, 255, 255, .09); }
+
+.weather-main {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  width: 100%;
+  padding: 16px 24px;
+  border: 0;
+  border-radius: 16px;
+  background: none;
+  text-align: left;
+  cursor: pointer;
+}
+
+.weather-icon { flex-shrink: 0;
+ font-size: 40px;
+ line-height: 1; }
+
+.weather-info { display: flex;
+ flex-direction: column;
+ gap: 2px;
+ min-width: 0; }
+
+.weather-temp { font-size: 28px;
+ font-weight: 700;
+ line-height: 1; }
+
+.weather-desc { font-size: 13px;
+ font-weight: 500;
+ color: var(--text-secondary); }
+
+.city { display: grid;
+ gap: 10px;
+ padding: 16px 20px; }
+
+.city input {
+  width: 100%;
+  padding: 9px 12px;
+  border: 1px solid rgba(255, 255, 255, .12);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, .06);
+  outline: none;
+}
+
+.city input:focus { border-color: var(--accent); }
+
+.city input::placeholder { color: var(--text-muted); }
+
+.city-actions { display: flex;
+ align-items: center;
+ justify-content: space-between;
+ gap: 10px; }
+
+.btn-primary {
+  padding: 8px 16px;
+  border: 0;
+  border-radius: 8px;
+  background: var(--accent);
+  color: var(--bg-primary);
+  font-weight: 600;
+  cursor: pointer;
+  transition: background .15s, transform .1s;
+}
+
+.btn-primary:hover { background: var(--accent-hover); }
+
+.btn-primary:active { transform: scale(.97); }
+
+.btn-text { padding: 0;
+ border: 0;
+ background: none;
+ color: var(--text-secondary);
+ cursor: pointer; }
+
+.btn-text:hover { color: var(--text-primary); }
+
+.weather-error { padding: 0 20px 14px;
+ font-size: 12px;
+ color: var(--danger); }
+
+/* ---------- recent visits ---------- */
+
+.recent-section { width: 100%;
+ max-width: 800px;
+ text-align: center; }
+
+.recent-title { font-size: 14px;
+ font-weight: 600;
+ color: var(--text-secondary); }
+
+.recent {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
+  gap: 20px;
+  margin-top: 24px;
+}
+
+.recent a {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: 15px;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--bg-secondary);
+  transition: transform .2s var(--ease-ios), background .2s var(--ease-ios);
+}
+
+.recent a:hover { transform: translateY(-5px);
+ background: var(--bg-hover); }
+
+.recent img { width: 24px;
+ height: 24px;
+ margin-bottom: 10px; }
+
+.recent-name {
+  width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 13px;
+  font-weight: 500;
+}
+
+.recent-host { width: 100%;
+ overflow: hidden;
+ text-overflow: ellipsis;
+ white-space: nowrap;
+ font-size: 11px;
+ color: var(--text-muted); }
+
+/* ---------- footer ---------- */
+
+.footer { margin-top: auto;
+ padding: 40px 0 20px;
+ font-size: 11px;
+ color: var(--text-muted);
+ opacity: .5; }
+
+/* One arrival: the clock settles, the rest follows. */
+@media (prefers-reduced-motion: no-preference) {
+  .hero,
+ .search,
+ .shortcuts,
+ .weather-card { animation: settle .6s var(--ease-ios) both; }
+  .search { animation-delay: .05s; }
+  .shortcuts { animation-delay: .1s; }
+  .weather-card { animation-delay: .15s; }
+  @keyframes settle { from { opacity: 0;
+ transform: translateY(12px); } }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+ *::before,
+ *::after { transition-duration: .01ms !important;
+ animation: none !important; }
+}
diff --git a/chrome/browser/resources/new_tab_page_visibility/app.ts b/chrome/browser/resources/new_tab_page_visibility/app.ts
new file mode 100644
index 0000000..aa4d2f5
--- /dev/null
+++ b/chrome/browser/resources/new_tab_page_visibility/app.ts
@@ -0,0 +1,441 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: the 2.1-style new tab page, now a native WebUI page instead of
+// a component extension -- see new_tab_page_visibility.mojom for why. Ported
+// from ntp-extension/newtab.js, with chrome.storage.local -> localStorage,
+// chrome.history.search/chrome.search.query -> the PageHandler mojo calls,
+// and chrome.i18n -> loadTimeData (the page's static text already went
+// through $i18n{} in the HTML, so there is no data-i18n hydration here).
+
+import {loadTimeData} from '//resources/js/load_time_data.js';
+
+import {greetingKey} from './lib/sky.js';
+import type {City, Weather} from './lib/weather.js';
+import {conditionKey, currentWeather, findCity, formatTemp, locateByIp} from './lib/weather.js';
+import type {HistoryLikeEntry} from './lib/sites.js';
+import {pickRecent} from './lib/sites.js';
+import type {Suggestion} from './lib/suggestions.js';
+import {historyToSuggestions, mergeSuggestions, parseGoogleSuggestions} from './lib/suggestions.js';
+import {browserProxyFactory} from './new_tab_page_visibility.mojom-webui.js';
+
+const $ = (id: string) => document.getElementById(id)!;
+const t = (key: string) => loadTimeData.getString(key);
+const handler = browserProxyFactory.getInstance().handler;
+
+// A chrome:// page cannot fetch() remote sites (the renderer is killed), so
+// remote data is downloaded by the browser process; see PageHandler.FetchText.
+const fetchViaBrowser = (async (input: RequestInfo|URL) => {
+  const url = typeof input === 'string' ? input :
+      input instanceof URL           ? input.href :
+                                       input.url;
+  const {status, body} = await handler.fetchText(url);
+  return new Response(body, {status: status || 502});
+}) as typeof fetch;
+
+function favicon(url: string, size: number): string {
+  return `chrome://favicon2/?size=${size}&scaleFactor=1x&pageUrl=${
+      encodeURIComponent(url)}&allowGoogleServerFallback=0`;
+}
+
+// ---------- clock and greeting ----------
+
+const timeFormat = new Intl.DateTimeFormat(
+    navigator.language, {hour: '2-digit', minute: '2-digit'});
+
+function tick() {
+  const now = new Date();
+  $('clock').textContent = timeFormat.format(now);
+  ($('clock') as HTMLTimeElement).dateTime = now.toISOString();
+  $('greeting').textContent = t(greetingKey(now.getHours()));
+  // Wake exactly at the start of the next minute.
+  setTimeout(
+      tick, 60000 - (now.getSeconds() * 1000 + now.getMilliseconds()) + 20);
+}
+tick();
+
+// ---------- search or address ----------
+
+function asUrl(text: string): string|null {
+  if (/^[a-z][a-z0-9+.-]*:\/\//i.test(text)) return text;
+  // "example.com", "localhost:3000", "example.com/path" without spaces.
+  if (!/\s/.test(text) &&
+      /^(localhost|[\w-]+(\.[\w-]+)+)(:\d+)?(\/.*)?$/i.test(text)) {
+    return 'https://' + text;
+  }
+  return null;
+}
+
+function goTo(text: string) {
+  const url = asUrl(text);
+  if (url) {
+    location.href = url;
+  } else {
+    handler.openSearch(text);
+  }
+}
+
+$('search-form').addEventListener('submit', (e: Event) => {
+  e.preventDefault();
+  const text = ($('search-input') as HTMLInputElement).value.trim();
+  if (!text) return;
+  goTo(text);
+  hideSuggestions();
+});
+
+// ---------- search suggestions (ported from 2.1) ----------
+
+const SEARCH_ICON =
+    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>';
+const HISTORY_ICON =
+    '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>';
+
+function debounce<Args extends unknown[]>(
+    fn: (...args: Args) => void, ms: number): (...args: Args) => void {
+  let timer = 0;
+  return (...args: Args) => {
+    clearTimeout(timer);
+    timer = setTimeout(() => fn(...args), ms);
+  };
+}
+
+async function fetchGoogleSuggestions(q: string): Promise<Suggestion[]> {
+  try {
+    const resp = await fetchViaBrowser(
+        `https://suggestqueries.google.com/complete/search?client=chrome&q=${
+            encodeURIComponent(q)}`);
+    return parseGoogleSuggestions(await resp.json());
+  } catch {
+    return [];
+  }
+}
+
+async function fetchHistorySuggestions(q: string): Promise<Suggestion[]> {
+  const {entries} = await handler.queryHistory(q, 20);
+  return historyToSuggestions(entries);
+}
+
+let suggestionResults: Suggestion[] = [];
+let selectedIdx = -1;
+let outsideClickHandler: ((e: Event) => void)|null = null;
+
+function hideSuggestions() {
+  $('suggestions').hidden = true;
+  suggestionResults = [];
+  selectedIdx = -1;
+  if (outsideClickHandler) {
+    document.removeEventListener('click', outsideClickHandler);
+    outsideClickHandler = null;
+  }
+}
+
+function highlightSelected() {
+  for (const el of $('suggestions').children) {
+    el.classList.toggle(
+        'selected', Number((el as HTMLElement).dataset['idx']) === selectedIdx);
+  }
+}
+
+function renderSuggestions(results: Suggestion[]) {
+  if (!results.length) {
+    hideSuggestions();
+    return;
+  }
+
+  suggestionResults = results;
+  const list = $('suggestions');
+  selectedIdx = -1;
+  list.replaceChildren(...results.map((res, idx) => {
+    const isHistory = res.type === 'history';
+    const item = document.createElement('div');
+    item.className = 'suggestion-item';
+    item.dataset['idx'] = String(idx);
+
+    const icon = document.createElement('span');
+    icon.className = 'suggestion-icon';
+    if (isHistory) {
+      const img = document.createElement('img');
+      img.src = favicon(res.url || '', 32);
+      img.alt = '';
+      img.addEventListener('error', () => {
+        icon.innerHTML = HISTORY_ICON;
+      });
+      icon.append(img);
+    } else {
+      icon.innerHTML = SEARCH_ICON;
+    }
+
+    const content = document.createElement('div');
+    content.className = 'suggestion-content';
+    const text = document.createElement('span');
+    text.className = 'suggestion-text';
+    text.textContent = res.text;
+    content.append(text);
+    if (res.url) {
+      const urlEl = document.createElement('span');
+      urlEl.className = 'suggestion-url';
+      urlEl.textContent = res.url;
+      content.append(urlEl);
+    }
+
+    const type = document.createElement('span');
+    type.className = `suggestion-type ${isHistory ? 'type-history' : 'type-search'}`;
+    type.textContent = isHistory ? t('suggestTypeHistory') : t('suggestTypeSearch');
+
+    item.append(icon, content, type);
+    item.addEventListener('click', () => {
+      goTo(res.url || res.text);
+      hideSuggestions();
+    });
+    return item;
+  }));
+
+  const rect = $('search-form').getBoundingClientRect();
+  list.style.left = `${rect.left}px`;
+  list.style.width = `${rect.width}px`;
+  list.style.top = `${rect.bottom + 6}px`;
+  list.hidden = false;
+
+  if (outsideClickHandler) {
+    document.removeEventListener('click', outsideClickHandler);
+  }
+  outsideClickHandler = (e: Event) => {
+    if (!list.contains(e.target as Node) && e.target !== $('search-input')) {
+      hideSuggestions();
+    }
+  };
+  setTimeout(() => document.addEventListener('click', outsideClickHandler!), 0);
+}
+
+const updateSuggestions = debounce(async (q: string) => {
+  q = q.trim();
+  if (q.length < 2) {
+    hideSuggestions();
+    return;
+  }
+  const [historyItems, searchItems] = await Promise.all([
+    fetchHistorySuggestions(q),
+    fetchGoogleSuggestions(q),
+  ]);
+  renderSuggestions(mergeSuggestions(historyItems, searchItems));
+}, 100);
+
+$('search-input').addEventListener(
+    'input',
+    () => updateSuggestions(($('search-input') as HTMLInputElement).value));
+
+$('search-input').addEventListener('keydown', (e: Event) => {
+  const ke = e as KeyboardEvent;
+  if ($('suggestions').hidden) return;
+  if (ke.key === 'ArrowDown') {
+    ke.preventDefault();
+    selectedIdx = (selectedIdx + 1) % suggestionResults.length;
+    highlightSelected();
+  } else if (ke.key === 'ArrowUp') {
+    ke.preventDefault();
+    selectedIdx =
+        (selectedIdx - 1 + suggestionResults.length) % suggestionResults.length;
+    highlightSelected();
+  } else if (ke.key === 'Enter' && selectedIdx !== -1) {
+    ke.preventDefault();
+    const res = suggestionResults[selectedIdx]!;
+    goTo(res.url || res.text);
+    hideSuggestions();
+  } else if (ke.key === 'Escape') {
+    hideSuggestions();
+  }
+});
+
+$('search-input').addEventListener(
+    'blur', () => setTimeout(hideSuggestions, 200));
+
+// ---------- recent visits ----------
+
+function renderRecent(items: Array<{title: string, url: string, host: string}>) {
+  $('recent-section').hidden = items.length === 0;
+  $('recent').replaceChildren(...items.map((item) => {
+    const li = document.createElement('li');
+    const a = document.createElement('a');
+    a.href = item.url;
+    a.title = item.url;
+
+    const img = document.createElement('img');
+    img.src = favicon(item.url, 32);
+    img.alt = '';
+
+    const name = document.createElement('span');
+    name.className = 'recent-name';
+    name.textContent = item.title;
+
+    const host = document.createElement('span');
+    host.className = 'recent-host';
+    host.textContent = item.host;
+
+    a.append(img, name, host);
+    li.append(a);
+    return li;
+  }));
+}
+
+async function loadRecent() {
+  const weekAgo = Date.now() - 7 * 24 * 3600 * 1000;
+  const {entries} = await handler.queryHistory('', 80);
+  const history: HistoryLikeEntry[] = entries
+      .filter(e => e.lastVisitMs >= weekAgo)
+      .map(e => ({title: e.title, url: e.url, lastVisitTime: e.lastVisitMs}));
+  renderRecent(pickRecent(history, 8));
+}
+loadRecent();
+
+// ---------- weather ----------
+
+interface WeatherStore {
+  city?: City;
+  weather?: Weather&{at: number};
+  citySource?: 'auto'|'manual';
+}
+
+const WEATHER_KEY = 'ntp-weather';
+const WEATHER_TTL = 15 * 60 * 1000;
+const WEATHER_ICON: Record<string, string> = {
+  wxClear: '☀️',
+  wxPartly: '⛅',
+  wxOvercast: '☁️',
+  wxFog: '🌫️',
+  wxDrizzle: '🌦️',
+  wxFreezing: '🌨️',
+  wxRain: '🌧️',
+  wxSnow: '❄️',
+  wxShowers: '🌧️',
+  wxThunder: '⛈️',
+  wxUnknown: '🌤️',
+};
+
+function readStore(): WeatherStore {
+  try {
+    const raw = window.localStorage.getItem(WEATHER_KEY);
+    return raw ? JSON.parse(raw) : {};
+  } catch {
+    return {};
+  }
+}
+
+function writeStore(patch: Partial<WeatherStore>) {
+  const next = {...readStore(), ...patch};
+  window.localStorage.setItem(WEATHER_KEY, JSON.stringify(next));
+}
+
+function clearStore(keys: Array<keyof WeatherStore>) {
+  const next = readStore();
+  for (const key of keys) delete next[key];
+  window.localStorage.setItem(WEATHER_KEY, JSON.stringify(next));
+}
+
+function showWeather(city: City|null, wx: Weather|null) {
+  if (city && wx) {
+    const key = conditionKey(wx.code);
+    $('weather-icon').textContent = WEATHER_ICON[key] || '🌤️';
+    $('weather-temp').textContent = formatTemp(wx.temp);
+    $('weather-text').textContent = [t(key), city.name].filter(Boolean).join(' · ');
+    $('weather-now').title = t('weatherChange');
+  } else {
+    $('weather-icon').textContent = '🌤️';
+    $('weather-temp').textContent = '--°C';
+    $('weather-text').textContent = t('weatherSet');
+    $('weather-now').title = t('weatherSet');
+  }
+}
+
+function weatherError(text: string) {
+  $('weather-error').textContent = text;
+  $('weather-error').hidden = !text;
+}
+
+async function loadWeather() {
+  let {city, weather, citySource} = readStore();
+
+  // No city yet (first run, or IP lookup never worked): try the user's IP
+  // once, like 2.1 did, so the card works with nothing typed. A city the
+  // user picked themselves (citySource === 'manual') is never overwritten.
+  if (!city && citySource !== 'manual') {
+    const found = await locateByIp(fetchViaBrowser).catch(() => null);
+    if (found) {
+      city = found;
+      writeStore({city, citySource: 'auto'});
+    }
+  }
+  if (!city) {
+    showWeather(null, null);
+    return;
+  }
+
+  // Show what we have at once, then refresh it if it is stale.
+  showWeather(city, weather || null);
+  if (weather && Date.now() - weather.at < WEATHER_TTL) return;
+  try {
+    const fresh = {...await currentWeather(city, fetchViaBrowser), at: Date.now()};
+    writeStore({weather: fresh});
+    showWeather(city, fresh);
+    weatherError('');
+  } catch {
+    if (!weather) weatherError(t('weatherOffline'));
+  }
+}
+
+function editCity(open: boolean) {
+  $('city-form').hidden = !open;
+  $('weather-now').hidden = open;
+  if (open) {
+    weatherError('');
+    const input = $('city-input') as HTMLInputElement;
+    input.focus();
+    input.select();
+  }
+}
+
+$('weather-now').addEventListener('click', () => {
+  ($('city-input') as HTMLInputElement).value = readStore().city?.name || '';
+  editCity(true);
+});
+
+$('city-form').addEventListener('submit', async (e: Event) => {
+  e.preventDefault();
+  const query = ($('city-input') as HTMLInputElement).value.trim();
+  if (!query) return;
+  try {
+    const city = await findCity(
+        query, navigator.language.split('-')[0]!, fetchViaBrowser);
+    if (!city) {
+      weatherError(loadTimeData.getStringF('cityNotFound', query));
+      return;
+    }
+    writeStore({city, citySource: 'manual'});
+    clearStore(['weather']);
+  } catch {
+    weatherError(t('weatherOffline'));
+    return;
+  }
+  editCity(false);
+  loadWeather();
+});
+
+$('city-remove').addEventListener('click', () => {
+  // "Don't show weather": remembered as a manual choice, so the next IP
+  // lookup does not bring the card back on its own.
+  clearStore(['city', 'weather']);
+  writeStore({citySource: 'manual'});
+  editCity(false);
+  weatherError('');
+  loadWeather();
+});
+
+$('city-form').addEventListener('keydown', (e: Event) => {
+  if ((e as KeyboardEvent).key === 'Escape') {
+    editCity(false);
+    weatherError('');
+    loadWeather();
+  }
+});
+
+loadWeather();
