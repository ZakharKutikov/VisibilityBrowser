@@ -0,0 +1,173 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/new_tab_page_visibility/new_tab_page_visibility_page_handler.h"
+
+#include <algorithm>
+#include <iterator>
+#include <optional>
+#include <string_view>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/history/history_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "components/history/core/browser/history_service.h"
+#include "components/history/core/browser/history_types.h"
+#include "components/keyed_service/core/service_access_type.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/search_engines/util.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_contents.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace {
+
+// The only hosts the new tab page may reach: weather, geolocation by IP and
+// search suggestions. Anything else is refused.
+constexpr std::string_view kAllowedHosts[] = {
+    "api.open-meteo.com",       "geocoding-api.open-meteo.com",
+    "ipwhois.app",              "wttr.in",
+    "suggestqueries.google.com",
+};
+
+// Weather and suggestion replies are a few kilobytes.
+constexpr size_t kMaxResponseBytes = 256 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kFetchAnnotation =
+    net::DefineNetworkTrafficAnnotation("visibility_new_tab_fetch", R"(
+        semantics {
+          sender: "Visibility new tab page"
+          description:
+            "Loads the weather for the user's city, a rough location by IP "
+            "address to pick that city, and search suggestions as the user "
+            "types in the new tab page's search box."
+          trigger: "Opening a new tab, or typing in its search box."
+          data:
+            "The text typed in the search box, or a city name or "
+            "coordinates. No cookies or account data are sent."
+          destination: OTHER
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Not configurable yet."
+          policy_exception_justification: "Not implemented."
+        })");
+
+}  // namespace
+
+NewTabPageVisibilityPageHandler::NewTabPageVisibilityPageHandler(
+    mojo::PendingReceiver<new_tab_page_visibility::mojom::PageHandler>
+        receiver,
+    Profile* profile,
+    content::WebContents* web_contents)
+    : receiver_(this, std::move(receiver)),
+      profile_(profile),
+      web_contents_(web_contents) {}
+
+NewTabPageVisibilityPageHandler::~NewTabPageVisibilityPageHandler() = default;
+
+void NewTabPageVisibilityPageHandler::QueryHistory(
+    const std::string& query,
+    int32_t max_count,
+    QueryHistoryCallback callback) {
+  history::HistoryService* history = HistoryServiceFactory::GetForProfile(
+      profile_, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history) {
+    std::move(callback).Run({});
+    return;
+  }
+  history::QueryOptions options;
+  options.max_count = std::clamp(max_count, 1, 500);
+  options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+  history->QueryHistory(
+      base::UTF8ToUTF16(query), options,
+      base::BindOnce(
+          [](QueryHistoryCallback cb, history::QueryResults results) {
+            std::vector<new_tab_page_visibility::mojom::HistoryEntryPtr>
+                entries;
+            for (const history::URLResult& r : results) {
+              if (!r.url().SchemeIsHTTPOrHTTPS()) {
+                continue;
+              }
+              entries.push_back(
+                  new_tab_page_visibility::mojom::HistoryEntry::New(
+                      base::UTF16ToUTF8(r.title()), r.url().spec(),
+                      r.visit_time().InMillisecondsFSinceUnixEpoch()));
+            }
+            std::move(cb).Run(std::move(entries));
+          },
+          std::move(callback)),
+      &history_task_tracker_);
+}
+
+void NewTabPageVisibilityPageHandler::OpenSearch(const std::string& query) {
+  if (query.empty() || !web_contents_) {
+    return;
+  }
+  TemplateURLService* url_service =
+      TemplateURLServiceFactory::GetForProfile(profile_);
+  if (!url_service) {
+    return;
+  }
+  GURL url = GetDefaultSearchURLForSearchTerms(url_service,
+                                               base::UTF8ToUTF16(query));
+  if (!url.is_valid()) {
+    return;
+  }
+  web_contents_->GetController().LoadURL(
+      url, content::Referrer(), ui::PageTransition::PAGE_TRANSITION_FROM_API,
+      /*extra_headers=*/std::string());
+}
+
+void NewTabPageVisibilityPageHandler::FetchText(const std::string& url_spec,
+                                                FetchTextCallback callback) {
+  const GURL url(url_spec);
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme) ||
+      !std::ranges::contains(kAllowedHosts, url.host())) {
+    std::move(callback).Run(0, std::string());
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  auto loader =
+      network::SimpleURLLoader::Create(std::move(request), kFetchAnnotation);
+  loader->SetTimeoutDuration(base::Seconds(10));
+  network::SimpleURLLoader* raw_loader = loader.get();
+  loaders_.push_back(std::move(loader));
+  raw_loader->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&NewTabPageVisibilityPageHandler::OnFetched,
+                     weak_factory_.GetWeakPtr(), raw_loader,
+                     std::move(callback)),
+      kMaxResponseBytes);
+}
+
+void NewTabPageVisibilityPageHandler::OnFetched(
+    network::SimpleURLLoader* loader,
+    FetchTextCallback callback,
+    std::optional<std::string> body) {
+  int status = 0;
+  if (body && loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+    status = loader->ResponseInfo()->headers->response_code();
+  }
+  std::string text = body.value_or(std::string());
+  std::erase_if(loaders_, [loader](const auto& l) { return l.get() == loader; });
+  std::move(callback).Run(status, std::move(text));
+}
