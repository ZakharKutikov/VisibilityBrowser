@@ -0,0 +1,44 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: ported from ntp-extension/lib/suggestions.js (2.1's search
+// suggestion dropdown, shared by the address bar and the new tab search box).
+
+export interface Suggestion {
+  type: 'history'|'search';
+  text: string;
+  url: string|null;
+}
+
+export function parseGoogleSuggestions(json: unknown, max = 6): Suggestion[] {
+  const list = Array.isArray(json) && Array.isArray((json as unknown[])[1]) ?
+      (json as unknown[])[1] as string[] :
+      [];
+  return list.slice(0, max).map(
+      (text): Suggestion => ({type: 'search', text, url: null}));
+}
+
+export interface HistoryLikeItem {
+  title?: string;
+  url?: string;
+}
+
+export function historyToSuggestions(
+    historyItems: HistoryLikeItem[]|undefined, max = 4): Suggestion[] {
+  const seen = new Set<string>();
+  const out: Suggestion[] = [];
+  for (const h of historyItems || []) {
+    const key = (h.title || '').trim().toLowerCase();
+    if (!key || seen.has(key)) continue;
+    seen.add(key);
+    out.push({type: 'history', text: h.title!, url: h.url || ''});
+    if (out.length >= max) break;
+  }
+  return out;
+}
+
+export function mergeSuggestions(
+    historyItems: Suggestion[], searchItems: Suggestion[]): Suggestion[] {
+  return historyItems.length ? [...historyItems, ...searchItems] : searchItems;
+}
