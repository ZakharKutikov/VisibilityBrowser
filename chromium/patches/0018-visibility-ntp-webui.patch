+#ifndef CHROME_BROWSER_UI_WEBUI_NEW_TAB_PAGE_VISIBILITY_NEW_TAB_PAGE_VISIBILITY_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_NEW_TAB_PAGE_VISIBILITY_NEW_TAB_PAGE_VISIBILITY_UI_H_
+
+#include <memory>
+#include <string>
+
+#include "chrome/browser/ui/webui/new_tab_page_visibility/new_tab_page_visibility.mojom.h"
+#include "content/public/browser/webui_config.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "ui/webui/mojo_web_ui_controller.h"
+
+class NewTabPageVisibilityPageHandler;
+class NewTabPageVisibilityUI;
+
+// Registered for BOTH kChromeUINewTabHost ("newtab") and
+// kChromeUINewTabPageHost ("new-tab-page"): depending on profile/search
+// settings, Chromium's own rewrite rules (see chrome/browser/search/
+// search.cc's HandleNewTabURLRewrite) send a bare new tab to either host, and
+// this page serves both so neither one falls through to Google's own
+// NewTabPageUI (replaced -- see chrome_web_ui_configs.cc).
+class NewTabPageVisibilityUIConfig
+    : public content::DefaultWebUIConfig<NewTabPageVisibilityUI> {
+ public:
+  explicit NewTabPageVisibilityUIConfig(const std::string& host);
+
+  // content::DefaultWebUIConfig:
+  bool IsWebUIEnabled(content::BrowserContext* browser_context) override;
+};
+
+// Visibility: the 2.1-style new tab page (clock, search with suggestions,
+// brand shortcuts, weather, recent visits) -- see new_tab_page_visibility.mojom
+// for why this replaces ntp-extension/ entirely instead of shipping as a
+// component extension.
+class NewTabPageVisibilityUI
+    : public ui::MojoWebUIController,
+      public new_tab_page_visibility::mojom::PageHandlerFactory {
+ public:
+  explicit NewTabPageVisibilityUI(content::WebUI* web_ui);
+  NewTabPageVisibilityUI(const NewTabPageVisibilityUI&) = delete;
+  NewTabPageVisibilityUI& operator=(const NewTabPageVisibilityUI&) = delete;
+  ~NewTabPageVisibilityUI() override;
+
+  void BindInterface(
+      mojo::PendingReceiver<new_tab_page_visibility::mojom::PageHandlerFactory>
+          receiver);
+
+ private:
+  // new_tab_page_visibility::mojom::PageHandlerFactory:
+  void CreatePageHandler(
+      mojo::PendingReceiver<new_tab_page_visibility::mojom::PageHandler>
+          handler) override;
+
+  std::unique_ptr<NewTabPageVisibilityPageHandler> page_handler_;
+  mojo::Receiver<new_tab_page_visibility::mojom::PageHandlerFactory>
+      page_factory_receiver_{this};
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_NEW_TAB_PAGE_VISIBILITY_NEW_TAB_PAGE_VISIBILITY_UI_H_
