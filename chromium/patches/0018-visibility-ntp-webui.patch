@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: ported from ntp-extension/lib/sites.js (2.1's new tab page).
+// Only hostOf/pickRecent are used by this page -- shortcuts are a static
+// list of brand tiles in the HTML, not derived from top sites.
+
+export interface HistoryLikeEntry {
+  title?: string;
+  url: string;
+  lastVisitTime?: number;
+}
+
+export interface RecentEntry {
+  title: string;
+  url: string;
+  host: string;
+}
+
+export function hostOf(url: string): string {
+  try {
+    const u = new URL(url);
+    return /^https?:$/.test(u.protocol) ? u.hostname.replace(/^www\./, '') :
+                                          '';
+  } catch {
+    return '';
+  }
+}
+
+/** Latest history entries, one per host. */
+export function pickRecent(
+    history: HistoryLikeEntry[], limit = 6): RecentEntry[] {
+  const seen = new Set<string>();
+  const out: RecentEntry[] = [];
+  const sorted = [...(history || [])].sort(
+      (a, b) => (b.lastVisitTime || 0) - (a.lastVisitTime || 0));
+  for (const h of sorted) {
+    const host = hostOf(h.url);
+    if (!host || seen.has(host)) continue;
+    seen.add(host);
+    out.push({title: (h.title || '').trim() || host, url: h.url, host});
+    if (out.length === limit) break;
+  }
+  return out;
+}
