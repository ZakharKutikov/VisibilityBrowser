+      </button>
+      <form class="city" id="city-form" hidden>
+        <input id="city-input" type="text" autocomplete="off" maxlength="60"
+               placeholder="$i18n{cityPlaceholder}" aria-label="$i18n{cityLabel}">
+        <div class="city-actions">
+          <button class="btn-primary" type="submit">$i18n{citySave}</button>
+          <button class="btn-text" type="button" id="city-remove">$i18n{cityRemove}</button>
+        </div>
+      </form>
+      <p class="weather-error" id="weather-error" role="status" hidden></p>
+    </section>
+
+    <section class="recent-section" id="recent-section" hidden>
+      <h2 class="recent-title">$i18n{recentTitle}</h2>
+      <ul class="recent" id="recent"></ul>
+    </section>
+
+    <footer class="footer" id="footer">Visibility Browser v3.0.2</footer>
+  </main>
+
+  <script type="module" src="strings.m.js"></script>
+  <script type="module" src="app.js"></script>
+</body>
+</html>
