@@ -0,0 +1,50 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module new_tab_page_visibility.mojom;
+
+// Visibility: the 2.1-style new tab page (clock, search box with
+// suggestions, brand shortcuts, weather, recent visits), replacing
+// Google's own chrome://new-tab-page/ entirely -- see
+// NewTabPageVisibilityUIConfig in new_tab_page_visibility_ui.h, which is
+// registered for kChromeUINewTabPageHost instead of NewTabPageUIConfig.
+// Previously this same page shipped as a component extension
+// (ntp-extension/) overriding chrome://newtab; that required a chain of
+// incognito-specific workarounds (see extension_url_overrides.cc) that a
+// native WebUI page does not need at all.
+
+// Used by the page to bootstrap communication to the browser process. There
+// is no Page interface (browser -> page push) -- everything here is a plain
+// request/response, so PageHandler is all this page needs.
+interface PageHandlerFactory {
+  CreatePageHandler(pending_receiver<PageHandler> handler);
+};
+
+// One row of the history/"recent visits" list.
+struct HistoryEntry {
+  string title;
+  string url;
+  // Milliseconds since the Unix epoch.
+  double last_visit_ms;
+};
+
+// Browser-side handler for requests from the page.
+interface PageHandler {
+  // Same query shape and backend (history::HistoryService) as the main
+  // frame's history panel (see webui_browser.mojom's QueryHistory).
+  QueryHistory(string query, int32 max_count) => (array<HistoryEntry> entries);
+
+  // Navigates the current tab to the default search engine's results page
+  // for `query` (the native-WebUI equivalent of the chrome.search
+  // extension API, which isn't available outside an extension).
+  OpenSearch(string query);
+
+  // Downloads a small text resource over https for the page. A chrome:// page
+  // cannot fetch() remote sites itself (the WebUI loader only accepts its own
+  // scheme and kills the renderer on anything else), so weather and search
+  // suggestions go through the browser process. Only the hosts the page needs
+  // are allowed. `status` is the HTTP status, or 0 if the request was refused
+  // or failed.
+  FetchText(string url) => (int32 status, string body);
+};
diff --git a/chrome/browser/ui/webui/new_tab_page_visibility/new_tab_page_visibility_page_handler.cc b/chrome/browser/ui/webui/new_tab_page_visibility/new_tab_page_visibility_page_handler.cc
