+      {"wxUnknown", "", ""},
+  };
+  // The page is served from whichever of these hosts the new tab resolved
+  // to (the visible URL is often the virtual chrome://newtab), so the same
+  // source is registered for all of them.
+  for (const char* host :
+       {chrome::kChromeUINewTabHost, chrome::kChromeUINewTabPageHost,
+        chrome::kChromeUINewTabPageThirdPartyHost}) {
+    content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+        web_ui->GetWebContents()->GetBrowserContext(), host);
+
+    webui::SetupWebUIDataSource(
+        source, kNewTabPageVisibilityResources,
+        IDR_NEW_TAB_PAGE_VISIBILITY_NEW_TAB_PAGE_VISIBILITY_HTML);
+
+    // Visibility: the page fetches weather/suggestion data directly from
+    // these hosts (ported as-is from ntp-extension/manifest.json's
+    // host_permissions -- a native WebUI page doesn't have a manifest, so the
+    // same allowance is granted here instead).
+    source->OverrideContentSecurityPolicy(
+        network::mojom::CSPDirectiveName::ConnectSrc,
+        "connect-src 'self' https://api.open-meteo.com "
+        "https://geocoding-api.open-meteo.com https://ipwhois.app "
+        "https://wttr.in https://suggestqueries.google.com;");
+    source->OverrideContentSecurityPolicy(
+        network::mojom::CSPDirectiveName::ImgSrc,
+        "img-src 'self' chrome://favicon2 data:;");
+
+    for (const auto& s : kStrings) {
+      source->AddString(s.name, ru ? s.ru : s.en);
+    }
+  }
+
+  content::URLDataSource::Add(
+      profile, std::make_unique<FaviconSource>(
+                   profile, chrome::FaviconUrlFormat::kFavicon2));
+}
+
+NewTabPageVisibilityUI::~NewTabPageVisibilityUI() = default;
+
+void NewTabPageVisibilityUI::BindInterface(
+    mojo::PendingReceiver<new_tab_page_visibility::mojom::PageHandlerFactory>
+        receiver) {
+  page_factory_receiver_.reset();
+  page_factory_receiver_.Bind(std::move(receiver));
+}
+
+void NewTabPageVisibilityUI::CreatePageHandler(
+    mojo::PendingReceiver<new_tab_page_visibility::mojom::PageHandler>
+        handler) {
+  page_handler_ = std::make_unique<NewTabPageVisibilityPageHandler>(
+      std::move(handler), Profile::FromWebUI(web_ui()),
+      web_ui()->GetWebContents());
+}
+
+WEB_UI_CONTROLLER_TYPE_IMPL(NewTabPageVisibilityUI)
