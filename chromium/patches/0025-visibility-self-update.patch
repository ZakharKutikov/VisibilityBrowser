@@ -0,0 +1,69 @@
+// Visibility: checks GitHub for a newer release, downloads its installer,
+// verifies the SHA-256 that GitHub lists for the asset and runs it. The page
+// handler drives it and shows the progress in the WebUI frame.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_VIS_UPDATER_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_VIS_UPDATER_H_
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+
+class Profile;
+
+namespace base {
+class FilePath;
+}
+
+namespace network {
+class SimpleURLLoader;
+}
+
+class VisUpdater {
+ public:
+  struct Info {
+    std::string version;
+    std::string notes;
+    std::string download_url;
+    std::string sha256;
+    uint64_t size = 0;
+  };
+
+  explicit VisUpdater(Profile* profile);
+  VisUpdater(const VisUpdater&) = delete;
+  VisUpdater& operator=(const VisUpdater&) = delete;
+  ~VisUpdater();
+
+  // The version this build reports. Bump it for every release.
+  static std::string CurrentVersion();
+
+  // Runs `callback` with the newest release if it is newer than this build,
+  // or with nullopt (no update, or the check failed).
+  void Check(base::OnceCallback<void(std::optional<Info>)> callback);
+
+  // Downloads and runs the installer found by Check(). `progress` gets
+  // 0..100, `done` gets whether the installer finished successfully.
+  void Install(base::RepeatingCallback<void(int)> progress,
+               base::OnceCallback<void(bool)> done);
+
+ private:
+  void OnChecked(base::OnceCallback<void(std::optional<Info>)> callback,
+                 std::optional<std::string> body);
+  void OnProgress(uint64_t received);
+  void OnDownloaded(base::FilePath path);
+  void OnInstalled(bool ok);
+
+  raw_ptr<Profile> profile_;
+  std::optional<Info> info_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::RepeatingCallback<void(int)> progress_;
+  base::OnceCallback<void(bool)> done_;
+  base::WeakPtrFactory<VisUpdater> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_BROWSER_VIS_UPDATER_H_
