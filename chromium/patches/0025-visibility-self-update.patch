+/* Copyright 2026 The Chromium Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  position: fixed;
+  right: 20px;
+  bottom: 20px;
+  z-index: 970;
+  display: none;
+  font-family: 'Inter', 'Segoe UI Variable Text', 'Segoe UI', system-ui,
+      sans-serif;
+  font-size: 13px;
+  color: #f8fafc;
+}
+
+:host([state='available']),
+:host([state='installing']),
+:host([state='ready']),
+:host([state='failed']) {
+  display: block;
+}
+
+.card {
+  width: 280px;
+  padding: 14px 16px;
+  background: #1e202a;
+  border: 1px solid rgba(255, 255, 255, 14%);
+  border-radius: 14px;
+  box-shadow: 0 16px 40px rgba(0, 0, 0, 55%);
+}
+
+.title {
+  font-weight: 600;
+  margin-bottom: 10px;
+}
+
+.text {
+  color: #94a3b8;
+  margin-bottom: 8px;
+}
+
+.text.fail {
+  color: #f55;
+}
+
+.row {
+  display: flex;
+  gap: 8px;
+}
+
+button {
+  padding: 7px 14px;
+  border: none;
+  border-radius: 9px;
+  font: inherit;
+  cursor: pointer;
+}
+
+.primary {
+  background: #818cf8;
+  color: #0d0e12;
+  font-weight: 600;
+}
+
+.primary:hover {
+  background: #939dfa;
+}
+
+.ghost {
+  background: rgba(255, 255, 255, 8%);
+  color: #f8fafc;
+}
+
+.ghost:hover {
+  background: rgba(255, 255, 255, 14%);
+}
+
+.bar {
+  height: 6px;
+  border-radius: 3px;
+  background: rgba(255, 255, 255, 10%);
+  overflow: hidden;
+}
+
+.fill {
+  height: 100%;
+  background: #818cf8;
+  transition: width 0.2s linear;
+}
+
+:focus-visible {
+  outline: 2px solid #818cf8;
+  outline-offset: 2px;
+}
