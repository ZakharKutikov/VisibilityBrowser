@@ -0,0 +1,83 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: self-update. A small card in the corner: "version X is out",
+// download progress, then "restart".
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from './browser.mojom-webui.js';
+import {getCss} from './vis_update.css.js';
+import {getHtml} from './vis_update.html.js';
+import {t} from './vis_settings.js';
+
+export type UpdateState = 'hidden'|'available'|'installing'|'ready'|'failed';
+
+export class VisUpdateElement extends CrLitElement {
+  static get is() {
+    return 'vis-update';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      state: {type: String, reflect: true},
+      version: {state: true, type: String},
+      percent: {state: true, type: Number},
+    };
+  }
+
+  accessor state: UpdateState = 'hidden';
+  accessor version: string = '';
+  accessor percent: number = 0;
+
+  readonly t = t;
+
+  // Called once the window is up; shows the card only when a newer release
+  // exists on GitHub.
+  async check() {
+    const {info} = await browserProxyFactory.getInstance().handler.checkForUpdate();
+    if (info) {
+      this.version = info.version;
+      this.state = 'available';
+    }
+  }
+
+  setProgress(percent: number) {
+    this.percent = percent;
+  }
+
+  setInstalled(ok: boolean) {
+    this.state = ok ? 'ready' : 'failed';
+  }
+
+  protected onInstallClick() {
+    this.state = 'installing';
+    this.percent = 0;
+    browserProxyFactory.getInstance().handler.installUpdate();
+  }
+
+  protected onLaterClick() {
+    this.state = 'hidden';
+  }
+
+  protected onRestartClick() {
+    browserProxyFactory.getInstance().handler.restartBrowser();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-update': VisUpdateElement;
+  }
+}
+
+customElements.define(VisUpdateElement.is, VisUpdateElement);
