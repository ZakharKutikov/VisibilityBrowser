 }
+
+void WebUIBrowserPageHandler::CheckForUpdate(
+    CheckForUpdateCallback callback) {
+  if (!updater_) {
+    updater_ = std::make_unique<VisUpdater>(GetBrowser()->GetProfile());
+  }
+  updater_->Check(base::BindOnce(
+      [](CheckForUpdateCallback callback,
+         std::optional<VisUpdater::Info> info) {
+        if (!info) {
+          std::move(callback).Run(nullptr);
+          return;
+        }
+        std::move(callback).Run(
+            webui_browser::mojom::UpdateInfo::New(info->version, info->notes));
+      },
+      std::move(callback)));
+}
+
+void WebUIBrowserPageHandler::InstallUpdate() {
+  if (!updater_) {
+    return;
+  }
+  updater_->Install(
+      base::BindRepeating(
+          [](base::WeakPtr<WebUIBrowserPageHandler> self, int percent) {
+            if (self && self->Page()) {
+              self->Page()->OnUpdateProgress(percent);
+            }
+          },
+          update_weak_factory_.GetWeakPtr()),
+      base::BindOnce(
+          [](base::WeakPtr<WebUIBrowserPageHandler> self, bool ok) {
+            if (self && self->Page()) {
+              self->Page()->OnUpdateInstalled(ok);
+            }
+          },
+          update_weak_factory_.GetWeakPtr()));
+}
+
+void WebUIBrowserPageHandler::RestartBrowser() {
+  chrome::AttemptRestart();
+}
