+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {VisUpdateElement} from './vis_update.js';
+
+export function getHtml(this: VisUpdateElement) {
+  return html`<!--_html_template_start_-->
+<section class="card" role="status">
+  <div class="title">${this.t('updateTitle')} ${this.version}</div>
+  ${this.state === 'available' ? html`
+    <div class="row">
+      <button class="primary" @click="${this.onInstallClick}">
+        ${this.t('updateNow')}</button>
+      <button class="ghost" @click="${this.onLaterClick}">
+        ${this.t('updateLater')}</button>
+    </div>` : html``}
+  ${this.state === 'installing' ? html`
+    <div class="text">${this.t('updateInstalling')} ${this.percent}%</div>
+    <div class="bar"><div class="fill"
+        style="width: ${this.percent}%"></div></div>` : html``}
+  ${this.state === 'ready' ? html`
+    <div class="text">${this.t('updateReady')}</div>
+    <div class="row">
+      <button class="primary" @click="${this.onRestartClick}">
+        ${this.t('updateRestart')}</button>
+      <button class="ghost" @click="${this.onLaterClick}">
+        ${this.t('updateLater')}</button>
+    </div>` : html``}
+  ${this.state === 'failed' ? html`
+    <div class="text fail">${this.t('updateFailed')}</div>
+    <div class="row">
+      <button class="ghost" @click="${this.onLaterClick}">
+        ${this.t('close')}</button>
+    </div>` : html``}
+</section>
+<!--_html_template_end_-->`;
+}
