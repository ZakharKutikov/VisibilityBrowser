diff --git a/chrome/browser/ui/webui_browser/vis_updater.cc b/chrome/browser/ui/webui_browser/vis_updater.cc
new file mode 100644
index 0000000..c7ea482
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/vis_updater.cc
@@ -0,0 +1,233 @@
+#include "chrome/browser/ui/webui_browser/vis_updater.h"
+
+#include <array>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/process/launch.h"
+#include "base/process/process.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "base/version.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/storage_partition.h"
+#include "crypto/hash.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kVersion[] = "3.0.3";
+constexpr char kLatestReleaseUrl[] =
+    "https://api.github.com/repos/ZakharKutikov/VisibilityBrowser/releases/"
+    "latest";
+constexpr char kDownloadPrefix[] =
+    "https://github.com/ZakharKutikov/VisibilityBrowser/releases/download/";
+constexpr char kSha256Prefix[] = "sha256:";
+// Testing hooks: pretend to be another version, and stop after the checksum
+// instead of running the installer.
+constexpr char kSwitchVersionOverride[] = "vis-version-override";
+constexpr char kSwitchDryRun[] = "vis-update-dry-run";
+constexpr size_t kMaxReleaseJsonBytes = 1024 * 1024;
+
+const net::NetworkTrafficAnnotationTag kUpdateAnnotation =
+    net::DefineNetworkTrafficAnnotation("visibility_update", R"(
+      semantics {
+        sender: "Visibility update check"
+        description:
+          "Asks GitHub for the latest Visibility Browser release and, when "
+          "the user agrees, downloads its installer."
+        trigger: "Browser start, and the user pressing the update button."
+        data: "None. The request carries no user data."
+        destination: OTHER
+        destination_other: "GitHub servers"
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "No setting; the check cannot be turned off yet."
+        policy_exception_justification: "Not implemented."
+      })");
+
+// Runs on a worker thread: checks the SHA-256 and runs the installer.
+bool VerifyAndRun(const base::FilePath& path,
+                  const std::string& expected_sha256) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  if (!crypto::hash::HashFile(crypto::hash::kSha256, &file, digest)) {
+    return false;
+  }
+  const std::string hex = base::ToLowerASCII(base::HexEncode(digest));
+  file.Close();
+  if (hex != expected_sha256) {
+    base::DeleteFile(path);
+    return false;
+  }
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(kSwitchDryRun)) {
+    base::DeleteFile(path);
+    return true;
+  }
+  base::CommandLine command(path);
+  command.AppendSwitch("do-not-launch-chrome");
+  base::Process process = base::LaunchProcess(command, base::LaunchOptions());
+  if (!process.IsValid()) {
+    base::DeleteFile(path);
+    return false;
+  }
+  int exit_code = -1;
+  process.WaitForExit(&exit_code);
+  base::DeleteFile(path);
+  return exit_code == 0;
+}
+
+}  // namespace
+
+VisUpdater::VisUpdater(Profile* profile) : profile_(profile) {}
+
+VisUpdater::~VisUpdater() = default;
+
+// static
+std::string VisUpdater::CurrentVersion() {
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kSwitchVersionOverride)) {
+    return command_line->GetSwitchValueASCII(kSwitchVersionOverride);
+  }
+  return kVersion;
+}
+
+void VisUpdater::Check(
+    base::OnceCallback<void(std::optional<Info>)> callback) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(kLatestReleaseUrl);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader("Accept", "application/vnd.github+json");
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kUpdateAnnotation);
+  loader_->SetTimeoutDuration(base::Seconds(15));
+  loader_->DownloadToString(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&VisUpdater::OnChecked, weak_factory_.GetWeakPtr(),
+                     std::move(callback)),
+      kMaxReleaseJsonBytes);
+}
+
+void VisUpdater::OnChecked(
+    base::OnceCallback<void(std::optional<Info>)> callback,
+    std::optional<std::string> body) {
+  loader_.reset();
+  info_.reset();
+  if (!body) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  std::optional<base::DictValue> release = base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC);
+  const std::string* tag = release ? release->FindString("tag_name") : nullptr;
+  if (!tag) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  std::string version = *tag;
+  if (!version.empty() && version[0] == 'v') {
+    version.erase(0, 1);
+  }
+  const base::Version latest(version);
+  const base::Version current(CurrentVersion());
+  if (!latest.IsValid() || !current.IsValid() ||
+      latest.CompareTo(current) <= 0) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  const base::ListValue* assets = release->FindList("assets");
+  if (assets) {
+    for (const base::Value& item : *assets) {
+      const base::DictValue* asset = item.GetIfDict();
+      const std::string* name = asset ? asset->FindString("name") : nullptr;
+      const std::string* url =
+          asset ? asset->FindString("browser_download_url") : nullptr;
+      const std::string* digest = asset ? asset->FindString("digest") : nullptr;
+      if (!name || !url || !digest ||
+          !base::EndsWith(*name, "-Setup.exe") ||
+          !base::StartsWith(*url, kDownloadPrefix) ||
+          !base::StartsWith(*digest, kSha256Prefix)) {
+        continue;
+      }
+      Info info;
+      info.version = version;
+      const std::string* notes = release->FindString("body");
+      info.notes = notes ? notes->substr(0, 600) : std::string();
+      info.download_url = *url;
+      info.sha256 = base::ToLowerASCII(digest->substr(sizeof(kSha256Prefix) - 1));
+      info.size = static_cast<uint64_t>(asset->FindDouble("size").value_or(0));
+      info_ = info;
+      break;
+    }
+  }
+  std::move(callback).Run(info_);
+}
+
+void VisUpdater::Install(base::RepeatingCallback<void(int)> progress,
+                         base::OnceCallback<void(bool)> done) {
+  if (!info_ || loader_) {
+    std::move(done).Run(false);
+    return;
+  }
+  progress_ = std::move(progress);
+  done_ = std::move(done);
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(info_->download_url);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kUpdateAnnotation);
+  loader_->SetOnDownloadProgressCallback(base::BindRepeating(
+      &VisUpdater::OnProgress, weak_factory_.GetWeakPtr()));
+  loader_->DownloadToFile(
+      profile_->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess()
+          .get(),
+      base::BindOnce(&VisUpdater::OnDownloaded, weak_factory_.GetWeakPtr()),
+      profile_->GetPath().AppendASCII("Visibility-Update.exe"));
+}
+
+void VisUpdater::OnProgress(uint64_t received) {
+  if (info_ && info_->size > 0 && progress_) {
+    progress_.Run(static_cast<int>(
+        std::min<uint64_t>(99, received * 100 / info_->size)));
+  }
+}
+
+void VisUpdater::OnDownloaded(base::FilePath path) {
+  loader_.reset();
+  if (path.empty() || !info_) {
+    OnInstalled(false);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::WithBaseSyncPrimitives(),
+       base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&VerifyAndRun, path, info_->sha256),
+      base::BindOnce(&VisUpdater::OnInstalled, weak_factory_.GetWeakPtr()));
+}
+
+void VisUpdater::OnInstalled(bool ok) {
+  if (progress_ && ok) {
+    progress_.Run(100);
+  }
+  if (done_) {
+    std::move(done_).Run(ok);
+  }
+}
