+++ b/chrome/browser/vpn/visibility_vpn_service.h
@@ -0,0 +1,115 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_VPN_VISIBILITY_VPN_SERVICE_H_
+#define CHROME_BROWSER_VPN_VISIBILITY_VPN_SERVICE_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/process/process.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "services/network/public/mojom/url_response_head.mojom-forward.h"
+
+class GURL;
+class Profile;
+
+namespace network {
+class SimpleURLLoader;
+}
+
+// Visibility: owns the Xray core (download, launch, stop) and the profile's
+// proxy setting, for the VPN panel built into the browser frame. This is the
+// native replacement for the Node.js native-messaging host that vpn-extension
+// used to need, so the VPN no longer depends on a Chrome extension at all —
+// only on this profile-scoped service, called from WebUIBrowserPageHandler.
+//
+// Business data (the server list, routing mode) is not this service's job;
+// it stays in the WebUI page's own storage, exactly as before. This service
+// only does the parts that need OS-level privilege: spawning a process and
+// setting the browser's own proxy.
+class VisibilityVpnService : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // Progress of the InstallCore() download, 0-100.
+    virtual void OnInstallProgress(int percent) {}
+    // InstallCore() finished; `ok` is false if the download, the unpack, or
+    // the resulting binary all failed to materialize.
+    virtual void OnInstallFinished(bool ok) {}
+    // The running core exited on its own (crash, or killed outside us). The
+    // profile's proxy has already been cleared by the time this fires.
+    virtual void OnCoreExited() {}
+  };
+
+  explicit VisibilityVpnService(Profile* profile);
+  VisibilityVpnService(const VisibilityVpnService&) = delete;
+  VisibilityVpnService& operator=(const VisibilityVpnService&) = delete;
+  ~VisibilityVpnService() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Asks (off the UI thread) whether the Xray binary is present.
+  using HasCoreCallback = base::OnceCallback<void(bool)>;
+  void HasCore(HasCoreCallback callback);
+
+  // Downloads and unpacks the latest Xray release. Reports progress and
+  // completion through the Observer interface rather than a callback, since
+  // this can be asked for again (to retry) before the first call replies.
+  void InstallCore();
+
+  // Writes `config_json` as Xray's config, (re)starts Xray with it, waits
+  // for its SOCKS port to accept connections, and only then switches the
+  // profile's proxy to it. Calls back with ok=false and an error code
+  // ("NO_CORE", "START_TIMEOUT", ...) on failure, leaving the proxy
+  // untouched in that case.
+  using StartCallback = base::OnceCallback<void(bool ok, const std::string& error)>;
+  void Start(std::string config_json, StartCallback callback);
+
+  // Stops Xray if running and clears the profile's proxy. Safe to call when
+  // already stopped.
+  void Stop();
+
+  bool IsConnected() const { return process_.IsValid(); }
+
+  // TCP connect time in ms for each target, in the same order; -1 for one
+  // that did not answer within the deadline. Targets beyond the first 200
+  // are ignored, same limit as the old native host.
+  struct PingTarget {
+    std::string address;
+    int port = 0;
+  };
+  using PingCallback = base::OnceCallback<void(const std::vector<int>&)>;
+  void Ping(std::vector<PingTarget> targets, PingCallback callback);
+
+ private:
+  base::FilePath CoreDir() const;
+  base::FilePath BinPath() const;
+
+  void OnDownloadToFile(base::FilePath path);
+  void OnResponseStarted(const GURL& url,
+                        const network::mojom::URLResponseHead& head);
+  void OnDownloadProgress(uint64_t current);
+  void OnUnzipped(base::FilePath zip_path, bool unzip_ok);
+  void OnInstallCoreChecked(bool has_core);
+
+  void OnPortReady(StartCallback callback, bool ready);
+  void OnProcessExited();
+
+  raw_ptr<Profile> profile_;
+  base::Process process_;
