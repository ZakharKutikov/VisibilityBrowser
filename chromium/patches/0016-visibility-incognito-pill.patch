--- a/chrome/browser/resources/webui_browser/app.css
+++ b/chrome/browser/resources/webui_browser/app.css
@@ -99,6 +99,22 @@
   text-transform: uppercase;
 }
 
+/* Visibility: 2.1's title-bar "Инкогнито" pill (index.html's
+ * .tb-incognito-pill), shown only when webui_browser_ui.cc's isIncognito
+ * loadTimeData value is true. */
+.tbIncognitoPill {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  background: rgba(156, 110, 245, 15%);
+  border: 1px solid #9c6ef5;
+  border-radius: 20px;
+  padding: 2px 10px;
+  font-size: 11px;
+  font-weight: 600;
+  color: #9c6ef5;
+}
+
 .captionButtonsDiv {
   display: flex;
   height: 100%;
