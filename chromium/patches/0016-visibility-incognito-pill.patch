+  // Visibility: fixed for the lifetime of the window (see
+  // webui_browser_ui.cc), so a plain field is enough -- no need to make it
+  // reactive.
+  protected readonly isIncognito_: boolean =
+      loadTimeData.valueExists('isIncognito') &&
+      loadTimeData.getBoolean('isIncognito');
   protected accessor tabStripInset_: number =
       loadTimeData.valueExists('tabStripInset') ?
       loadTimeData.getInteger('tabStripInset') :
diff --git a/chrome/browser/resources/webui_browser/app.css b/chrome/browser/resources/webui_browser/app.css
