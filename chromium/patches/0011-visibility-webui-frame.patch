+              <div class="row-text">
+                <div class="row-label">${this.t('pageInfoIssuedBy')}</div>
+                <div class="row-value">${this.issuedByLabel_()}</div>
+              </div>
+            </div>
+            <div class="row">
+              <svg class="row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
+              <div class="row-text">
+                <div class="row-label">${this.t('pageInfoProtocol')}</div>
+                <div class="row-value">${this.info.protocol}</div>
+              </div>
+            </div>
+          </div>
+          <details>
+            <summary>
+              <svg class="row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.81 4.47c-.08 0-.16-.02-.23-.06C15.66 3.42 14 3 12.01 3c-1.98 0-3.86.47-5.57 1.41-.24.13-.54.04-.68-.2-.13-.24-.04-.55.2-.68C7.82 2.52 9.86 2 12.01 2c2.13 0 3.99.47 6 1.45.25.12.35.42.23.67-.09.18-.26.28-.44.28z"></path></svg>
+              <span style="flex:1">${this.t('pageInfoFingerprint')}</span>
