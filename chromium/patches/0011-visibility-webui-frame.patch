+
+/* Visibility: the 2.1 extensions dropdown (index.html, #extensions-dropdown). */
+:host {
+  --bg-primary: #0d0e12;
+  --text-primary: #f8fafc;
+  --text-secondary: #94a3b8;
+  --text-muted: rgba(255, 255, 255, 45%);
