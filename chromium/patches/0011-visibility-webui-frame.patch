+              </button>
+            </div>
+          </details>` : html``}
+      </div>
+    </div>
+    </div>`;
+}
diff --git a/chrome/browser/resources/webui_browser/vis_pageinfo.ts b/chrome/browser/resources/webui_browser/vis_pageinfo.ts
new file mode 100644
index 0000000000..8a1332061f
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_pageinfo.ts
@@ -0,0 +1,169 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: the 2.1 site-info modal (index.html's #overlay-cert +
+// renderer.js's secIcon click handler), ported to the frame. Purely
+// informational: closing it never talks back to the browser process.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory, PageInfoState} from './browser.mojom-webui.js';
+import type {PageInfoDetails} from './browser.mojom-webui.js';
+import {t} from './vis_settings.js';
+import {getCss} from './vis_pageinfo.css.js';
+import {getHtml} from './vis_pageinfo.html.js';
+
+const COPIED_MS = 2000;
+
+export class VisPageinfoElement extends CrLitElement {
+  static get is() {
+    return 'vis-pageinfo';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      info: {state: true, type: Object},
+      fingerprintCopied: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor info: PageInfoDetails|null = null;
+  accessor fingerprintCopied: boolean = false;
+  private copiedTimer_: number = 0;
+
+  readonly t = t;
+
+  constructor() {
+    super();
+    const router = browserProxyFactory.getInstance().callbackRouter;
+    router.showPageInfo.addListener(this.onShow_.bind(this));
+  }
+
+  private onShow_(info: PageInfoDetails) {
+    this.fingerprintCopied = false;
+    this.info = info;
+    this.open = true;
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  onCloseClick() {
+    this.hide();
+  }
+
+  onBackdropClick(e: Event) {
+    if (e.target === e.currentTarget) this.hide();
+  }
+
+  onKeydown(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.stopPropagation();
+      this.hide();
+    }
+  }
+
+  async onCopyClick() {
+    const fp = this.info?.fingerprintSha256;
+    if (!fp) return;
+    try {
+      await navigator.clipboard.writeText(fp);
+    } catch {
+      return;
+    }
+    this.fingerprintCopied = true;
+    window.clearTimeout(this.copiedTimer_);
+    this.copiedTimer_ = window.setTimeout(() => {
+      this.fingerprintCopied = false;
+    }, COPIED_MS);
+  }
+
+  isState_(state: PageInfoState): boolean {
+    return this.info?.state === state;
+  }
+
+  statusColor_(): string {
+    switch (this.info?.state) {
+      case PageInfoState.kSecure:
+        return '#4caf50';
+      case PageInfoState.kWarning:
+        return '#ff9800';
+      case PageInfoState.kDangerous:
+      case PageInfoState.kInsecure:
+        return '#ff4c4c';
+      default:
+        return '#94a3b8';
+    }
+  }
+
+  statusText_(): string {
+    switch (this.info?.state) {
+      case PageInfoState.kSecure:
+        return this.t('pageInfoSecure');
+      case PageInfoState.kWarning:
+        return this.t('pageInfoWarning');
+      case PageInfoState.kDangerous:
+        return this.t('pageInfoDangerous');
+      case PageInfoState.kInsecure:
+        return this.t('pageInfoInsecureTitle');
+      default:
+        return this.t('pageInfoUnknownTitle');
+    }
+  }
+
+  domainLabel_(): string {
+    return this.info?.domain || '';
+  }
+
+  descLabel_(): string {
+    if (this.isState_(PageInfoState.kInsecure)) return this.t('pageInfoInsecureDesc');
+    if (!this.info?.hasCertificate) return this.t('pageInfoUnknownDesc');
+    return '';
+  }
+
+  issuedToLabel_(): string {
+    return this.info?.subjectCn || this.domainLabel_();
+  }
+
+  issuedByLabel_(): string {
+    return this.info?.issuerCn || this.t('pageInfoUnknownIssuer');
+  }
+
+  validFromLabel_(): string {
+    return this.info ? new Date(this.info.validFromMs).toLocaleDateString() : '';
+  }
+
+  validToLabel_(): string {
+    return this.info ? new Date(this.info.validToMs).toLocaleDateString() : '';
+  }
+
+  validityPct_(): number {
+    if (!this.info) return 0;
+    const {validFromMs, validToMs} = this.info;
+    const now = Date.now();
+    const total = validToMs - validFromMs;
+    if (total <= 0) return 0;
+    const remaining = validToMs - now;
+    return Math.max(0, Math.min(100, (remaining / total) * 100));
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-pageinfo': VisPageinfoElement;
+  }
+}
+
+customElements.define(VisPageinfoElement.is, VisPageinfoElement);
