+void WebUIBrowserPageHandler::QueryHistory(const std::string& query,
+                                           int32_t max_count,
+                                           QueryHistoryCallback callback) {
+  BrowserWindowInterface* browser = GetBrowser();
+  history::HistoryService* history =
+      browser ? HistoryServiceFactory::GetForProfile(
+                    browser->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS)
+              : nullptr;
+  if (!history) {
+    std::move(callback).Run({});
+    return;
+  }
+  history::QueryOptions options;
+  options.max_count = std::clamp(max_count, 1, 500);
+  options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+  history->QueryHistory(
+      base::UTF8ToUTF16(query), options,
+      base::BindOnce(
+          [](QueryHistoryCallback cb, history::QueryResults results) {
+            std::vector<webui_browser::mojom::HistoryEntryPtr> entries;
+            for (const history::URLResult& r : results) {
+              if (!r.url().SchemeIsHTTPOrHTTPS()) {
+                continue;
+              }
+              entries.push_back(webui_browser::mojom::HistoryEntry::New(
+                  base::UTF16ToUTF8(r.title()), r.url().spec(),
+                  r.visit_time().InMillisecondsFSinceUnixEpoch()));
+            }
+            std::move(cb).Run(std::move(entries));
+          },
+          std::move(callback)),
+      &history_task_tracker_);
+}
+
+void WebUIBrowserPageHandler::DeleteHistoryUrl(const std::string& url) {
+  BrowserWindowInterface* browser = GetBrowser();
+  const GURL gurl(url);
+  if (!browser || !gurl.is_valid()) {
+    return;
+  }
+  if (history::HistoryService* history = HistoryServiceFactory::GetForProfile(
+          browser->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS)) {
+    history->DeleteURLs({gurl});
+  }
+}
