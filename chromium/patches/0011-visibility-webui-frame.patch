+void WebUIBrowserPageHandler::ExecuteCommand(
+    webui_browser::mojom::BrowserCommand command) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser) {
+    return;
+  }
+  using Cmd = webui_browser::mojom::BrowserCommand;
+  int id = 0;
+  switch (command) {
+    case Cmd::kHome: id = IDC_HOME; break;
+    case Cmd::kHistory: id = IDC_SHOW_HISTORY; break;
+    case Cmd::kDownloads: id = IDC_SHOW_DOWNLOADS; break;
+    case Cmd::kExtensions: id = IDC_MANAGE_EXTENSIONS; break;
+    case Cmd::kSettings: id = IDC_OPTIONS; break;
+    case Cmd::kZoomIn: id = IDC_ZOOM_PLUS; break;
+    case Cmd::kZoomOut: id = IDC_ZOOM_MINUS; break;
+    case Cmd::kZoomReset: id = IDC_ZOOM_NORMAL; break;
+    case Cmd::kBookmarkThisTab: id = IDC_BOOKMARK_THIS_TAB; break;
+    case Cmd::kBookmarkManager: id = IDC_SHOW_BOOKMARK_MANAGER; break;
+    case Cmd::kNewTab: id = IDC_NEW_TAB; break;
+    case Cmd::kNewIncognitoWindow: id = IDC_NEW_INCOGNITO_WINDOW; break;
+    case Cmd::kFind: id = IDC_FIND; break;
+    case Cmd::kPrint: id = IDC_PRINT; break;
+    case Cmd::kDevTools: id = IDC_DEV_TOOLS_TOGGLE; break;
+    case Cmd::kToggleBookmarkBar: id = IDC_SHOW_BOOKMARK_BAR; break;
+    case Cmd::kTaskManager: id = IDC_TASK_MANAGER_MAIN_MENU; break;
+    case Cmd::kClearBrowsingData: id = IDC_CLEAR_BROWSING_DATA; break;
+    case Cmd::kNewWindow: id = IDC_NEW_WINDOW; break;
+    case Cmd::kExit: id = IDC_EXIT; break;
+    case Cmd::kSavePage: id = IDC_SAVE_PAGE; break;
+    case Cmd::kFullscreen: id = IDC_FULLSCREEN; break;
+  }
+  chrome::ExecuteCommand(browser, id);
+}
