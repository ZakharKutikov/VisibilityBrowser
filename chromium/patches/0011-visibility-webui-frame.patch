@@ -0,0 +1,79 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: Xray routing rules. Ported from vpn-extension/lib/routing.js
+// (itself ported from legacy-electron/vpn-routing.js), unchanged.
+
+/** Geosite categories for services commonly blocked in Russia. */
+export const RU_BLOCKED_GEOSITE: string[] = [
+  'geosite:youtube', 'geosite:google', 'geosite:twitter', 'geosite:facebook',
+  'geosite:instagram', 'geosite:telegram', 'geosite:discord', 'geosite:tiktok',
+  'geosite:openai', 'geosite:netflix', 'geosite:spotify', 'geosite:linkedin',
+  'geosite:whatsapp', 'geosite:reddit', 'geosite:medium', 'geosite:twitch',
+  'geosite:github',
+];
+
+export const RU_BLOCKED_DOMAINS: string[] = [
+  'twitter.com', 'x.com', 'twimg.com', 't.co',
+  'facebook.com', 'fbcdn.net', 'instagram.com', 'cdninstagram.com', 'threads.net',
+  'youtube.com', 'youtu.be', 'googlevideo.com', 'ytimg.com',
+  'discord.com', 'discordapp.com', 'discord.gg', 'discord.media', 'discordapp.net',
+  'telegram.org', 't.me', 'telesco.pe',
+  'tiktok.com', 'tiktokcdn.com',
+  'openai.com', 'chatgpt.com', 'oaistatic.com', 'anthropic.com', 'claude.ai',
+  'netflix.com', 'nflxvideo.net', 'spotify.com', 'scdn.co', 'soundcloud.com',
+  'linkedin.com', 'licdn.com', 'whatsapp.com', 'whatsapp.net',
+  'reddit.com', 'redd.it', 'redditstatic.com', 'medium.com',
+  'twitch.tv', 'twitchcdn.net', 'ttvnw.net',
+  'bbc.com', 'bbc.co.uk',
+  'dropbox.com', 'dropboxusercontent.com',
+  'signal.org', 'signal.art',
+  'notion.so', 'notion.site', 'figma.com', 'canva.com',
+  'slack.com', 'slack-edge.com', 'zoom.us', 'zoom.com',
+  'proton.me', 'protonmail.com', 'protonvpn.com',
+  'rutracker.org', 'rutracker.net', 'rutracker.wiki',
+  'kinozal.tv', 'nnmclub.to', 'flibusta.is',
+].map(d => `domain:${d}`);
+
+/** Turns one line typed by the user into an Xray domain rule, or null to skip it. */
+export function normalizeCustomDomain(line: string): string|null {
+  const raw = (line || '').trim();
+  if (!raw || raw.startsWith('#')) return null;
+  if (/^(geosite|domain|full):/.test(raw)) return raw;
+  if (raw.startsWith('*.')) return `domain:${raw.slice(2)}`;
+  const host = raw.replace(/^https?:\/\//, '').split('/')[0]!.split(':')[0];
+  return host ? `domain:${host}` : null;
+}
+
+export interface RoutingRule {
+  type: 'field';
+  ip?: string[];
+  domain?: string[];
+  network?: string;
+  outboundTag: string;
+}
+
+export interface RoutingConfig {
+  domainStrategy: string;
+  rules: RoutingRule[];
+}
+
+/** mode: 'split-ru' sends only blocked services through the proxy; 'full' sends everything. */
+export function buildRoutingRules(mode: string, customLines: string[] = []): RoutingConfig {
+  const rules: RoutingRule[] = [
+    {type: 'field', ip: ['geoip:private'], outboundTag: 'direct'},
+    {type: 'field', domain: ['geosite:private'], outboundTag: 'direct'},
+  ];
+
+  if (mode === 'split-ru') {
+    const custom = customLines.map(normalizeCustomDomain).filter((d): d is string => d !== null);
+    const proxied = [...new Set([...RU_BLOCKED_GEOSITE, ...RU_BLOCKED_DOMAINS, ...custom])];
+    rules.push({type: 'field', domain: proxied, outboundTag: 'proxy'});
+    rules.push({type: 'field', network: 'tcp,udp', outboundTag: 'direct'});
+  } else {
+    rules.push({type: 'field', network: 'tcp,udp', outboundTag: 'proxy'});
+  }
+
+  return {domainStrategy: 'IPIfNonMatch', rules};
+}
