+std::optional<std::string> JpegDataToDataUrl(
+    const ThumbnailImage::CompressedThumbnailData& data) {
+  if (!data || data->data.empty()) {
+    return std::nullopt;
+  }
+  return "data:image/jpeg;base64," + base::Base64Encode(data->data);
+}
+}  // namespace
+
+void WebUIBrowserPageHandler::GetTabThumbnail(
+    const tabs_api::NodeId& tab_id,
+    GetTabThumbnailCallback callback) {
+  tabs::TabInterface* tab = nullptr;
+  std::optional<tabs::TabHandle> maybe_tab_handle = tab_id.ToTabHandle();
+  if (maybe_tab_handle) {
+    tab = maybe_tab_handle->Get();
+  }
+  ThumbnailTabHelper* helper = tab ? ThumbnailTabHelper::From(tab) : nullptr;
+  scoped_refptr<ThumbnailImage> thumbnail =
+      helper ? helper->thumbnail() : nullptr;
+  if (!thumbnail) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+
+  if (thumbnail->has_data()) {
+    std::move(callback).Run(JpegDataToDataUrl(thumbnail->data()));
+    return;
+  }
+
+  // Not ready yet -- kick off a capture; a new hover (and so a new call here)
+  // before this one resolves simply drops this subscription, which is fine
+  // since only the most recently hovered tab's thumbnail still matters.
+  thumbnail_subscription_ = thumbnail->Subscribe();
+  thumbnail_subscription_->SetCompressedImageCallback(base::BindRepeating(
+      &WebUIBrowserPageHandler::OnTabThumbnailAvailable,
+      base::Unretained(this), tab->GetHandle()));
+  thumbnail->RequestCompressedThumbnailData();
+  std::move(callback).Run(std::nullopt);
+}
+
+void WebUIBrowserPageHandler::OnTabThumbnailAvailable(
+    tabs::TabHandle tab_handle,
+    ThumbnailImage::CompressedThumbnailData data) {
+  thumbnail_subscription_.reset();
+  std::optional<std::string> data_url = JpegDataToDataUrl(data);
+  if (!data_url) {
+    return;
+  }
+  if (webui_browser::mojom::Page* page = Page()) {
+    page->TabThumbnailUpdated(tabs_api::NodeId::FromTabHandle(tab_handle),
+                              *data_url);
+  }
+}
