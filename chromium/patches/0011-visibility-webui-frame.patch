+import type {VisExtensionsElement} from './vis_extensions.js';
+
+export function getHtml(this: VisExtensionsElement) {
+  return html`<!--_html_template_start_-->
+<div class="backdrop" @click="${this.onBackdropClick}"></div>
+<section class="panel" role="dialog" aria-labelledby="extensionsTitle"
+    @keydown="${this.onKeydown}">
+  <header class="head">
+    <h2 class="title" id="extensionsTitle">
+      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
+          stroke="currentColor" stroke-width="2" stroke-linecap="round"
+          stroke-linejoin="round" aria-hidden="true">
+        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
+        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
+        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
+        <rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
+      ${this.t('extensions')}
+    </h2>
+    <button class="close" aria-label="${this.t('close')}"
+        @click="${this.onCloseClick}">
+      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
+          stroke="currentColor" stroke-width="2" stroke-linecap="round"
+          stroke-linejoin="round" aria-hidden="true">
+        <line x1="18" y1="6" x2="6" y2="18"/>
+        <line x1="6" y1="6" x2="18" y2="18"/></svg>
+    </button>
+  </header>
+
+  <div class="list">
+    ${this.items.length === 0 ? html`
+      <div class="empty">
+        <svg width="48" height="48" viewBox="0 0 24 24" fill="none"
+            stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
+            stroke-linejoin="round" aria-hidden="true">
+          <rect x="3" y="3" width="7" height="7" rx="1.5"/>
+          <rect x="14" y="3" width="7" height="7" rx="1.5"/>
+          <rect x="3" y="14" width="7" height="7" rx="1.5"/>
+          <rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
+        <span class="empty-text">${this.t('extEmpty')}</span>
+        <span class="empty-hint">${this.t('extEmptyHint')}</span>
+      </div>` : ''}
+    ${this.items.map(item => html`
+      <div class="item" ?data-disabled="${!item.enabled}">
+        <span class="icon-wrap">
+          <span class="letter" aria-hidden="true">${item.name.charAt(0)}</span>
+          <img src="${this.iconOf(item)}" alt="" @error="${this.onIconError}">
+        </span>
+        <span class="info">
+          <span class="name">${item.name}</span>
+          <span class="desc" title="${item.description}">
+            ${item.description}</span>
+        </span>
+        <label class="toggle" title="${this.t('extToggle')}">
+          <input type="checkbox" role="switch" data-id="${item.id}"
+              aria-label="${item.name}" .checked="${item.enabled}"
+              @change="${this.onToggleChange}">
+          <span class="slider"></span>
+        </label>
+        <button class="remove" data-id="${item.id}" ?hidden="${!item.removable}"
+            ?data-confirming="${this.confirmRemove === item.id}"
+            title="${this.t('extRemove')}" aria-label="${this.t('extRemove')}"
+            @click="${this.onRemoveClick}">
+          ${this.confirmRemove !== item.id ? html`
+            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
+                stroke="currentColor" stroke-width="2" stroke-linecap="round"
+                stroke-linejoin="round" aria-hidden="true">
+              <polyline points="3 6 5 6 21 6"/>
+              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
+            </svg>` : html`${this.t('confirm')}`}
+        </button>
+      </div>`)}
+  </div>
+
+  <footer class="foot">
+    <button class="store-btn" @click="${this.onStoreClick}">
+      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
+          stroke="currentColor" stroke-width="2" stroke-linecap="round"
+          stroke-linejoin="round" aria-hidden="true">
+        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
+        <line x1="3" y1="6" x2="21" y2="6"/>
+        <path d="M16 10a4 4 0 0 1-8 0"/></svg>
+      ${this.t('extStore')}
+    </button>
+  </footer>
+</section>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/vis_extensions.ts b/chrome/browser/resources/webui_browser/vis_extensions.ts
new file mode 100644
index 0000000000..fe4b6db36f
--- /dev/null
