diff --git a/chrome/browser/resources/webui_browser/tab_strip/vis_tab_preview.ts b/chrome/browser/resources/webui_browser/tab_strip/vis_tab_preview.ts
new file mode 100644
index 0000000000..f5d90ac32d
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/tab_strip/vis_tab_preview.ts
@@ -0,0 +1,80 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: the 2.1 tab hover preview (index.html's #tab-preview +
+// features.js's showTabPreview()/hideTabPreview()/ensureTabThumbnail()).
+// This component only renders; tab_strip.ts owns the hover-intent timer and
+// the mojom call for the thumbnail.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './vis_tab_preview.css.js';
+import {getHtml} from './vis_tab_preview.html.js';
+
+const CARD_WIDTH = 240;
+const VIEWPORT_MARGIN = 12;
+
+export class VisTabPreviewElement extends CrLitElement {
+  static get is() {
+    return 'vis-tab-preview';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      previewTitle: {state: true, type: String},
+      domain: {state: true, type: String},
+      faviconUrl: {state: true, type: String},
+      thumbnailUrl: {state: true, type: String},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor previewTitle: string = '';
+  accessor domain: string = '';
+  accessor faviconUrl: string|null = null;
+  accessor thumbnailUrl: string|null = null;
+
+  show(anchorRect: DOMRect, title: string, domain: string,
+       faviconUrl: string|null) {
+    this.previewTitle = title;
+    this.domain = domain;
+    this.faviconUrl = faviconUrl;
+    this.thumbnailUrl = null;
+
+    const left = Math.max(
+        VIEWPORT_MARGIN,
+        Math.min(
+            anchorRect.left + anchorRect.width / 2 - CARD_WIDTH / 2,
+            window.innerWidth - CARD_WIDTH - VIEWPORT_MARGIN));
+    this.style.left = `${Math.round(left)}px`;
+    this.style.top = `${Math.round(anchorRect.bottom + 6)}px`;
+    this.open = true;
+  }
+
+  hide() {
+    this.open = false;
+    this.thumbnailUrl = null;
+  }
+
+  setThumbnail(dataUrl: string) {
+    this.thumbnailUrl = dataUrl;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-tab-preview': VisTabPreviewElement;
+  }
+}
+
+customElements.define(VisTabPreviewElement.is, VisTabPreviewElement);
