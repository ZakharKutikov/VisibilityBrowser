+h2 {
+  margin: 0;
+  font: inherit;
+}
+
+button,
+input {
+  color: inherit;
+  font: inherit;
+}
+
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.backdrop {
+  position: absolute;
+  inset: 0;
+}
+
+.panel {
+  position: absolute;
+  top: 102px;
+  right: 16px;
+  display: flex;
+  flex-direction: column;
+  width: 380px;
+  max-width: calc(100% - 32px);
+  max-height: 540px;
+  overflow: hidden;
+  border: 1px solid rgba(255, 255, 255, 12%);
+  border-radius: 16px;
+  background: rgba(22, 22, 26, 94%);
+  box-shadow: 0 16px 48px rgba(0, 0, 0, 60%),
+      0 0 0 1px rgba(255, 255, 255, 5%);
+  backdrop-filter: blur(24px) saturate(160%);
+  transform-origin: top right;
+  animation: pop 0.38s var(--ease-spring) both;
+}
+
+@keyframes pop {
+  from {
+    opacity: 0;
+    transform: translateY(-8px) scale(0.96);
+  }
+}
+
+.head {
+  display: flex;
+  flex-shrink: 0;
+  align-items: center;
+  justify-content: space-between;
+  padding: 16px 18px 12px;
+}
+
+.title {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 15px;
+  font-weight: 700;
+}
+
+.close {
+  display: grid;
+  width: 28px;
+  height: 28px;
+  border: none;
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 6%);
+  color: var(--text-secondary);
+  place-items: center;
+  cursor: pointer;
+  transition: background 0.15s, color 0.15s;
+}
+
+.close:hover {
+  background: rgba(255, 255, 255, 12%);
+  color: var(--text-primary);
+}
+
+.list {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 0 10px 10px;
+}
+
+.list::-webkit-scrollbar {
+  width: 4px;
+}
+
+.list::-webkit-scrollbar-thumb {
+  border-radius: 10px;
+  background: rgba(255, 255, 255, 12%);
+}
+
+.empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6px;
+  padding: 40px 20px 46px;
+  color: var(--text-muted);
