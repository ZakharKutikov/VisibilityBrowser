@@ -0,0 +1,128 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: the extensions dropdown of Visibility 2.1 — installed
+// extensions with an on/off switch and a remove button, and a link to the
+// extension store.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {ExtensionEntry} from './browser.mojom-webui.js';
+import {browserProxyFactory} from './browser.mojom-webui.js';
+import {getCss} from './vis_extensions.css.js';
+import {getHtml} from './vis_extensions.html.js';
+import {t} from './vis_settings.js';
+
+const STORE_URL = 'https://chromewebstore.google.com/';
+
+export class VisExtensionsElement extends CrLitElement {
+  static get is() {
+    return 'vis-extensions';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      items: {state: true, type: Array},
+      confirmRemove: {state: true, type: String},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor items: ExtensionEntry[] = [];
+  accessor confirmRemove: string = '';
+
+  readonly t = t;
+
+  toggle() {
+    if (this.open) {
+      this.hide();
+    } else {
+      this.show();
+    }
+  }
+
+  show() {
+    this.open = true;
+    this.confirmRemove = '';
+    this.refresh_();
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  private async refresh_() {
+    const {extensions} =
+        await browserProxyFactory.getInstance().handler.getExtensions();
+    this.items = extensions;
+  }
+
+  iconOf(item: ExtensionEntry): string {
+    return `chrome://extension-icon/${item.id}/48/0`;
+  }
+
+  // ---------- template handlers ----------
+
+  onBackdropClick() {
+    this.hide();
+  }
+
+  onCloseClick() {
+    this.hide();
+  }
+
+  onKeydown(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.stopPropagation();
+      this.hide();
+    }
+  }
+
+  onToggleChange(e: Event) {
+    const box = e.target as HTMLInputElement;
+    const id = box.dataset['id'];
+    if (id) {
+      browserProxyFactory.getInstance().handler.setExtensionEnabled(
+          id, box.checked);
+      window.setTimeout(() => this.refresh_(), 200);
+    }
+  }
+
+  onRemoveClick(e: Event) {
+    const id = (e.currentTarget as HTMLElement).dataset['id'] || '';
+    if (this.confirmRemove !== id) {
+      this.confirmRemove = id;
+      return;
+    }
+    this.confirmRemove = '';
+    browserProxyFactory.getInstance().handler.uninstallExtension(id);
+    this.items = this.items.filter(x => x.id !== id);
+  }
+
+  onStoreClick() {
+    this.fire('open-url', STORE_URL);
+    this.hide();
+  }
+
+  onIconError(e: Event) {
+    (e.target as HTMLImageElement).hidden = true;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-extensions': VisExtensionsElement;
+  }
+}
+
+customElements.define(VisExtensionsElement.is, VisExtensionsElement);
