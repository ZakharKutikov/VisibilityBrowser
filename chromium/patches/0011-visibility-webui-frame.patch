+void WebUIBrowserPageHandler::ClearBrowsingData(
+    bool cookies_and_cache,
+    bool history_and_downloads,
+    ClearBrowsingDataCallback callback) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser) {
+    std::move(callback).Run();
+    return;
+  }
+  uint64_t mask = 0;
+  if (cookies_and_cache) {
+    mask |= chrome_browsing_data_remover::DATA_TYPE_SITE_DATA |
+            content::BrowsingDataRemover::DATA_TYPE_CACHE;
+  }
+  if (history_and_downloads) {
+    mask |= chrome_browsing_data_remover::DATA_TYPE_HISTORY |
+            content::BrowsingDataRemover::DATA_TYPE_DOWNLOADS;
+  }
+  browser->GetProfile()->GetBrowsingDataRemover()->Remove(
+      base::Time(), base::Time::Max(), mask,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB);
+  std::move(callback).Run();
+}
