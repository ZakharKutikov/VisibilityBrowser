+                  html`${this.isState_(PageInfoState.kUnknown) ?
+                      html`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>` :
+                      html`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>`}`}
+            </div>
+            <div>
+              <div class="status-text" style="color:${this.statusColor_()}">${this.statusText_()}</div>
+              <div class="domain">${this.domainLabel_()}</div>
+            </div>
+          </div>
+          ${this.descLabel_() ? html`<p class="desc">${this.descLabel_()}</p>` : html``}
+        </div>
+        ${this.info?.hasCertificate ? html`
+          <div class="validity">
+            <div class="validity-labels">
+              <span>${this.validFromLabel_()}</span>
+              <span>${this.validToLabel_()}</span>
+            </div>
+            <div class="validity-track">
+              <div class="validity-fill" style="width:${this.validityPct_()}%;background:${this.statusColor_()}">
+              </div>
+            </div>
+          </div>
+          <div class="rows">
+            <div class="row">
+              <svg class="row-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
+              <div class="row-text">
+                <div class="row-label">${this.t('pageInfoIssuedTo')}</div>
