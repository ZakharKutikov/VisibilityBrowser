+
+namespace {
+
+using webui_browser::mojom::PermissionCategory;
+
+PermissionCategory CategoryFor(permissions::RequestType type) {
+  switch (type) {
+    case permissions::RequestType::kCameraStream:
+    case permissions::RequestType::kMicStream:
+      return PermissionCategory::kMedia;
+    case permissions::RequestType::kGeolocation:
+      return PermissionCategory::kGeolocation;
+    case permissions::RequestType::kNotifications:
+      return PermissionCategory::kNotifications;
+    case permissions::RequestType::kMidiSysex:
+      return PermissionCategory::kMidi;
+#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_WIN)
+    case permissions::RequestType::kProtectedMediaIdentifier:
+      return PermissionCategory::kProtectedMedia;
+#endif
+    default:
+      return PermissionCategory::kGeneric;
+  }
+}
+
+}  // namespace
+
+WebUIBrowserPermissionPrompt::WebUIBrowserPermissionPrompt(
+    Delegate* delegate,
+    WebUIBrowserWindow* window)
+    : delegate_(delegate), window_(window) {
+  const auto& requests = delegate_->Requests();
+
+  PermissionCategory category = PermissionCategory::kGeneric;
+  for (const auto& request : requests) {
+    PermissionCategory c = CategoryFor(request->request_type());
+    if (c != PermissionCategory::kGeneric) {
+      category = c;
+      break;
+    }
+  }
+
+  std::u16string generic_description;
+  if (category == PermissionCategory::kGeneric) {
+    std::vector<std::u16string> fragments;
+    fragments.reserve(requests.size());
+    for (const auto& request : requests) {
+      fragments.push_back(request->GetMessageTextFragment());
+    }
+    generic_description = base::JoinString(fragments, u", ");
+  }
+
+  webui_browser::mojom::PermissionPromptInfo info;
+  info.category = category;
+  info.origin = delegate_->GetRequestingOrigin().host();
+  info.description = base::UTF16ToUTF8(generic_description);
+
+  window_->SetActivePermissionPrompt(this);
+  if (webui_browser::mojom::Page* page = window_->GetWebUIBrowserUI()->page()) {
+    page->ShowPermissionPrompt(info.Clone());
+  }
+}
+
+WebUIBrowserPermissionPrompt::~WebUIBrowserPermissionPrompt() {
+  if (window_->GetActivePermissionPrompt() == this) {
+    window_->SetActivePermissionPrompt(nullptr);
+    if (webui_browser::mojom::Page* page =
+            window_->GetWebUIBrowserUI()->page()) {
+      page->HidePermissionPrompt();
+    }
+  }
+}
+
+bool WebUIBrowserPermissionPrompt::UpdateAnchor() {
+  return true;
+}
+
+permissions::PermissionPrompt::TabSwitchingBehavior
+WebUIBrowserPermissionPrompt::GetTabSwitchingBehavior() {
+  return TabSwitchingBehavior::kDestroyPromptButKeepRequestPending;
+}
+
+permissions::PermissionPromptDisposition
+WebUIBrowserPermissionPrompt::GetPromptDisposition() const {
+  return permissions::PermissionPromptDisposition::ANCHORED_BUBBLE;
+}
+
+bool WebUIBrowserPermissionPrompt::IsAskPrompt() const {
+  return true;
+}
+
+std::optional<gfx::Rect> WebUIBrowserPermissionPrompt::GetViewBoundsInScreen()
+    const {
+  return std::nullopt;
+}
+
+std::vector<permissions::ElementAnchoredBubbleVariant>
+WebUIBrowserPermissionPrompt::GetPromptVariants() const {
+  return {};
+}
+
+std::optional<permissions::feature_params::PermissionElementPromptPosition>
+WebUIBrowserPermissionPrompt::GetPromptPosition() const {
+  return std::nullopt;
+}
+
+void WebUIBrowserPermissionPrompt::Respond(
+    webui_browser::mojom::PermissionPromptAnswer answer) {
+  using Answer = webui_browser::mojom::PermissionPromptAnswer;
+  // `this` may not survive these calls (see header comment); do nothing with
+  // member state afterwards.
+  switch (answer) {
+    case Answer::kAllow:
+      delegate_->Accept({});
+      break;
+    case Answer::kAllowThisTime:
+      delegate_->AcceptThisTime({});
+      break;
+    case Answer::kBlock:
+      delegate_->Deny({});
+      break;
+    case Answer::kDismiss:
+      delegate_->Dismiss({});
+      break;
+  }
+}
