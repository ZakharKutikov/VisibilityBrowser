+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+/* Visibility: main menu dropdown, glass card in the 2.1 palette. */
+:host {
+  --text-primary: #f8fafc;
+  --text-secondary: #94a3b8;
+  --text-muted: rgba(255, 255, 255, 45%);
+  --accent: #818cf8;
+  --ease-ios: cubic-bezier(0.32, 0.72, 0, 1);
+  --ease-spring: cubic-bezier(0.34, 1.25, 0.64, 1);
+
+  position: fixed;
+  inset: 0;
+  z-index: 960;
+  display: none;
+  color: var(--text-primary);
+  font-family: 'Inter', 'Segoe UI Variable Text', 'Segoe UI', system-ui,
+      sans-serif;
+  font-size: 13px;
+}
+
+:host([open]) {
+  display: block;
+}
+
+.backdrop {
+  position: absolute;
+  inset: 0;
+}
+
+.menu {
+  position: absolute;
+  top: 98px;
+  right: 8px;
+  width: 290px;
+  max-height: calc(100% - 110px);
+  overflow-y: auto;
+  padding: 6px;
+  border: 1px solid rgba(255, 255, 255, 12%);
+  border-radius: 14px;
+  background: rgba(22, 22, 26, 96%);
+  box-shadow: 0 16px 48px rgba(0, 0, 0, 60%),
+      0 0 0 1px rgba(255, 255, 255, 5%);
+  backdrop-filter: blur(24px) saturate(160%);
+  transform-origin: top right;
+  animation: pop 0.3s var(--ease-spring) both;
+}
+
+@keyframes pop {
+  from {
+    opacity: 0;
+    transform: translateY(-6px) scale(0.96);
+  }
+}
+
+.group {
+  display: flex;
+  flex-direction: column;
+  padding: 4px 0;
+  border-bottom: 1px solid rgba(255, 255, 255, 7%);
+}
+
+.group:last-child {
+  border-bottom: none;
+}
+
+.item {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  width: 100%;
+  padding: 8px 10px;
+  border: none;
+  border-radius: 8px;
+  outline: none;
+  background: transparent;
+  color: var(--text-primary);
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+  transition: background 0.12s;
+}
+
+.item svg {
+  flex-shrink: 0;
+  color: var(--text-secondary);
+}
+
+.item:hover,
+.item:focus-visible {
+  background: rgba(255, 255, 255, 8%);
+}
+
+.item:focus-visible {
+  box-shadow: inset 0 0 0 1px var(--accent);
+}
+
+.item:hover svg,
+.item:focus-visible svg {
+  color: var(--accent);
+}
+
+.label {
+  flex: 1;
+  min-width: 0;
+}
+
+kbd {
+  color: var(--text-muted);
+  font-family: inherit;
+  font-size: 11px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .menu {
+    animation: none;
+  }
+}
