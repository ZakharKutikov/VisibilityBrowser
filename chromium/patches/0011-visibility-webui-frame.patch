+// Visibility: the 2.1-style permission prompt (camera, microphone, location,
+// notifications, ...), shown as a panel in the browser frame instead of a
+// native Views bubble or chip. Used for the common case only; PWA, quiet-UI,
+// exclusive-access and embedded-permission-element prompts still fall back
+// to Chromium's own UI (see MaybeCreateVisibilityPermissionPrompt).
+class WebUIBrowserPermissionPrompt : public permissions::PermissionPrompt {
+ public:
+  WebUIBrowserPermissionPrompt(Delegate* delegate, WebUIBrowserWindow* window);
+  WebUIBrowserPermissionPrompt(const WebUIBrowserPermissionPrompt&) = delete;
+  WebUIBrowserPermissionPrompt& operator=(
+      const WebUIBrowserPermissionPrompt&) = delete;
+  ~WebUIBrowserPermissionPrompt() override;
+
+  // permissions::PermissionPrompt:
+  bool UpdateAnchor() override;
+  TabSwitchingBehavior GetTabSwitchingBehavior() override;
+  permissions::PermissionPromptDisposition GetPromptDisposition()
+      const override;
+  bool IsAskPrompt() const override;
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override;
+  std::vector<permissions::ElementAnchoredBubbleVariant> GetPromptVariants()
+      const override;
+  std::optional<permissions::feature_params::PermissionElementPromptPosition>
+  GetPromptPosition() const override;
+
+  // Called by WebUIBrowserPageHandler::RespondToPermissionPrompt. `this` may
+  // be destroyed by the end of this call (accepting/denying a request
+  // synchronously tears down its PermissionPrompt), so the caller must not
+  // touch it again afterwards.
+  void Respond(webui_browser::mojom::PermissionPromptAnswer answer);
+
+ private:
+  raw_ptr<Delegate> delegate_;
+  raw_ptr<WebUIBrowserWindow> window_;
+};
