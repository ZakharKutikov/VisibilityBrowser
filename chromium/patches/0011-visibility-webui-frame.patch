+
+export function t(key: string): string {
+  const pair = TEXT[key];
+  return pair ? pair[RU ? 0 : 1] : key;
+}
+
+export const PANELS = ['general', 'privacy', 'appearance', 'shortcuts', 'vpn'];
+const PANEL_TITLES: Record<string, string> = {
+  general: 'tabGeneral',
+  privacy: 'tabPrivacy',
+  appearance: 'tabAppearance',
+  shortcuts: 'tabShortcuts',
+  vpn: 'tabVpn',
+};
+export function panelTitle(panel: string): string {
+  return t(PANEL_TITLES[panel]!);
+}
+
+// Chromium pref names (allow-listed for settingsPrivate).
+const PREF_HOMEPAGE = 'homepage';
+const PREF_HOMEPAGE_IS_NTP = 'homepage_is_newtabpage';
+const PREF_SHOW_HOME = 'browser.show_home_button';
+const PREF_RESTORE = 'session.restore_on_startup';
+const PREF_BOOKMARK_BAR = 'bookmark_bar.show_on_all_tabs';
+const PREF_DNT = 'enable_do_not_track';
+const PREF_COOKIES = 'profile.cookie_controls_mode';
+const PREF_FONT_SIZE = 'webkit.webprefs.default_font_size';
+const PREF_SAFE_BROWSING = 'safebrowsing.enabled';
+const PREF_PASSWORDS = 'credentials_enable_service';
+const RESTORE_LAST_SESSION = 1;
+const RESTORE_NEW_TAB = 5;
+const COOKIES_ALLOW = 0;
+const COOKIES_BLOCK_THIRD_PARTY = 1;
+
+export const ZOOM_LEVELS = [0.75, 0.9, 1, 1.1, 1.25, 1.5];
+export const FONT_SIZES = [12, 14, 16, 18, 20, 24];
+
+export class VisSettingsElement extends CrLitElement {
+  static get is() {
+    return 'vis-settings';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      panel_: {state: true, type: String},
+      homepage_: {state: true, type: String},
+      restore_: {state: true, type: Boolean},
+      bookmarkBar_: {state: true, type: Boolean},
+      showHome_: {state: true, type: Boolean},
+      dnt_: {state: true, type: Boolean},
+      blockThirdParty_: {state: true, type: Boolean},
+      safeBrowsing_: {state: true, type: Boolean},
+      passwords_: {state: true, type: Boolean},
+      fontSize_: {state: true, type: Number},
+      zoom_: {state: true, type: Number},
+      isDefault_: {state: true, type: Boolean},
+      confirming_: {state: true, type: String},
+      toast_: {state: true, type: String},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor panel_: string = 'general';
+  accessor homepage_: string = '';
+  accessor restore_: boolean = false;
+  accessor bookmarkBar_: boolean = false;
+  accessor showHome_: boolean = true;
+  accessor dnt_: boolean = false;
+  accessor blockThirdParty_: boolean = false;
+  accessor safeBrowsing_: boolean = true;
+  accessor passwords_: boolean = true;
+  accessor fontSize_: number = 16;
+  accessor zoom_: number = 1;
+  accessor isDefault_: boolean = false;
+  accessor confirming_: string = '';
+  accessor toast_: string = '';
+  private toastTimer_: number = 0;
+
+  readonly t = t;
+  readonly panelTitle = panelTitle;
+  readonly panels = PANELS;
+  readonly zoomLevels = ZOOM_LEVELS;
+  readonly fontSizes = FONT_SIZES;
+  readonly version = RU ? 'версия 3.0' : 'version 3.0';
+
+  show(panel: string = 'general') {
+    this.panel_ = PANELS.includes(panel) ? panel : 'general';
+    this.confirming_ = '';
+    this.open = true;
+    this.load_();
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  private async load_() {
+    const sp = chrome.settingsPrivate;
+    const [home, homeIsNtp, showHome, restore, bar, dnt, cookies, font, safe,
+           passwords] =
+        await Promise.all([
+          sp.getPref(PREF_HOMEPAGE),
+          sp.getPref(PREF_HOMEPAGE_IS_NTP),
+          sp.getPref(PREF_SHOW_HOME),
+          sp.getPref(PREF_RESTORE),
+          sp.getPref(PREF_BOOKMARK_BAR),
+          sp.getPref(PREF_DNT),
+          sp.getPref(PREF_COOKIES),
+          sp.getPref(PREF_FONT_SIZE),
+          sp.getPref(PREF_SAFE_BROWSING),
+          sp.getPref(PREF_PASSWORDS),
+        ]);
+    this.homepage_ = homeIsNtp.value ? '' : String(home.value || '');
+    this.showHome_ = Boolean(showHome.value);
+    this.restore_ = restore.value === RESTORE_LAST_SESSION;
+    this.bookmarkBar_ = Boolean(bar.value);
+    this.dnt_ = Boolean(dnt.value);
+    this.blockThirdParty_ = cookies.value !== COOKIES_ALLOW;
+    this.fontSize_ = Number(font.value);
+    this.safeBrowsing_ = Boolean(safe.value);
+    this.passwords_ = Boolean(passwords.value);
+    const zoom = await sp.getDefaultZoom();
+    this.zoom_ = ZOOM_LEVELS.reduce(
+        (a, b) => Math.abs(b - zoom) < Math.abs(a - zoom) ? b : a, 1);
+    const {isDefault} =
+        await browserProxyFactory.getInstance().handler.isDefaultBrowser();
+    this.isDefault_ = isDefault;
+  }
+
+  private notify_(text: string) {
+    this.toast_ = text;
+    window.clearTimeout(this.toastTimer_);
+    this.toastTimer_ = window.setTimeout(() => {
+      this.toast_ = '';
+    }, 1600);
+  }
+
+  private async setPref_(name: string, value: unknown) {
+    const ok = await chrome.settingsPrivate.setPref(name, value);
+    if (ok) {
+      this.notify_(t('saved'));
+    }
+    return ok;
+  }
+
+  // ---------- template handlers ----------
+
+  onBackdropClick_(e: Event) {
+    if (e.target === e.currentTarget) {
+      this.hide();
+    }
+  }
+
+  onCloseClick_() {
+    this.hide();
+  }
+
+  onKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.stopPropagation();
+      this.hide();
+    }
+  }
+
+  onSegmentClick_(e: Event) {
+    const panel = (e.currentTarget as HTMLElement).dataset['panel'];
+    if (panel) {
+      this.panel_ = panel;
+      this.confirming_ = '';
+    }
+  }
+
+  panelIndex_(): number {
+    return PANELS.indexOf(this.panel_);
+  }
+
+  async onHomepageChange_(e: Event) {
+    const url = (e.target as HTMLInputElement).value.trim();
+    if (url) {
+      await chrome.settingsPrivate.setPref(PREF_HOMEPAGE, url);
+      await this.setPref_(PREF_HOMEPAGE_IS_NTP, false);
+    } else {
+      await this.setPref_(PREF_HOMEPAGE_IS_NTP, true);
+    }
+    this.homepage_ = url;
+  }
+
+  async onToggleChange_(e: Event) {
+    const box = e.target as HTMLInputElement;
+    const on = box.checked;
+    let ok = false;
+    switch (box.dataset['pref']) {
+      case 'restore':
+        ok = await this.setPref_(
+            PREF_RESTORE, on ? RESTORE_LAST_SESSION : RESTORE_NEW_TAB);
+        if (ok) {
+          this.restore_ = on;
+        }
+        break;
+      case 'bookmarkBar':
+        ok = await this.setPref_(PREF_BOOKMARK_BAR, on);
+        if (ok) {
+          this.bookmarkBar_ = on;
+        }
+        break;
+      case 'showHome':
+        ok = await this.setPref_(PREF_SHOW_HOME, on);
+        if (ok) {
+          this.showHome_ = on;
+          this.fire('home-button-changed', on);
+        }
+        break;
+      case 'dnt':
+        ok = await this.setPref_(PREF_DNT, on);
+        if (ok) {
+          this.dnt_ = on;
+        }
+        break;
+      case 'blockThirdParty':
+        ok = await this.setPref_(
+            PREF_COOKIES, on ? COOKIES_BLOCK_THIRD_PARTY : COOKIES_ALLOW);
+        if (ok) {
+          this.blockThirdParty_ = on;
+        }
+        break;
+      case 'safeBrowsing':
+        ok = await this.setPref_(PREF_SAFE_BROWSING, on);
+        if (ok) {
+          this.safeBrowsing_ = on;
+        }
+        break;
+      case 'passwords':
+        ok = await this.setPref_(PREF_PASSWORDS, on);
+        if (ok) {
+          this.passwords_ = on;
+        }
+        break;
+    }
+    if (!ok) {
+      box.checked = !on;
+    }
+  }
+
+  async onFontSizeChange_(e: Event) {
+    const size = Number((e.target as HTMLSelectElement).value);
+    if (await this.setPref_(PREF_FONT_SIZE, size)) {
+      this.fontSize_ = size;
+    }
+  }
+
+  onZoomChange_(e: Event) {
+    const zoom = Number((e.target as HTMLSelectElement).value);
+    chrome.settingsPrivate.setDefaultZoom(zoom);
+    this.zoom_ = zoom;
+    this.notify_(t('saved'));
+  }
+
+  onMakeDefaultClick_() {
+    browserProxyFactory.getInstance().handler.makeDefaultBrowser();
+  }
+
+  async onClearClick_(e: Event) {
+    const what = (e.currentTarget as HTMLElement).dataset['clear'] || '';
+    // Second click confirms: the button turns into "Sure?" first.
+    if (this.confirming_ !== what) {
+      this.confirming_ = what;
+      return;
+    }
+    this.confirming_ = '';
+    await browserProxyFactory.getInstance().handler.clearBrowsingData(
+        what === 'cookies', what === 'history');
+    this.notify_(t('cleared'));
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-settings': VisSettingsElement;
+  }
+}
+
+customElements.define(VisSettingsElement.is, VisSettingsElement);
diff --git a/chrome/browser/resources/webui_browser/vis_settings_panels.ts b/chrome/browser/resources/webui_browser/vis_settings_panels.ts
new file mode 100644
index 0000000000..724294e4b9
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_settings_panels.ts
@@ -0,0 +1,197 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: the panels of the settings window (see vis_settings.ts).
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {VisSettingsElement} from './vis_settings.js';
+
+function toggle(
+    el: VisSettingsElement, pref: string, checked: boolean, label: string) {
+  return html`
+    <label class="toggle">
+      <input type="checkbox" role="switch" data-pref="${pref}"
+          aria-label="${label}" .checked="${checked}"
+          @change="${el.onToggleChange_}">
+      <span class="slider"></span>
+    </label>`;
+}
+
+function row(label: string, desc: string, control: unknown) {
+  return html`
+    <div class="row">
+      <div><div class="label">${label}</div>
+        ${desc ? html`<div class="desc">${desc}</div>` : ''}</div>
+      ${control}
+    </div>`;
+}
+
+function key(label: string, keys: string) {
+  return html`<div class="row"><div class="label">${label}</div>
+      <kbd>${keys}</kbd></div>`;
+}
+
+function generalPanel(el: VisSettingsElement) {
+  const t = el.t;
+  return html`
+    <div class="group">
+      <h3 class="group-title">${t('navTitle')}</h3>
+      <div class="group-card">
+        ${row(t('defaultBrowser'), t('defaultBrowserDesc'), el.isDefault_ ?
+            html`<span class="status">${t('isDefault')}</span>` :
+            html`<button class="btn-accent" @click="${el.onMakeDefaultClick_}">
+              ${t('makeDefault')}</button>`)}
+        ${row(t('homepage'), t('homepageDesc'), html`
+          <input class="input" type="url" spellcheck="false"
+              placeholder="https://google.com" aria-label="${t('homepage')}"
+              .value="${el.homepage_}" @change="${el.onHomepageChange_}">`)}
+        ${row(t('restore'), t('restoreDesc'),
+              toggle(el, 'restore', el.restore_, t('restore')))}
+      </div>
+    </div>`;
+}
+
+function privacyPanel(el: VisSettingsElement) {
+  const t = el.t;
+  const clearButton = (what: string, label: string, danger: boolean) => html`
+    <button class="btn-ghost ${danger ? 'danger' : ''}" data-clear="${what}"
+        ?data-confirming="${el.confirming_ === what}"
+        @click="${el.onClearClick_}">
+      ${el.confirming_ === what ? t('confirm') : label}
+    </button>`;
+  return html`
+    <div class="group">
+      <h3 class="group-title">${t('historyData')}</h3>
+      <div class="group-card">
+        ${row(t('clearCookies'), t('clearCookiesDesc'),
+              clearButton('cookies', t('clear'), false))}
+        ${row(t('clearHistory'), t('clearHistoryDesc'),
+              clearButton('history', t('delete'), true))}
+      </div>
+    </div>
+    <div class="group">
+      <h3 class="group-title">${t('protection')}</h3>
+      <div class="group-card">
+        ${row(t('thirdPartyCookies'), t('thirdPartyCookiesDesc'),
+              toggle(el, 'blockThirdParty', el.blockThirdParty_,
+                          t('thirdPartyCookies')))}
+        ${row(t('dnt'), t('dntDesc'), toggle(el, 'dnt', el.dnt_,
+                                                   t('dnt')))}
+        ${row(t('safeBrowsing'), t('safeBrowsingDesc'),
+              toggle(el, 'safeBrowsing', el.safeBrowsing_,
+                          t('safeBrowsing')))}
+        ${row(t('passwords'), t('passwordsDesc'),
+              toggle(el, 'passwords', el.passwords_, t('passwords')))}
+      </div>
+    </div>
+    <div class="group">
+      <h3 class="group-title">${t('incognito')}</h3>
+      <div class="group-card">
+        ${row(t('incognitoTabs'), t('incognitoDesc'),
+              html`<span class="status muted">Ctrl+Shift+N</span>`)}
+      </div>
+    </div>`;
+}
+
+function appearancePanel(el: VisSettingsElement) {
+  const t = el.t;
+  return html`
+    <div class="group">
+      <h3 class="group-title">${t('appearance')}</h3>
+      <div class="group-card">
+        ${row(t('bookmarksBar'), t('bookmarksBarDesc'),
+              toggle(el, 'bookmarkBar', el.bookmarkBar_,
+                          t('bookmarksBar')))}
+        ${row(t('homeButton'), t('homeButtonDesc'),
+              toggle(el, 'showHome', el.showHome_, t('homeButton')))}
+        ${row(t('fontSize'), t('fontSizeDesc'), html`
+          <select class="select" aria-label="${t('fontSize')}"
+              @change="${el.onFontSizeChange_}">
+            ${el.fontSizes.map(size => html`
+              <option value="${size}" ?selected="${size === el.fontSize_}">
+                ${size}</option>`)}
+          </select>`)}
+      </div>
+    </div>
+    <div class="group">
+      <h3 class="group-title">${t('zoomTitle')}</h3>
+      <div class="group-card">
+        ${row(t('zoom'), t('zoomDesc'), html`
+          <select class="select" aria-label="${t('zoom')}"
+              @change="${el.onZoomChange_}">
+            ${el.zoomLevels.map(zoom => html`
+              <option value="${zoom}" ?selected="${zoom === el.zoom_}">
+                ${Math.round(zoom * 100)}%</option>`)}
+          </select>`)}
+      </div>
+    </div>
+    <div class="group">
+      <h3 class="group-title">${t('about')}</h3>
+      <div class="group-card">
+        ${row('Visibility Browser', t('aboutDesc'),
+              html`<span class="version">${el.version}</span>`)}
+      </div>
+    </div>`;
+}
+
+function shortcutsPanel(el: VisSettingsElement) {
+  const t = el.t;
+  return html`
+    <div class="group">
+      <h3 class="group-title">${t('shTabs')}</h3>
+      <div class="group-card">
+        ${key(t('shNewTab'), 'Ctrl+T')}
+        ${key(t('shCloseTab'), 'Ctrl+W')}
+        ${key(t('shNextTab'), 'Ctrl+Tab')}
+        ${key(t('shReopen'), 'Ctrl+Shift+T')}
+      </div>
+    </div>
+    <div class="group">
+      <h3 class="group-title">${t('shNav')}</h3>
+      <div class="group-card">
+        ${key(t('shUrl'), 'Ctrl+L')}
+        ${key(t('shReload'), 'F5 / Ctrl+R')}
+        ${key(t('shHardReload'), 'Ctrl+Shift+R')}
+        ${key(t('shBackForward'), 'Alt+← / Alt+→')}
+      </div>
+    </div>
+    <div class="group">
+      <h3 class="group-title">${t('shTools')}</h3>
+      <div class="group-card">
+        ${key(t('shHistory'), 'Ctrl+H')}
+        ${key(t('shDownloads'), 'Ctrl+J')}
+        ${key(t('shIncognito'), 'Ctrl+Shift+N')}
+        ${key(t('shBookmark'), 'Ctrl+D')}
+        ${key(t('shZoom'), 'Ctrl+= / Ctrl+- / Ctrl+0')}
+      </div>
+    </div>`;
+}
+
+function vpnPanel(el: VisSettingsElement) {
+  const t = el.t;
+  return html`
+    <div class="group">
+      <h3 class="group-title">${t('vpnTitle')}</h3>
+      <div class="group-card">
+        ${row(t('vpnManage'), t('vpnManageDesc'),
+              html`<span class="status muted">${t('vpnWhere')}</span>`)}
+      </div>
+    </div>`;
+}
+
+export function renderPanel(el: VisSettingsElement) {
+  switch (el.panel_) {
+    case 'privacy':
+      return privacyPanel(el);
+    case 'appearance':
+      return appearancePanel(el);
+    case 'shortcuts':
+      return shortcutsPanel(el);
+    case 'vpn':
+      return vpnPanel(el);
+    default:
+      return generalPanel(el);
+  }
+}
diff --git a/chrome/browser/resources/webui_browser/vis_sidebar.css b/chrome/browser/resources/webui_browser/vis_sidebar.css
new file mode 100644
index 0000000000..068b78e60f
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_sidebar.css
@@ -0,0 +1,386 @@
+/* Copyright 2026 The Chromium Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+/* Visibility: the 2.1 sidebar (index.html, #sidebar), 380px from the right. */
+:host {
+  --bg-secondary: #15171e;
+  --text-primary: #f8fafc;
+  --text-secondary: #94a3b8;
+  --text-muted: rgba(255, 255, 255, 45%);
+  --accent: #818cf8;
+  --border: rgba(255, 255, 255, 8%);
+  --border-bright: rgba(255, 255, 255, 14%);
+  --danger: #f55;
+  --ease-ios: cubic-bezier(0.32, 0.72, 0, 1);
+  --ease-spring: cubic-bezier(0.34, 1.25, 0.64, 1);
+
+  position: fixed;
+  inset: 0;
+  z-index: 900;
+  color: var(--text-primary);
+  font-family: 'Inter', 'Segoe UI Variable Text', 'Segoe UI', system-ui,
+      sans-serif;
+  font-size: 13px;
+  pointer-events: none;
+}
+
+.backdrop {
+  position: absolute;
+  inset: 0;
+  background: rgba(0, 0, 0, 40%);
+  opacity: 0;
+  transition: opacity 0.32s ease;
+}
+
+.sidebar {
+  position: absolute;
+  top: 0;
+  right: 0;
+  display: flex;
+  flex-direction: column;
+  width: 380px;
+  max-width: 100%;
+  height: 100%;
+  overflow: hidden;
+  border-left: 1px solid var(--border);
+  background: var(--bg-secondary);
+  box-shadow: -8px 0 32px rgba(0, 0, 0, 30%);
+  transform: translateX(100%);
+  transition: transform 0.32s var(--ease-ios);
+}
+
+:host([open]) {
+  pointer-events: auto;
+}
+
+:host([open]) .backdrop {
+  opacity: 1;
+}
+
+:host([open]) .sidebar {
+  transform: none;
+}
+
+h2,
+h3 {
+  margin: 0;
+  font: inherit;
+}
+
+button,
+input {
+  color: inherit;
+  font: inherit;
+}
+
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.head {
+  display: flex;
+  flex-shrink: 0;
+  align-items: center;
+  justify-content: space-between;
+  padding: 14px 16px;
+  border-bottom: 1px solid var(--border);
+}
+
+.title {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 14px;
+  font-weight: 700;
+}
+
+.close {
+  display: grid;
+  width: 28px;
+  height: 28px;
+  border: none;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text-secondary);
+  place-items: center;
+  cursor: pointer;
+  transition: background 0.15s, color 0.15s;
+}
+
+.close:hover {
+  background: rgba(255, 255, 255, 6%);
+  color: var(--text-primary);
+}
+
+.tabs {
+  flex-shrink: 0;
+  padding: 10px 16px;
+  border-bottom: 1px solid rgba(255, 255, 255, 6%);
+}
+
+.segments {
+  position: relative;
+  display: flex;
+  padding: 3px;
+  border: 1px solid rgba(255, 255, 255, 10%);
+  border-radius: 11px;
+  background: rgba(255, 255, 255, 8%);
+}
+
+.seg-indicator {
+  position: absolute;
+  top: 3px;
+  left: 3px;
+  width: calc((100% - 6px) / 2);
+  height: calc(100% - 6px);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 20%);
+  box-shadow: 0 1px 4px rgba(0, 0, 0, 28%),
+      0 0 0 0.5px rgba(255, 255, 255, 12%);
+  transform: translateX(calc(var(--index) * 100%));
+  transition: transform 0.42s var(--ease-spring);
+  pointer-events: none;
+}
+
+.seg {
+  position: relative;
+  z-index: 1;
+  display: flex;
+  flex: 1;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 9px 12px;
+  border: none;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text-secondary);
+  font-size: 12px;
+  font-weight: 600;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: color 0.28s var(--ease-ios);
+}
+
+.seg:hover,
+.seg[aria-selected='true'] {
+  color: var(--text-primary);
+}
+
+.panel {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  min-height: 0;
+  animation: slide 0.36s var(--ease-ios) both;
+}
+
+@keyframes slide {
+  from {
+    opacity: 0;
+    transform: translateX(18px);
+  }
+}
+
+.search {
+  flex-shrink: 0;
+  margin: 12px 16px;
+  padding: 11px 14px;
+  border: 1px solid transparent;
+  border-radius: 10px;
+  outline: none;
+  background: rgba(255, 255, 255, 5%);
+  font-size: 13px;
+}
+
+.search:focus {
+  border-color: var(--accent);
+}
+
+.search::placeholder {
+  color: var(--text-muted);
+}
+
+.list {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 0 0 8px;
+}
+
+.list::-webkit-scrollbar {
+  width: 5px;
+}
+
+.list::-webkit-scrollbar-thumb {
+  border-radius: 3px;
+  background: var(--border-bright);
+}
+
+.group-label {
+  margin: 6px 18px 6px;
+  color: var(--text-muted);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.group {
+  margin: 0 14px 12px;
+  overflow: hidden;
+  border: 1px solid rgba(255, 255, 255, 7%);
+  border-radius: 12px;
+  background: rgba(255, 255, 255, 3.5%);
+}
+
+.item {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 10px 12px;
+  border-bottom: 1px solid rgba(255, 255, 255, 4%);
+  cursor: pointer;
+  transition: background 0.15s ease;
+}
+
+.item:last-child {
+  border-bottom: none;
+}
+
+.item:hover {
+  background: rgba(255, 255, 255, 7%);
+}
+
+.icon {
+  display: grid;
+  flex-shrink: 0;
+  width: 32px;
+  height: 32px;
+  border: 1px solid rgba(255, 255, 255, 8%);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 6%);
+  place-items: center;
+}
+
+.icon img {
+  width: 16px;
+  height: 16px;
+}
+
+.content {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  min-width: 0;
+}
+
+.item-title,
+.item-url {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.item-title {
+  margin-bottom: 2px;
+  font-size: 12px;
+  font-weight: 600;
+}
+
+.item-url {
+  color: var(--text-muted);
+  font-size: 11px;
+}
+
+.time {
+  flex-shrink: 0;
+  color: var(--text-muted);
+  font-size: 10px;
+}
+
+.remove {
+  display: grid;
+  flex-shrink: 0;
+  width: 26px;
+  height: 26px;
+  border: none;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--text-muted);
+  place-items: center;
+  opacity: 0;
+  cursor: pointer;
+  transition: background 0.15s, opacity 0.15s, color 0.15s;
+}
+
+.item:hover .remove,
+.remove:focus-visible {
+  opacity: 1;
+}
+
+.remove:hover {
+  background: rgba(224, 85, 85, 20%);
+  color: var(--danger);
+}
+
+.empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 10px;
+  padding: 40px 20px;
+  color: var(--text-muted);
+  text-align: center;
+}
+
+.empty svg {
+  opacity: 0.4;
+}
+
+.foot {
+  flex-shrink: 0;
+  padding: 12px 16px;
+  border-top: 1px solid var(--border);
+}
+
+.danger-btn {
+  width: 100%;
+  padding: 9px;
+  border: none;
+  border-radius: 8px;
+  background: rgba(224, 85, 85, 15%);
+  color: var(--danger);
+  font-size: 12px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: background 0.15s;
+}
+
+.danger-btn:hover {
+  background: rgba(224, 85, 85, 25%);
+}
+
+.bookmarks {
+  overflow-y: auto;
+  padding: 8px 6px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .backdrop,
+  .sidebar,
+  .seg-indicator {
+    transition: none;
+  }
+
+  .panel {
+    animation: none;
+  }
+}
diff --git a/chrome/browser/resources/webui_browser/vis_sidebar.html.ts b/chrome/browser/resources/webui_browser/vis_sidebar.html.ts
new file mode 100644
index 0000000000..03264e04ec
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_sidebar.html.ts
@@ -0,0 +1,118 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {VisSidebarElement} from './vis_sidebar.js';
+
+export function getHtml(this: VisSidebarElement) {
+  return html`<!--_html_template_start_-->
+<div class="backdrop" @click="${this.onBackdropClick}"></div>
+<aside class="sidebar" role="dialog" aria-labelledby="sidebarTitle"
+    @keydown="${this.onKeydown}">
+  <header class="head">
+    <h2 class="title" id="sidebarTitle">
+      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
+          stroke="currentColor" stroke-width="2" stroke-linecap="round"
+          stroke-linejoin="round" aria-hidden="true">
+        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
+        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
+      </svg>
+      ${this.t('sidebarTitle')}
+    </h2>
+    <button class="close" aria-label="${this.t('close')}"
+        @click="${this.onCloseClick}">
+      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
+          stroke="currentColor" stroke-width="2" stroke-linecap="round"
+          stroke-linejoin="round" aria-hidden="true">
+        <line x1="18" y1="6" x2="6" y2="18"/>
+        <line x1="6" y1="6" x2="18" y2="18"/></svg>
+    </button>
+  </header>
+
+  <div class="tabs">
+    <div class="segments" role="tablist"
+        style="--index:${this.panel === 'history' ? 0 : 1}">
+      <span class="seg-indicator" aria-hidden="true"></span>
+      <button class="seg" role="tab" data-panel="history"
+          aria-selected="${this.panel === 'history'}"
+          @click="${this.onSegmentClick}">
+        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
+            stroke="currentColor" stroke-width="2" stroke-linecap="round"
+            stroke-linejoin="round" aria-hidden="true">
+          <circle cx="12" cy="12" r="10"/>
+          <polyline points="12 6 12 12 16 14"/></svg>
+        ${this.t('history')}
+      </button>
+      <button class="seg" role="tab" data-panel="bookmarks"
+          aria-selected="${this.panel === 'bookmarks'}"
+          @click="${this.onSegmentClick}">
+        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
+            stroke="currentColor" stroke-width="2" stroke-linecap="round"
+            stroke-linejoin="round" aria-hidden="true">
+          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
+        </svg>
+        ${this.t('bookmarks')}
+      </button>
+    </div>
+  </div>
+
+  ${this.panel === 'history' ? html`
+    <section class="panel">
+      <input class="search" type="search" spellcheck="false"
+          placeholder="${this.t('historySearch')}"
+          aria-label="${this.t('historySearch')}" .value="${this.query}"
+          @input="${this.onSearchInput}">
+      <div class="list">
+        ${this.isEmpty() ? html`
+          <div class="empty">
+            <svg width="40" height="40" viewBox="0 0 24 24" fill="none"
+                stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
+                stroke-linejoin="round" aria-hidden="true">
+              <circle cx="12" cy="12" r="10"/>
+              <polyline points="12 6 12 12 16 14"/></svg>
+            <span>${this.query ? this.t('historyNothing') :
+                                 this.t('historyEmpty')}</span>
+          </div>` : ''}
+        ${this.groups.map(group => html`
+          <h3 class="group-label">${group.label}</h3>
+          <div class="group">
+            ${group.entries.map(entry => html`
+              <div class="item" role="link" tabindex="0" title="${entry.url}"
+                  data-url="${entry.url}" @click="${this.onEntryClick}">
+                <span class="icon"><img src="${this.faviconOf(entry)}" alt="">
+                </span>
+                <span class="content">
+                  <span class="item-title">${this.titleOf(entry)}</span>
+                  <span class="item-url">${this.hostOf(entry)}</span>
+                </span>
+                <span class="time">${this.timeOf(entry)}</span>
+                <button class="remove" data-url="${entry.url}"
+                    title="${this.t('removeFromHistory')}"
+                    aria-label="${this.t('removeFromHistory')}"
+                    @click="${this.onEntryRemoveClick}">
+                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
+                      stroke="currentColor" stroke-width="2"
+                      stroke-linecap="round" stroke-linejoin="round"
+                      aria-hidden="true">
+                    <line x1="18" y1="6" x2="6" y2="18"/>
+                    <line x1="6" y1="6" x2="18" y2="18"/></svg>
+                </button>
+              </div>`)}
+          </div>`)}
+      </div>
+      <footer class="foot">
+        <button class="danger-btn" @click="${this.onClearHistoryClick}">
+          ${this.confirmClear ? this.t('confirm') : this.t('clearHistoryAll')}
+        </button>
+      </footer>
+    </section>
+  ` : html`
+    <section class="panel bookmarks">
+      <webui-browser-bookmarks></webui-browser-bookmarks>
+    </section>
+  `}
+</aside>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/vis_sidebar.ts b/chrome/browser/resources/webui_browser/vis_sidebar.ts
new file mode 100644
index 0000000000..506c8fdb14
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_sidebar.ts
@@ -0,0 +1,207 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: the "History and bookmarks" sidebar of Visibility 2.1. It slides
+// in from the right over the page; history comes from the browser through the
+// page handler, bookmarks reuse the WebUI browser's bookmarks list.
+
+import './bookmarks/bookmarks.js';
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {HistoryEntry} from './browser.mojom-webui.js';
+import {browserProxyFactory} from './browser.mojom-webui.js';
+import {getCss} from './vis_sidebar.css.js';
+import {getHtml} from './vis_sidebar.html.js';
+import {t} from './vis_settings.js';
+
+export interface HistoryGroup {
+  label: string;
+  entries: HistoryEntry[];
+}
+
+const LOCALE = document.documentElement.lang || navigator.language;
+const TIME = new Intl.DateTimeFormat(LOCALE, {hour: '2-digit', minute: '2-digit'});
+const DAY = new Intl.DateTimeFormat(
+    LOCALE, {weekday: 'long', day: 'numeric', month: 'long'});
+
+function dayKey(ms: number): string {
+  const d = new Date(ms);
+  return `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
+}
+
+export class VisSidebarElement extends CrLitElement {
+  static get is() {
+    return 'vis-sidebar';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      panel: {state: true, type: String},
+      groups: {state: true, type: Array},
+      query: {state: true, type: String},
+      loaded: {state: true, type: Boolean},
+      confirmClear: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor panel: string = 'history';
+  accessor groups: HistoryGroup[] = [];
+  accessor query: string = '';
+  accessor loaded: boolean = false;
+  accessor confirmClear: boolean = false;
+  private searchTimer_: number = 0;
+
+  readonly t = t;
+
+  show(panel: string = 'history') {
+    this.panel = panel === 'bookmarks' ? 'bookmarks' : 'history';
+    this.open = true;
+    this.confirmClear = false;
+    this.loadHistory_();
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  toggle(panel: string = 'history') {
+    if (this.open && this.panel === panel) {
+      this.hide();
+    } else {
+      this.show(panel);
+    }
+  }
+
+  private async loadHistory_() {
+    const {entries} = await browserProxyFactory.getInstance()
+                          .handler.queryHistory(this.query, 150);
+    const today = dayKey(Date.now());
+    const yesterday = dayKey(Date.now() - 24 * 3600 * 1000);
+    const groups: HistoryGroup[] = [];
+    for (const entry of entries) {
+      const key = dayKey(entry.lastVisitMs);
+      const label = key === today     ? t('today') :
+          key === yesterday           ? t('yesterday') :
+                                        DAY.format(new Date(entry.lastVisitMs));
+      const last = groups[groups.length - 1];
+      if (last && last.label === label) {
+        last.entries.push(entry);
+      } else {
+        groups.push({label, entries: [entry]});
+      }
+    }
+    this.groups = groups;
+    this.loaded = true;
+  }
+
+  timeOf(entry: HistoryEntry): string {
+    return TIME.format(new Date(entry.lastVisitMs));
+  }
+
+  hostOf(entry: HistoryEntry): string {
+    try {
+      return new URL(entry.url).hostname.replace(/^www\./, '');
+    } catch {
+      return entry.url;
+    }
+  }
+
+  faviconOf(entry: HistoryEntry): string {
+    return `chrome://favicon2/?size=16&scaleFactor=1x&pageUrl=${
+        encodeURIComponent(entry.url)}&allowGoogleServerFallback=0`;
+  }
+
+  titleOf(entry: HistoryEntry): string {
+    return entry.title || this.hostOf(entry);
+  }
+
+  isEmpty(): boolean {
+    return this.loaded && this.groups.length === 0;
+  }
+
+  // ---------- template handlers ----------
+
+  onBackdropClick() {
+    this.hide();
+  }
+
+  onCloseClick() {
+    this.hide();
+  }
+
+  onKeydown(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.stopPropagation();
+      this.hide();
+    }
+  }
+
+  onSegmentClick(e: Event) {
+    const panel = (e.currentTarget as HTMLElement).dataset['panel'];
+    if (panel) {
+      this.panel = panel;
+      if (panel === 'history') {
+        this.loadHistory_();
+      }
+    }
+  }
+
+  onSearchInput(e: Event) {
+    this.query = (e.target as HTMLInputElement).value.trim();
+    window.clearTimeout(this.searchTimer_);
+    this.searchTimer_ = window.setTimeout(() => this.loadHistory_(), 180);
+  }
+
+  onEntryClick(e: Event) {
+    const url = (e.currentTarget as HTMLElement).dataset['url'];
+    if (url) {
+      this.fire('open-url', url);
+      this.hide();
+    }
+  }
+
+  onEntryRemoveClick(e: Event) {
+    e.stopPropagation();
+    const url = (e.currentTarget as HTMLElement).dataset['url'];
+    if (url) {
+      browserProxyFactory.getInstance().handler.deleteHistoryUrl(url);
+      this.groups = this.groups
+                        .map(g => ({
+                               label: g.label,
+                               entries: g.entries.filter(x => x.url !== url),
+                             }))
+                        .filter(g => g.entries.length > 0);
+    }
+  }
+
+  async onClearHistoryClick() {
+    if (!this.confirmClear) {
+      this.confirmClear = true;
+      return;
+    }
+    this.confirmClear = false;
+    await browserProxyFactory.getInstance().handler.clearBrowsingData(
+        false, true);
+    this.groups = [];
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-sidebar': VisSidebarElement;
+  }
+}
+
+customElements.define(VisSidebarElement.is, VisSidebarElement);
diff --git a/chrome/browser/resources/webui_browser/vis_vpn.css b/chrome/browser/resources/webui_browser/vis_vpn.css
new file mode 100644
index 0000000000..cda71714a4
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_vpn.css
@@ -0,0 +1,440 @@
+/* Copyright 2026 The Chromium Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+/* Visibility: the VPN panel of Visibility 2.1 (vpn-extension/popup.css),
+ * now a flyout in the frame instead of a separate extension popup window. */
+:host {
+  --ink: #15171e;
+  --surface: #1e202a;
+  --raised: #262936;
+  --line: rgba(255, 255, 255, 8%);
+  --text: #f8fafc;
+  --muted: #94a3b8;
+  --indigo: #818cf8;
+  --lamp: #818cf8;
+  --lamp-ink: #0d0e12;
+  --danger: #e8a598;
+  --radius: 10px;
+  --ease-ios: cubic-bezier(0.32, 0.72, 0, 1);
+  --ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
+
+  position: fixed;
+  inset: 0;
+  z-index: 950;
+  display: none;
+  color: var(--text);
+  font-family: 'Inter', 'Segoe UI Variable Text', 'Segoe UI', system-ui,
+      sans-serif;
+  font-size: 13px;
+  line-height: 1.45;
+}
+
+:host([open]) {
+  display: block;
+}
+
+.backdrop {
+  position: absolute;
+  inset: 0;
+}
+
+h1,
+h2,
+p,
+ul {
+  margin: 0;
+  padding: 0;
+}
+
+button,
+input,
+textarea {
+  color: inherit;
+  font: inherit;
+}
+
+:focus-visible {
+  outline: 2px solid var(--indigo);
+  outline-offset: 2px;
+}
+
+.panel {
+  position: absolute;
+  top: 102px;
+  right: 16px;
+  width: 360px;
+  max-width: calc(100% - 32px);
+  max-height: 72vh;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  border-radius: 16px;
+  background: var(--ink);
+  box-shadow: 0 16px 48px rgba(0, 0, 0, 60%), 0 0 0 1px rgba(255, 255, 255, 5%);
+  backdrop-filter: blur(24px) saturate(160%);
+  transform-origin: top right;
+  animation: pop 0.38s var(--ease-spring) both;
+  overflow-y: auto;
+}
+
+@keyframes pop {
+  from {
+    opacity: 0;
+    transform: translateY(-8px) scale(0.96);
+  }
+}
+
+h2 {
+  font-size: 12px;
+  font-weight: 500;
+  color: var(--muted);
+}
+
+section {
+  flex-shrink: 0;
+  padding: 14px 16px;
+  border-top: 1px solid var(--line);
+}
+
+section:first-of-type {
+  border-top: none;
+}
+
+/* ---------- the switch: the one loud element ---------- */
+
+.power {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 20px 16px 18px;
+  transition: background 0.4s var(--ease-ios);
+}
+
+.power.on {
+  background: radial-gradient(120% 140% at 100% 50%,
+      color-mix(in srgb, var(--lamp) 14%, transparent), transparent 70%);
+}
+
+.power-text {
+  flex: 1;
+  min-width: 0;
+}
+
+.power h1 {
+  font-size: 21px;
+  font-weight: 600;
+  line-height: 1.2;
+  letter-spacing: -0.01em;
+}
+
+.power p {
+  margin-top: 3px;
+  color: var(--muted);
+  overflow-wrap: anywhere;
+}
+
+.switch {
+  flex-shrink: 0;
+  width: 76px;
+  height: 42px;
+  padding: 4px;
+  border: 1px solid var(--line);
+  border-radius: 21px;
+  background: var(--surface);
+  cursor: pointer;
+  transition: background 0.3s var(--ease-ios), border-color 0.3s var(--ease-ios),
+      box-shadow 0.3s var(--ease-ios);
+}
+
+.switch-knob {
+  display: block;
+  width: 32px;
+  height: 32px;
+  border-radius: 50%;
+  background: var(--muted);
+  transition: transform 0.35s var(--ease-spring), background 0.3s var(--ease-ios);
+}
+
+.switch[aria-checked='true'] {
+  border-color: var(--lamp);
+  background: var(--lamp);
+  box-shadow: 0 0 22px color-mix(in srgb, var(--lamp) 40%, transparent);
+}
+
+.switch[aria-checked='true'] .switch-knob {
+  background: var(--lamp-ink);
+  transform: translateX(34px);
+}
+
+.switch:disabled {
+  cursor: default;
+  opacity: 0.45;
+}
+
+.switch.busy .switch-knob {
+  animation: pulse 0.9s ease-in-out infinite alternate;
+}
+
+@keyframes pulse {
+  to {
+    opacity: 0.35;
+  }
+}
+
+/* ---------- buttons ---------- */
+
+.btn {
+  border: 0;
+  border-radius: var(--radius);
+  cursor: pointer;
+  transition: transform 0.15s var(--ease-ios), opacity 0.2s var(--ease-ios);
+}
+
+.btn:not(:disabled):active,
+.switch:not(:disabled):active {
+  transform: scale(0.96);
+}
+
+.btn:disabled {
+  cursor: default;
+  opacity: 0.5;
+}
+
+.btn-solid {
+  padding: 7px 14px;
+  background: var(--indigo);
+  color: var(--lamp-ink);
+  font-weight: 500;
+}
+
+.btn-text {
+  padding: 2px 0;
+  background: none;
+  color: var(--indigo);
+}
+
+/* ---------- core missing ---------- */
+
+.core {
+  display: grid;
+  gap: 10px;
+  justify-items: start;
+  background: var(--surface);
+}
+
+.quiet {
+  color: var(--muted);
+  font-size: 12px;
+}
+
+.bar {
+  width: 100%;
+  height: 4px;
+  overflow: hidden;
+  border-radius: 2px;
+  background: var(--raised);
+}
+
+.bar span {
+  display: block;
+  height: 100%;
+  width: 0;
+  background: var(--indigo);
+  transition: width 0.2s linear;
+}
+
+/* ---------- servers ---------- */
+
+.row-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  margin-bottom: 8px;
+}
+
+.servers {
+  margin: 0 -6px;
+  max-height: 190px;
+  overflow-y: auto;
+  list-style: none;
+}
+
+.server {
+  display: grid;
+  grid-template-columns: 16px 1fr auto 24px;
+  align-items: center;
+  gap: 10px;
+  padding: 7px 6px;
+  border-radius: var(--radius);
+  cursor: pointer;
+  transition: background-color 0.25s var(--ease-ios);
+}
+
+.server:hover {
+  background: var(--surface);
+}
+
+.server::before {
+  width: 14px;
+  height: 14px;
+  border: 1.5px solid var(--muted);
+  border-radius: 50%;
+  content: '';
+}
+
+.server[aria-checked='true']::before {
+  border-color: var(--indigo);
+  background: radial-gradient(var(--indigo) 45%, transparent 50%);
+}
+
+.server.live::before {
+  border-color: var(--lamp);
+  background: radial-gradient(var(--lamp) 45%, transparent 50%);
+}
+
+.server-name {
+  overflow: hidden;
+  font-weight: 500;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.server-meta {
+  display: block;
+  overflow: hidden;
+  color: var(--muted);
+  font-size: 11.5px;
+  font-weight: 400;
+  text-overflow: ellipsis;
+}
+
+.server-ping {
+  color: var(--muted);
+  font-size: 11.5px;
+  font-variant-numeric: tabular-nums;
+}
+
+.server-ping.slow {
+  color: var(--danger);
+}
+
+.server-del {
+  width: 24px;
+  height: 24px;
+  border: 0;
+  border-radius: 6px;
+  background: none;
+  color: var(--muted);
+  font-size: 16px;
+  line-height: 1;
+  cursor: pointer;
+  opacity: 0;
+}
+
+.server:hover .server-del,
+.server-del:focus-visible {
+  opacity: 1;
+}
+
+.server-del:hover {
+  background: var(--raised);
+  color: var(--danger);
+}
+
+.empty {
+  color: var(--muted);
+}
+
+.add {
+  display: flex;
+  gap: 8px;
+  margin-top: 12px;
+}
+
+input[type='text'],
+textarea {
+  flex: 1;
+  min-width: 0;
+  padding: 7px 10px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background: var(--surface);
+}
+
+input::placeholder,
+textarea::placeholder {
+  color: var(--muted);
+}
+
+/* ---------- routing ---------- */
+
+.segments {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  margin-top: 8px;
+  padding: 3px;
+  border-radius: var(--radius);
+  background: var(--surface);
+}
+
+.segments button {
+  padding: 6px 8px;
+  border: 0;
+  border-radius: 7px;
+  background: none;
+  color: var(--muted);
+  cursor: pointer;
+}
+
+.segments button[aria-checked='true'] {
+  background: var(--raised);
+  color: var(--text);
+  font-weight: 500;
+}
+
+details {
+  margin-top: 12px;
+}
+
+summary {
+  color: var(--indigo);
+  cursor: pointer;
+}
+
+details textarea {
+  display: block;
+  width: 100%;
+  margin: 8px 0;
+  resize: vertical;
+}
+
+/* ---------- messages ---------- */
+
+.notice {
+  position: sticky;
+  bottom: 0;
+  padding: 10px 16px;
+  border-top: 1px solid var(--line);
+  background: var(--raised);
+}
+
+.notice.error {
+  color: var(--danger);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .panel {
+    animation: none;
+  }
+
+  * {
+    transition: none !important;
+    animation: none !important;
+  }
+}
diff --git a/chrome/browser/resources/webui_browser/vis_vpn.html.ts b/chrome/browser/resources/webui_browser/vis_vpn.html.ts
new file mode 100644
index 0000000000..eaa8ef0e52
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_vpn.html.ts
@@ -0,0 +1,109 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {VisVpnElement} from './vis_vpn.js';
+
+export function getHtml(this: VisVpnElement) {
+  return html`<!--_html_template_start_-->
+<div class="backdrop" @click="${this.onCloseClick}"></div>
+<section class="panel" role="dialog" aria-labelledby="vpnTitle"
+    @keydown="${this.onKeydown}">
+  <header class="power ${this.connected ? 'on' : ''}">
+    <div class="power-text">
+      <h1 id="vpnTitle">${this.isConnecting() ? this.t('vpnStateConnecting') :
+                                       (this.connected ? this.t('vpnStateOn') : this.t('vpnStateOff'))}</h1>
+      <p>${this.connected && this.current ?
+          this.current.name :
+          (!this.servers.length ? this.t('vpnHintNoServers') :
+                                  (this.pickedServer() ? this.t('vpnHintReady').replace('$1', this.pickedServer()!.name) :
+                                            this.t('vpnHintPick')))}</p>
+    </div>
+    <button class="switch ${this.busy ? 'busy' : ''}" role="switch"
+        aria-checked="${this.connected}" aria-label="${this.t('vpnSwitchLabel')}"
+        ?disabled="${this.busy || (!this.connected && (!this.pickedServer() || !this.hasCore))}"
+        @click="${this.onSwitchClick}">
+      <span class="switch-knob"></span>
+    </button>
+  </header>
+
+  ${!this.hasCore ? html`
+    <section class="core">
+      <p>${this.t('vpnCoreMissing')}</p>
+      <button class="btn btn-solid" ?disabled="${this.installing}"
+          @click="${this.onInstallClick}">
+        ${this.installing ? this.t('vpnCoreDownloading').replace('$1', String(this.installPercent)) :
+                            this.t('vpnCoreDownload')}
+      </button>
+      ${this.installing ? html`
+        <div class="bar"><span style="width:${this.installPercent}%"></span></div>` : ''}
+      <p class="quiet">${this.t('vpnCoreBlockedHint')}</p>
+    </section>` : ''}
+
+  <section>
+    <div class="row-head">
+      <h2>${this.t('vpnServersTitle')}</h2>
+      ${this.servers.length && this.hasCore ? html`
+        <button class="btn btn-text" ?disabled="${this.checkingSpeed}"
+            @click="${this.onPingClick}">
+          ${this.checkingSpeed ? this.t('vpnChecking') : this.t('vpnCheckSpeed')}
+        </button>` : ''}
+    </div>
+    <ul class="servers" role="radiogroup">
+      ${this.servers.map((srv, i) => html`
+        <li class="server ${this.sameServer(srv, this.current ?? undefined) ? 'live' : ''}"
+            role="radio" aria-checked="${i === this.selected}" tabindex="0"
+            data-index="${i}" @click="${this.onServerClick}"
+            @keydown="${this.onServerKeydown}">
+          <span class="server-name">${srv.name}
+            <span class="server-meta">${this.hostLabel(srv)}</span>
+          </span>
+          <span class="server-ping ${this.pingSlow(i) ? 'slow' : ''}">
+            ${this.pingLabel(i)}</span>
+          <button class="server-del" data-index="${i}"
+              aria-label="${this.t('vpnRemove').replace('$1', srv.name)}"
+              @click="${this.onServerRemoveClick}">×</button>
+        </li>`)}
+    </ul>
+    ${!this.servers.length ? html`<p class="empty">${this.t('vpnEmptyList')}</p>` : ''}
+
+    <form class="add" @submit="${this.onAddSubmit}">
+      <input type="text" autocomplete="off" spellcheck="false"
+          placeholder="${this.t('vpnAddPlaceholder')}" aria-label="${this.t('vpnAddLabel')}"
+          .value="${this.addText}" @input="${this.onAddInput}">
+      <button class="btn btn-solid" type="submit" ?disabled="${this.adding}">
+        ${this.adding ? this.t('vpnAdding') : this.t('vpnAdd')}
+      </button>
+    </form>
+  </section>
+
+  <section>
+    <h2 id="vpnRoutingTitle">${this.t('vpnRoutingTitle')}</h2>
+    <div class="segments" role="radiogroup" aria-labelledby="vpnRoutingTitle">
+      <button role="radio" aria-checked="${this.routingMode === 'split-ru'}"
+          data-mode="split-ru" @click="${this.onRoutingClick}">
+        ${this.t('vpnRoutingSplit')}</button>
+      <button role="radio" aria-checked="${this.routingMode === 'full'}"
+          data-mode="full" @click="${this.onRoutingClick}">
+        ${this.t('vpnRoutingFull')}</button>
+    </div>
+
+    ${this.routingMode === 'split-ru' ? html`
+      <details>
+        <summary>${this.t('vpnCustomTitle')}</summary>
+        <textarea rows="4" spellcheck="false" placeholder="${this.t('vpnCustomHint')}"
+            aria-label="${this.t('vpnCustomTitle')}" .value="${this.customDomains.join('\n')}"
+            @input="${this.onCustomInput}"></textarea>
+        <button class="btn btn-solid" @click="${this.onCustomSaveClick}">
+          ${this.t('save')}</button>
+      </details>` : ''}
+  </section>
+
+  ${this.notice ? html`
+    <p class="notice ${this.noticeIsError ? 'error' : ''}" role="status">
+      ${this.notice}</p>` : ''}
+</section>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/vis_vpn.ts b/chrome/browser/resources/webui_browser/vis_vpn.ts
new file mode 100644
index 0000000000..c7a4cdfb8d
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_vpn.ts
@@ -0,0 +1,411 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: the built-in VPN panel (vpn-extension/popup.* of 2.1, moved
+// into the frame). Business data (server list, routing mode) lives in this
+// trusted page's own localStorage, same idea as the old background.js's
+// chrome.storage.local; everything that needs OS privilege (spawning Xray,
+// the profile's proxy) goes through VisibilityVpnService via mojom, with no
+// Chrome extension involved anywhere in the loop any more.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {browserProxyFactory} from './browser.mojom-webui.js';
+import {t} from './vis_settings.js';
+import {buildConfig} from './vis_vpn_config.js';
+import type {VpnServer} from './vis_vpn_links.js';
+import {parseLinks, parseSubscription, serverKey} from './vis_vpn_links.js';
+import {getCss} from './vis_vpn.css.js';
+import {getHtml} from './vis_vpn.html.js';
+
+const STORE_KEY = 'visibility-vpn-v1';
+
+interface Stored {
+  servers: VpnServer[];
+  subUrl: string;
+  routingMode: string;
+  customDomains: string[];
+  selected: number;
+}
+
+const DEFAULTS: Stored = {servers: [], subUrl: '', routingMode: 'split-ru', customDomains: [], selected: -1};
+
+function load(): Stored {
+  try {
+    const raw = window.localStorage.getItem(STORE_KEY);
+    if (!raw) return {...DEFAULTS};
+    return {...DEFAULTS, ...JSON.parse(raw)};
+  } catch {
+    return {...DEFAULTS};
+  }
+}
+
+function save(s: Stored) {
+  try {
+    window.localStorage.setItem(STORE_KEY, JSON.stringify(s));
+  } catch {
+    /* storage unavailable (private mode, quota) — the panel still works this session */
+  }
+}
+
+const sameServer = (a?: VpnServer, b?: VpnServer) =>
+    !!a && !!b && a.type === b.type && a.address === b.address && a.port === b.port &&
+    (a.uuid || a.password) === (b.uuid || b.password);
+
+export class VisVpnElement extends CrLitElement {
+  static get is() {
+    return 'vis-vpn';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      servers: {state: true, type: Array},
+      selected: {state: true, type: Number},
+      routingMode: {state: true, type: String},
+      customDomains: {state: true, type: Array},
+      connected: {state: true, type: Boolean},
+      current: {state: true, type: Object},
+      hasCore: {state: true, type: Boolean},
+      busy: {state: true, type: Boolean},
+      checkingSpeed: {state: true, type: Boolean},
+      installing: {state: true, type: Boolean},
+      installPercent: {state: true, type: Number},
+      pings: {state: true, type: Array},
+      notice: {state: true, type: String},
+      noticeIsError: {state: true, type: Boolean},
+      addText: {state: true, type: String},
+      adding: {state: true, type: Boolean},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor servers: VpnServer[] = [];
+  accessor selected: number = -1;
+  accessor routingMode: string = 'split-ru';
+  accessor customDomains: string[] = [];
+  accessor connected: boolean = false;
+  accessor current: VpnServer|null = null;
+  accessor hasCore: boolean = true;  // optimistic until the first check replies
+  accessor busy: boolean = false;
+  accessor checkingSpeed: boolean = false;
+  accessor installing: boolean = false;
+  accessor installPercent: number = 0;
+  accessor pings: number[]|null = null;
+  accessor notice: string = '';
+  accessor noticeIsError: boolean = false;
+  accessor addText: string = '';
+  accessor adding: boolean = false;
+  private noticeTimer_: number = 0;
+
+  readonly t = t;
+  readonly sameServer = sameServer;
+
+  constructor() {
+    super();
+    const s = load();
+    this.servers = s.servers;
+    this.selected = s.selected;
+    this.routingMode = s.routingMode;
+    this.customDomains = s.customDomains;
+
+    const router = browserProxyFactory.getInstance().callbackRouter;
+    router.vpnInstallProgress.addListener((percent: number) => {
+      this.installPercent = percent;
+    });
+    router.vpnInstallFinished.addListener((ok: boolean) => {
+      this.installing = false;
+      this.hasCore = ok;
+      if (!ok) this.showNotice_(this.errorText_('DOWNLOAD_FAILED'), true);
+    });
+    router.vpnCoreExited.addListener(() => {
+      this.connected = false;
+      this.current = null;
+    });
+  }
+
+  toggle() {
+    if (this.open) {
+      this.hide();
+    } else {
+      this.show();
+    }
+  }
+
+  show() {
+    this.open = true;
+    this.refreshCoreStatus_();
+    browserProxyFactory.getInstance().handler.vpnIsConnected().then(({connected}) => {
+      this.connected = connected;
+      if (connected && this.selected >= 0) {
+        this.current = this.servers[this.selected] ?? null;
+      }
+    });
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  private async refreshCoreStatus_() {
+    const {hasCore} = await browserProxyFactory.getInstance().handler.vpnHasCore();
+    this.hasCore = hasCore;
+  }
+
+  private persist_() {
+    save({
+      servers: this.servers,
+      subUrl: '',
+      routingMode: this.routingMode,
+      customDomains: this.customDomains,
+      selected: this.selected,
+    });
+  }
+
+  private showNotice_(text: string, isError = false) {
+    this.notice = text;
+    this.noticeIsError = isError;
+    window.clearTimeout(this.noticeTimer_);
+    this.noticeTimer_ = window.setTimeout(() => {
+      this.notice = '';
+    }, isError ? 7000 : 3000);
+  }
+
+  private errorText_(code: string): string {
+    const key = 'vpnErr' + code;
+    const text = t(key);
+    return text === key ? t('vpnErrUnknown').replace('$1', code) : text;
+  }
+
+  // ---------- connect / disconnect ----------
+
+  private async connectTo_(index: number) {
+    const server = this.servers[index];
+    if (!server) return;
+    this.busy = true;
+    try {
+      const config = JSON.stringify(
+          buildConfig(server, this.routingMode, this.customDomains));
+      const {ok, error} =
+          await browserProxyFactory.getInstance().handler.vpnStart(config);
+      if (ok) {
+        this.connected = true;
+        this.current = server;
+        this.selected = index;
+        this.persist_();
+      } else {
+        this.showNotice_(this.errorText_(error), true);
+      }
+    } finally {
+      this.busy = false;
+    }
+  }
+
+  private async disconnect_() {
+    this.busy = true;
+    try {
+      await browserProxyFactory.getInstance().handler.vpnStop();
+      this.connected = false;
+      this.current = null;
+    } finally {
+      this.busy = false;
+    }
+  }
+
+  private async reconnectIfActive_() {
+    if (!this.connected || !this.current) return;
+    const index = this.servers.findIndex(x => sameServer(x, this.current!));
+    if (index === -1) {
+      await this.disconnect_();
+    } else {
+      await this.connectTo_(index);
+    }
+  }
+
+  // ---------- template handlers ----------
+
+  onSwitchClick() {
+    if (this.busy) return;
+    if (this.connected) {
+      this.disconnect_();
+    } else if (this.selected >= 0 && this.hasCore) {
+      this.connectTo_(this.selected);
+    }
+  }
+
+  onCloseClick() {
+    this.hide();
+  }
+
+  onKeydown(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.stopPropagation();
+      this.hide();
+    }
+  }
+
+  onServerClick(e: Event) {
+    const index = Number((e.currentTarget as HTMLElement).dataset['index']);
+    if (this.busy || Number.isNaN(index)) return;
+    if (this.connected) {
+      this.connectTo_(index);  // switch live
+    } else {
+      this.selected = index;
+      this.persist_();
+    }
+  }
+
+  onServerKeydown(e: KeyboardEvent) {
+    if (e.key === 'Enter' || e.key === ' ') {
+      e.preventDefault();
+      this.onServerClick(e);
+    }
+  }
+
+  onServerRemoveClick(e: Event) {
+    e.stopPropagation();
+    const index = Number((e.currentTarget as HTMLElement).dataset['index']);
+    if (Number.isNaN(index)) return;
+    const removed = this.servers[index];
+    const wasCurrent = this.connected && sameServer(removed, this.current ?? undefined);
+    this.servers = this.servers.filter((_, i) => i !== index);
+    if (this.selected === index) {
+      this.selected = this.servers.length ? Math.min(index, this.servers.length - 1) : -1;
+    } else if (this.selected > index) {
+      this.selected--;
+    }
+    this.pings = null;
+    this.persist_();
+    if (wasCurrent) this.disconnect_();
+  }
+
+  onAddInput(e: Event) {
+    this.addText = (e.target as HTMLInputElement).value;
+  }
+
+  async onAddSubmit(e: Event) {
+    e.preventDefault();
+    const text = this.addText.trim();
+    if (!text || this.adding) return;
+    this.adding = true;
+    this.pings = null;
+    try {
+      if (/^https?:\/\//i.test(text)) {
+        let body: string;
+        try {
+          const res = await fetch(text, {redirect: 'follow', cache: 'no-store'});
+          if (!res.ok) throw new Error(String(res.status));
+          body = await res.text();
+        } catch {
+          this.showNotice_(this.errorText_('SUB_FETCH'), true);
+          return;
+        }
+        const found = parseSubscription(body);
+        if (!found.length) {
+          this.showNotice_(this.errorText_('SUB_PARSE'), true);
+          return;
+        }
+        this.servers = found;
+        this.selected = 0;
+        this.persist_();
+        this.addText = '';
+        this.showNotice_(t('vpnMsgImported').replace('$1', String(found.length)));
+        await this.reconnectIfActive_();
+      } else {
+        const found = parseLinks(text);
+        if (!found.length) {
+          this.showNotice_(this.errorText_('LINK_FORMAT'), true);
+          return;
+        }
+        const known = new Set(this.servers.map(serverKey));
+        const added = found.filter(s => !known.has(serverKey(s)) && known.add(serverKey(s)));
+        this.servers = [...this.servers, ...added];
+        if (this.selected < 0 && this.servers.length) this.selected = 0;
+        this.persist_();
+        this.addText = '';
+        this.showNotice_(added.length ? t('vpnMsgAdded').replace('$1', String(added.length)) :
+                                        t('vpnMsgAlready'));
+      }
+    } finally {
+      this.adding = false;
+    }
+  }
+
+  async onPingClick() {
+    this.checkingSpeed = true;
+    try {
+      const targets = this.servers.map(s => ({address: s.address, port: s.port}));
+      const {millis} = await browserProxyFactory.getInstance().handler.vpnPing(targets);
+      this.pings = millis;
+    } finally {
+      this.checkingSpeed = false;
+    }
+  }
+
+  async onRoutingClick(e: Event) {
+    const mode = (e.currentTarget as HTMLElement).dataset['mode'];
+    if (!mode || mode === this.routingMode) return;
+    this.routingMode = mode;
+    this.persist_();
+    await this.reconnectIfActive_();
+  }
+
+  onCustomInput(e: Event) {
+    this.customDomains = (e.target as HTMLTextAreaElement).value.split('\n');
+  }
+
+  async onCustomSaveClick() {
+    this.customDomains = this.customDomains.map(l => l.trim()).filter(Boolean);
+    this.persist_();
+    await this.reconnectIfActive_();
+    this.showNotice_(t('saved'));
+  }
+
+  onInstallClick() {
+    this.installing = true;
+    this.installPercent = 0;
+    browserProxyFactory.getInstance().handler.vpnInstallCore();
+  }
+
+  hostLabel(s: VpnServer): string {
+    return `${s.type.toUpperCase()}  ${s.address}:${s.port}`;
+  }
+
+  // ---------- values the template needs but should not compute itself ----------
+
+  pickedServer(): VpnServer|undefined {
+    return this.servers[this.selected];
+  }
+
+  isConnecting(): boolean {
+    return this.busy && !this.connected;
+  }
+
+  pingLabel(index: number): string {
+    const ms = this.pings?.[index];
+    if (typeof ms !== 'number') return '';
+    return ms >= 0 ? t('vpnMs').replace('$1', String(ms)) : t('vpnNoResponse');
+  }
+
+  pingSlow(index: number): boolean {
+    const ms = this.pings?.[index];
+    return typeof ms === 'number' && (ms < 0 || ms > 300);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-vpn': VisVpnElement;
+  }
+}
+
+customElements.define(VisVpnElement.is, VisVpnElement);
diff --git a/chrome/browser/resources/webui_browser/vis_vpn_config.ts b/chrome/browser/resources/webui_browser/vis_vpn_config.ts
new file mode 100644
index 0000000000..ec9e868216
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_vpn_config.ts
@@ -0,0 +1,100 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: builds the Xray config for one server. Ported from
+// vpn-extension/lib/config.js, unchanged.
+
+import type {VpnServer} from './vis_vpn_links.js';
+import {buildRoutingRules} from './vis_vpn_routing.js';
+
+export const SOCKS_PORT = 10808;
+
+function buildStream(s: VpnServer): Record<string, unknown> {
+  const network = s.network || 'tcp';
+  const security = s.security || (s.tls ? 'tls' : 'none');
+  const st: Record<string, unknown> = {network, security};
+
+  if (network === 'ws') st['wsSettings'] = {path: s.path || '/', headers: s.host ? {Host: s.host} : {}};
+  if (network === 'grpc') st['grpcSettings'] = {serviceName: s.path || ''};
+  if (network === 'h2' || network === 'http') st['httpSettings'] = {path: s.path || '/', host: s.host ? [s.host] : []};
+
+  if (security === 'tls') {
+    st['tlsSettings'] = {serverName: s.sni || s.host || s.address, fingerprint: s.fp || 'chrome', allowInsecure: false};
+  }
+  if (security === 'reality') {
+    st['realitySettings'] = {
+      serverName: s.sni || s.address,
+      fingerprint: s.fp || 'chrome',
+      publicKey: s.pbk || '',
+      shortId: s.sid || '',
+      show: false,
+    };
+  }
+  return st;
+}
+
+export function buildOutbound(s: VpnServer): Record<string, unknown> {
+  switch (s.type) {
+    case 'vmess':
+      return {
+        tag: 'proxy',
+        protocol: 'vmess',
+        settings: {vnext: [{address: s.address, port: s.port, users: [{id: s.uuid, alterId: s.alterId || 0, security: 'auto'}]}]},
+        streamSettings: buildStream(s),
+      };
+    case 'vless': {
+      const user: Record<string, unknown> = {id: s.uuid, encryption: 'none'};
+      if (s.flow) user['flow'] = s.flow;
+      return {
+        tag: 'proxy',
+        protocol: 'vless',
+        settings: {vnext: [{address: s.address, port: s.port, users: [user]}]},
+        streamSettings: buildStream(s),
+      };
+    }
+    case 'trojan':
+      return {
+        tag: 'proxy',
+        protocol: 'trojan',
+        settings: {servers: [{address: s.address, port: s.port, password: s.uuid}]},
+        streamSettings: buildStream(s),
+      };
+    case 'shadowsocks':
+      return {
+        tag: 'proxy',
+        protocol: 'shadowsocks',
+        settings: {servers: [{address: s.address, port: s.port, method: s.method, password: s.password}]},
+      };
+    default:
+      throw new Error(`Unsupported server type: ${s.type}`);
+  }
+}
+
+export function buildConfig(server: VpnServer, routingMode = 'split-ru', customDomains: string[] = []):
+    Record<string, unknown> {
+  return {
+    log: {loglevel: 'error'},
+    dns: {
+      servers: ['https://1.1.1.1/dns-query', '8.8.8.8', '8.8.4.4', '77.88.8.8', 'localhost'],
+      queryStrategy: 'UseIPv4',
+    },
+    inbounds: [
+      // sniffing recovers the domain name so that domain routing rules can match.
+      {
+        tag: 'socks',
+        protocol: 'socks',
+        listen: '127.0.0.1',
+        port: SOCKS_PORT,
+        settings: {auth: 'noauth', udp: true},
+        sniffing: {enabled: true, destOverride: ['http', 'tls', 'quic']},
+      },
+    ],
+    outbounds: [
+      buildOutbound(server),
+      {tag: 'direct', protocol: 'freedom', settings: {}},
+      {tag: 'block', protocol: 'blackhole', settings: {}},
+    ],
+    routing: buildRoutingRules(routingMode, customDomains),
+  };
+}
diff --git a/chrome/browser/resources/webui_browser/vis_vpn_links.ts b/chrome/browser/resources/webui_browser/vis_vpn_links.ts
new file mode 100644
index 0000000000..af5f664b91
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_vpn_links.ts
@@ -0,0 +1,189 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: parses vless://, vmess://, trojan:// and ss:// share links and
+// subscription bodies. Ported from vpn-extension/lib/links.js (itself ported
+// from legacy-electron/vpn-manager.js _parseLink/_parseSub), unchanged except
+// for types, so it stays pure TypeScript with no privileged API.
+
+export interface VpnServer {
+  type: 'vmess'|'vless'|'trojan'|'shadowsocks';
+  name: string;
+  address: string;
+  port: number;
+  uuid?: string;
+  password?: string;
+  method?: string;
+  alterId?: number;
+  network?: string;
+  path?: string;
+  host?: string;
+  tls?: boolean;
+  security?: string;
+  flow?: string;
+  sni?: string;
+  fp?: string;
+  pbk?: string;
+  sid?: string;
+}
+
+function b64decode(text: string): string {
+  let s = text.replace(/\s+/g, '').replace(/-/g, '+').replace(/_/g, '/');
+  while (s.length % 4) s += '=';
+  const bin = atob(s);
+  return new TextDecoder().decode(Uint8Array.from(bin, c => c.charCodeAt(0)));
+}
+
+function safeDecode(s: string): string {
+  try {
+    return decodeURIComponent(s);
+  } catch {
+    return s;
+  }
+}
+
+function validPort(p: number): boolean {
+  return Number.isInteger(p) && p > 0 && p < 65536;
+}
+
+function parseVmess(link: string): VpnServer {
+  const j = JSON.parse(b64decode(link.slice(8)));
+  return {
+    type: 'vmess',
+    name: j.ps || j.add || 'VMess',
+    address: j.add,
+    port: parseInt(j.port, 10),
+    uuid: j.id,
+    alterId: parseInt(j.aid, 10) || 0,
+    network: j.net || 'tcp',
+    path: j.path || '/',
+    host: j.host || '',
+    tls: j.tls === 'tls',
+    sni: j.sni || j.host || '',
+    fp: j.fp || '',
+  };
+}
+
+// URL() only parses host/port/userinfo for schemes it knows, so borrow http's parser.
+function parseUrlLike(link: string, scheme: string): {u: URL, p: Record<string, string>} {
+  const u = new URL('http://' + link.slice(scheme.length + 3));
+  return {u, p: Object.fromEntries(u.searchParams)};
+}
+
+function parseVless(link: string): VpnServer {
+  const {u, p} = parseUrlLike(link, 'vless');
+  return {
+    type: 'vless',
+    name: u.hash ? safeDecode(u.hash.slice(1)) : (u.hostname || 'VLESS'),
+    address: u.hostname,
+    port: parseInt(u.port, 10),
+    uuid: safeDecode(u.username),
+    network: p['type'] || 'tcp',
+    security: p['security'] || 'none',
+    path: p['path'] || '/',
+    host: p['host'] || '',
+    flow: p['flow'] || '',
+    sni: p['sni'] || p['servername'] || '',
+    fp: p['fp'] || 'chrome',
+    pbk: p['pbk'] || '',
+    sid: p['sid'] || '',
+  };
+}
+
+function parseTrojan(link: string): VpnServer {
+  const {u, p} = parseUrlLike(link, 'trojan');
+  return {
+    type: 'trojan',
+    name: u.hash ? safeDecode(u.hash.slice(1)) : (u.hostname || 'Trojan'),
+    address: u.hostname,
+    port: parseInt(u.port, 10),
+    uuid: safeDecode(u.username),  // the trojan password
+    network: p['type'] || 'tcp',
+    security: p['security'] || 'tls',
+    sni: p['sni'] || '',
+    fp: p['fp'] || 'chrome',
+    path: p['path'] || '/',
+    host: p['host'] || '',
+  };
+}
+
+// Two forms exist: ss://base64(method:password)@host:port#name
+// and the older ss://base64(method:password@host:port)#name
+function parseShadowsocks(link: string): VpnServer|null {
+  let main = link.slice(5);
+  let name = 'Shadowsocks';
+  const hashAt = main.indexOf('#');
+  if (hashAt !== -1) {
+    name = safeDecode(main.slice(hashAt + 1)) || name;
+    main = main.slice(0, hashAt);
+  }
+  main = main.split('?')[0]!.replace(/\/$/, '');
+  if (!main.includes('@')) main = b64decode(main);
+
+  const at = main.lastIndexOf('@');
+  if (at === -1) return null;
+  let auth = main.slice(0, at);
+  if (!auth.includes(':')) auth = b64decode(auth);
+  const colon = auth.indexOf(':');
+  if (colon === -1) return null;
+
+  const server = main.slice(at + 1);
+  const portAt = server.lastIndexOf(':');
+  if (portAt === -1) return null;
+
+  return {
+    type: 'shadowsocks',
+    name,
+    address: server.slice(0, portAt).replace(/^\[|\]$/g, ''),
+    port: parseInt(server.slice(portAt + 1), 10),
+    method: auth.slice(0, colon),
+    password: auth.slice(colon + 1),
+  };
+}
+
+const PARSERS: Record<string, (link: string) => VpnServer|null> = {
+  'vmess://': parseVmess,
+  'vless://': parseVless,
+  'trojan://': parseTrojan,
+  'ss://': parseShadowsocks,
+};
+
+/** Returns a server object, or null when the link is not one we understand. */
+export function parseLink(link: string): VpnServer|null {
+  const text = (link || '').trim();
+  for (const [prefix, parse] of Object.entries(PARSERS)) {
+    if (!text.startsWith(prefix)) continue;
+    try {
+      const s = parse(text);
+      if (s && s.address && validPort(s.port)) return s;
+    } catch {
+      /* malformed link */
+    }
+    return null;
+  }
+  return null;
+}
+
+export function parseLinks(text: string): VpnServer[] {
+  return (text || '').split(/\r?\n/).map(parseLink).filter((s): s is VpnServer => s !== null);
+}
+
+/** A subscription body is either base64 of a link list or the plain list itself. */
+export function parseSubscription(raw: string): VpnServer[] {
+  try {
+    const decoded = b64decode(raw);
+    if (decoded.includes('://')) {
+      const servers = parseLinks(decoded);
+      if (servers.length) return servers;
+    }
+  } catch {
+    /* not base64 */
+  }
+  return parseLinks(raw);
+}
+
+/** Identity used to detect duplicates and to find the connected server in the list. */
+export function serverKey(s: VpnServer): string {
+  return [s.type, s.address, s.port, s.uuid || s.password || ''].join('|');
+}
diff --git a/chrome/browser/resources/webui_browser/vis_vpn_routing.ts b/chrome/browser/resources/webui_browser/vis_vpn_routing.ts
new file mode 100644
index 0000000000..98a436a31d
--- /dev/null
