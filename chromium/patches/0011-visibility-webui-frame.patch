+}
+
+@keyframes rise {
+  from {
+    opacity: 0;
+    transform: translateY(22px) scale(0.9);
+  }
+}
+
+.modal {
+  position: relative;
+  width: 400px;
+  max-width: 92vw;
+  border-radius: 16px;
+  overflow: hidden;
+  background: var(--surface);
+  border: 1px solid var(--line);
