+void WebUIBrowserPageHandler::GetExtensions(GetExtensionsCallback callback) {
+  std::vector<webui_browser::mojom::ExtensionEntryPtr> out;
+  BrowserWindowInterface* browser = GetBrowser();
+  if (browser) {
+    Profile* profile = browser->GetProfile();
+    extensions::ExtensionRegistry* registry =
+        extensions::ExtensionRegistry::Get(profile);
+    extensions::ManagementPolicy* policy =
+        extensions::ExtensionSystem::Get(profile)->management_policy();
+    const extensions::ExtensionSet installed =
+        registry->GenerateInstalledExtensionsSet(
+            extensions::ExtensionRegistry::ENABLED |
+            extensions::ExtensionRegistry::DISABLED |
+            extensions::ExtensionRegistry::TERMINATED);
+    for (const auto& extension : installed) {
+      if (!extensions::ui_util::ShouldDisplayInExtensionSettings(*extension)) {
+        continue;
+      }
+      const bool removable =
+          !policy || policy->UserMayModifySettings(extension.get(), nullptr);
+      out.push_back(webui_browser::mojom::ExtensionEntry::New(
+          extension->id(), extension->name(),
+          extensions::DescriptionInfo::GetDescription(*extension),
+          extension->VersionString(),
+          registry->enabled_extensions().Contains(extension->id()),
+          removable));
+    }
+    std::ranges::sort(out, [](const auto& a, const auto& b) {
+      return a->name < b->name;
+    });
+  }
+  std::move(callback).Run(std::move(out));
+}
+
+void WebUIBrowserPageHandler::SetExtensionEnabled(const std::string& id,
+                                                  bool enabled) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser) {
+    return;
+  }
+  auto* registrar =
+      extensions::ExtensionRegistrar::Get(browser->GetProfile());
+  if (enabled) {
+    registrar->EnableExtension(id);
+  } else {
+    registrar->DisableExtension(
+        id, {extensions::disable_reason::DISABLE_USER_ACTION});
+  }
+}
+
+void WebUIBrowserPageHandler::UninstallExtension(const std::string& id) {
+  BrowserWindowInterface* browser = GetBrowser();
+  if (!browser) {
+    return;
+  }
+  std::u16string error;
+  extensions::ExtensionRegistrar::Get(browser->GetProfile())
+      ->UninstallExtension(id, extensions::UNINSTALL_REASON_USER_INITIATED,
+                           &error);
+}
