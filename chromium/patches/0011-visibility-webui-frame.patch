+ * location-icon button instead of the native PageInfoBubbleView. */
+:host {
+  --surface: #1e202a;
+  --raised: #262936;
+  --line: rgba(255, 255, 255, 8%);
+  --text: #f8fafc;
+  --muted: #94a3b8;
+  --indigo: #818cf8;
