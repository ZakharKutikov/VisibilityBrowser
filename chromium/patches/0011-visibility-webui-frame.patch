+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {VisDownloadsElement} from './vis_downloads.js';
+
+export function getHtml(this: VisDownloadsElement) {
+  return html`<!--_html_template_start_-->
+<section class="panel" role="dialog" aria-labelledby="downloadsTitle"
+    @keydown="${this.onKeydown}">
+  <header class="head">
+    <h2 class="title" id="downloadsTitle">
+      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
+          stroke="currentColor" stroke-width="2" stroke-linecap="round"
+          stroke-linejoin="round" aria-hidden="true">
+        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
+        <polyline points="7,10 12,15 17,10"/>
+        <line x1="12" y1="15" x2="12" y2="3"/></svg>
+      ${this.t('downloads')}
+    </h2>
+    <button class="close" aria-label="${this.t('close')}"
+        @click="${this.onCloseClick}">
+      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
+          stroke="currentColor" stroke-width="2" stroke-linecap="round"
+          stroke-linejoin="round" aria-hidden="true">
+        <line x1="18" y1="6" x2="6" y2="18"/>
+        <line x1="6" y1="6" x2="18" y2="18"/></svg>
+    </button>
+  </header>
+
+  <div class="list">
+    ${this.items.length === 0 ? html`
+      <div class="empty">
+        <svg width="48" height="48" viewBox="0 0 24 24" fill="none"
+            stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
+            stroke-linejoin="round" aria-hidden="true">
+          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
+          <polyline points="7,10 12,15 17,10"/>
+          <line x1="12" y1="15" x2="12" y2="3"/></svg>
+        <span class="empty-text">${this.t('downloadsEmpty')}</span>
+        <span class="empty-hint">${this.t('downloadsEmptyHint')}</span>
+      </div>` : ''}
+    ${this.items.map(item => html`
+      <article class="item">
+        <div class="item-head">
+          <span class="file-icon" aria-hidden="true">
+            ${this.extensionOf(item)}</span>
+          <div class="info">
+            <div class="file-name" title="${item.fileName}">${item.fileName}</div>
+            <div class="status">${this.statusOf(item)}</div>
+          </div>
+        </div>
+        ${this.isActive(item) ? html`
+          <div class="bar"><span style="width:${this.percentOf(item)}%"></span>
+          </div>` : ''}
+        <div class="actions">
+          ${this.isComplete(item) ? html`
+            <button class="action" data-id="${item.id}" data-action="open"
+                @click="${this.onActionClick}">${this.t('dlOpen')}</button>
+            <button class="action" data-id="${item.id}" data-action="folder"
+                @click="${this.onActionClick}">${this.t('dlFolder')}</button>
+          ` : ''}
+          ${this.isActive(item) ? html`
+            <button class="action" data-id="${item.id}"
+                data-action="${item.paused ? 'resume' : 'pause'}"
+                @click="${this.onActionClick}">
+              ${item.paused ? this.t('dlResume') : this.t('dlPause')}</button>
+            <button class="action danger" data-id="${item.id}"
+                data-action="cancel" @click="${this.onActionClick}">
+              ${this.t('dlCancel')}</button>
+          ` : html`
+            <button class="action" data-id="${item.id}" data-action="remove"
+                @click="${this.onActionClick}">${this.t('dlRemove')}</button>
+          `}
+        </div>
+      </article>`)}
+  </div>
+</section>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/vis_downloads.ts b/chrome/browser/resources/webui_browser/vis_downloads.ts
new file mode 100644
index 0000000000..830cad2eb9
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_downloads.ts
@@ -0,0 +1,163 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: the downloads flyout of Visibility 2.1 — a glass card under the
+// toolbar with each download, its progress and actions. While it is open the
+// list is refreshed every second.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {DownloadEntry} from './browser.mojom-webui.js';
+import {browserProxyFactory, DownloadActionType} from './browser.mojom-webui.js';
+import {getCss} from './vis_downloads.css.js';
+import {getHtml} from './vis_downloads.html.js';
+import {t} from './vis_settings.js';
+
+const ACTIONS: Record<string, DownloadActionType> = {
+  open: DownloadActionType.kOpen,
+  folder: DownloadActionType.kShowInFolder,
+  pause: DownloadActionType.kPause,
+  resume: DownloadActionType.kResume,
+  cancel: DownloadActionType.kCancel,
+  remove: DownloadActionType.kRemove,
+};
+
+function formatBytes(bytes: number): string {
+  const ru = t('downloads') === 'Загрузки';
+  const units = ru ? ['Б', 'КБ', 'МБ', 'ГБ'] : ['B', 'KB', 'MB', 'GB'];
+  let value = bytes;
+  let unit = 0;
+  while (value >= 1024 && unit < units.length - 1) {
+    value /= 1024;
+    unit++;
+  }
+  return `${value.toFixed(value < 10 && unit > 0 ? 1 : 0)} ${units[unit]}`;
+}
+
+export class VisDownloadsElement extends CrLitElement {
+  static get is() {
+    return 'vis-downloads';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+      items: {state: true, type: Array},
+    };
+  }
+
+  accessor open: boolean = false;
+  accessor items: DownloadEntry[] = [];
+  private timer_: number = 0;
+
+  readonly t = t;
+
+  toggle() {
+    if (this.open) {
+      this.hide();
+    } else {
+      this.show();
+    }
+  }
+
+  show() {
+    this.open = true;
+    this.refresh_();
+    window.clearInterval(this.timer_);
+    this.timer_ = window.setInterval(() => this.refresh_(), 1000);
+  }
+
+  hide() {
+    this.open = false;
+    window.clearInterval(this.timer_);
+  }
+
+  private async refresh_() {
+    const {downloads} =
+        await browserProxyFactory.getInstance().handler.getDownloads();
+    this.items = downloads;
+  }
+
+  percentOf(item: DownloadEntry): number {
+    if (item.state === 'complete') {
+      return 100;
+    }
+    return item.totalBytes > 0 ?
+        Math.min(100, Math.round(item.receivedBytes / item.totalBytes * 100)) :
+        0;
+  }
+
+  statusOf(item: DownloadEntry): string {
+    switch (item.state) {
+      case 'complete':
+        return item.totalBytes > 0 ? formatBytes(item.totalBytes) :
+                                     t('dlDone');
+      case 'cancelled':
+        return t('dlCancelled');
+      case 'interrupted':
+        return t('dlFailed');
+      default: {
+        const done = formatBytes(item.receivedBytes);
+        const size = item.totalBytes > 0 ?
+            `${done} / ${formatBytes(item.totalBytes)}` :
+            done;
+        return item.paused ? `${t('dlPaused')} · ${size}` : size;
+      }
+    }
+  }
+
+  isActive(item: DownloadEntry): boolean {
+    return item.state === 'in_progress';
+  }
+
+  isComplete(item: DownloadEntry): boolean {
+    return item.state === 'complete';
+  }
+
+  extensionOf(item: DownloadEntry): string {
+    const dot = item.fileName.lastIndexOf('.');
+    return dot > 0 ? item.fileName.slice(dot + 1, dot + 5).toUpperCase() : '';
+  }
+
+  // ---------- template handlers ----------
+
+  onCloseClick() {
+    this.hide();
+  }
+
+  onKeydown(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.stopPropagation();
+      this.hide();
+    }
+  }
+
+  onActionClick(e: Event) {
+    const target = e.currentTarget as HTMLElement;
+    const id = Number(target.dataset['id']);
+    const action = ACTIONS[target.dataset['action'] || ''];
+    if (action === undefined) {
+      return;
+    }
+    browserProxyFactory.getInstance().handler.downloadAction(id, action);
+    window.setTimeout(() => this.refresh_(), 150);
+  }
+
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-downloads': VisDownloadsElement;
+  }
+}
+
+customElements.define(VisDownloadsElement.is, VisDownloadsElement);
