+void WebUIBrowserPageHandler::GetDownloads(GetDownloadsCallback callback) {
+  std::vector<webui_browser::mojom::DownloadEntryPtr> out;
+  BrowserWindowInterface* browser = GetBrowser();
+  content::DownloadManager* manager =
+      browser ? browser->GetProfile()->GetDownloadManager() : nullptr;
+  if (manager) {
+    std::vector<raw_ptr<download::DownloadItem, VectorExperimental>> items;
+    manager->GetAllDownloads(&items);
+    std::ranges::sort(items, [](const auto& a, const auto& b) {
+      return a->GetStartTime() > b->GetStartTime();
+    });
+    for (download::DownloadItem* item : items) {
+      if (item->IsTemporary() || item->IsTransient()) {
+        continue;
+      }
+      std::string state;
+      switch (item->GetState()) {
+        case download::DownloadItem::IN_PROGRESS:
+          state = "in_progress";
+          break;
+        case download::DownloadItem::COMPLETE:
+          state = "complete";
+          break;
+        case download::DownloadItem::CANCELLED:
+          state = "cancelled";
+          break;
+        default:
+          state = "interrupted";
+          break;
+      }
+      out.push_back(webui_browser::mojom::DownloadEntry::New(
+          item->GetId(), item->GetFileNameToReportUser().AsUTF8Unsafe(),
+          item->GetURL().spec(), state, item->IsPaused(),
+          static_cast<double>(item->GetReceivedBytes()),
+          static_cast<double>(std::max<int64_t>(item->GetTotalBytes(), 0)),
+          item->GetStartTime().InMillisecondsFSinceUnixEpoch()));
+      if (out.size() == 100) {
+        break;
+      }
+    }
+  }
+  std::move(callback).Run(std::move(out));
+}
+
+void WebUIBrowserPageHandler::DownloadAction(
+    uint32_t id,
+    webui_browser::mojom::DownloadActionType action) {
+  BrowserWindowInterface* browser = GetBrowser();
+  content::DownloadManager* manager =
+      browser ? browser->GetProfile()->GetDownloadManager() : nullptr;
+  download::DownloadItem* item = manager ? manager->GetDownload(id) : nullptr;
+  if (!item) {
+    return;
+  }
+  using Action = webui_browser::mojom::DownloadActionType;
+  switch (action) {
+    case Action::kOpen:
+      if (item->GetState() == download::DownloadItem::COMPLETE) {
+        item->OpenDownload();
+      }
+      break;
+    case Action::kShowInFolder:
+      platform_util::ShowItemInFolder(browser->GetProfile(),
+                                      item->GetTargetFilePath());
+      break;
+    case Action::kPause:
+      item->Pause();
+      break;
+    case Action::kResume:
+      item->Resume(/*user_resume=*/true);
+      break;
+    case Action::kCancel:
+      item->Cancel(/*user_cancel=*/true);
+      break;
+    case Action::kRemove:
+      item->Remove();
+      break;
+  }
+}
