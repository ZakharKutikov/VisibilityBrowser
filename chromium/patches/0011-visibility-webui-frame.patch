+    std::move(callback).Run(std::vector<int32_t>(targets.size(), -1));
+    return;
+  }
+  std::vector<VisibilityVpnService::PingTarget> native_targets;
+  native_targets.reserve(targets.size());
+  for (const auto& t : targets) {
+    native_targets.push_back({t->address, t->port});
+  }
+  VisibilityVpnServiceFactory::GetForProfile(vpn_profile_)
+      ->Ping(std::move(native_targets), std::move(callback));
+}
+
+void WebUIBrowserPageHandler::RespondToPermissionPrompt(
+    webui_browser::mojom::PermissionPromptAnswer answer) {
+  WebUIBrowserWindow* window = GetBrowserWindow();
+  if (!window) {
+    return;
+  }
+  if (WebUIBrowserPermissionPrompt* prompt =
+          window->GetActivePermissionPrompt()) {
+    // `prompt` may be destroyed by this call; nothing else touches it after.
+    prompt->Respond(answer);
+  }
+}
