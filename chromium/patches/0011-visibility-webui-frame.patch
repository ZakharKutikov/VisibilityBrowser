+/* Copyright 2026 The Chromium Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+/* Visibility: the 2.1 permission popup (index.html's #permission-popup +
+ * renderer.js's permMeta()/processPermQueue()), now anchored under the
+ * toolbar instead of the native omnibox's security icon -- the frame does
+ * not yet have its own address bar to measure, so the position is fixed
+ * rather than computed from an icon's getBoundingClientRect() like 2.1 did. */
+:host {
+  --surface: #1e202a;
+  --line: rgba(255, 255, 255, 8%);
+  --text: #f8fafc;
+  --muted: #94a3b8;
+  --indigo: #818cf8;
+  --indigo-hover: #93a0f9;
+  --ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
+
+  position: fixed;
+  top: 54px;
+  left: 16px;
+  z-index: 960;
+  display: none;
+  width: 340px;
+  font-family: 'Inter', 'Segoe UI Variable Text', 'Segoe UI', system-ui,
+      sans-serif;
+  font-size: 13px;
+  line-height: 1.45;
+  color: var(--text);
+}
+
+:host([open]) {
+  display: block;
+}
+
+.card {
+  background: var(--surface);
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  box-shadow: 0 12px 40px rgba(0, 0, 0, 50%), 0 0 0 1px rgba(255, 255, 255, 4%);
+  overflow: hidden;
+  transform-origin: 28px 0;
+  opacity: 0;
+  transform: scale(0.95) translateY(-6px);
+  transition: opacity 180ms var(--ease-spring),
+      transform 180ms var(--ease-spring);
+}
+
+:host([showing]) .card {
+  opacity: 1;
+  transform: scale(1) translateY(0);
+}
+
+h1,
+p {
+  margin: 0;
+  padding: 0;
+}
+
+.header {
+  padding: 16px 18px 12px;
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+}
+
+.icon-circle {
+  width: 36px;
+  height: 36px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+.header-text {
+  flex: 1;
+  min-width: 0;
+}
+
+.title {
+  font-size: 13px;
+  font-weight: 700;
+  color: var(--text);
+  margin-bottom: 4px;
+}
+
+.origin {
+  font-size: 11px;
+  color: var(--muted);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.desc {
+  padding: 0 18px 14px;
+  font-size: 12px;
+  color: var(--muted);
+  line-height: 1.5;
+}
+
+.actions {
+  padding: 0 14px 14px;
+  display: flex;
+  gap: 8px;
+}
+
+button {
+  font: inherit;
+  color: inherit;
+}
+
+.btn {
+  flex: 1;
+  padding: 9px 0;
+  border-radius: 8px;
+  font-size: 12px;
+  font-weight: 600;
+  cursor: pointer;
+  border: 1px solid var(--line);
+  transition: background-color 150ms, color 150ms;
+  text-align: center;
+  background: transparent;
+  color: var(--muted);
+}
+
+.btn-deny:hover {
+  background: rgba(255, 255, 255, 6%);
+  color: var(--text);
+}
+
+.btn-allow {
+  background: var(--indigo);
+  color: #0d0e12;
+  border-color: var(--indigo);
+}
+
+.btn-allow:hover {
+  background: var(--indigo-hover);
+}
+
+:focus-visible {
+  outline: 2px solid var(--indigo);
+  outline-offset: 2px;
+}
