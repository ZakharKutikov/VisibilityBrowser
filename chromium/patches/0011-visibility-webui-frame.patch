+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {VisMenuElement} from './vis_menu.js';
+
+export function getHtml(this: VisMenuElement) {
+  return html`<!--_html_template_start_-->
+<div class="backdrop" @click="${this.onBackdropClick}"></div>
+<div class="menu" role="menu" @keydown="${this.onKeydown}">
+  ${this.groups.map(group => html`
+    <div class="group" role="group">
+      ${group.map(item => html`
+        <button class="item" role="menuitem" data-key="${item.key}"
+            @click="${this.onItemClick}">
+          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
+              stroke="currentColor" stroke-width="2" stroke-linecap="round"
+              stroke-linejoin="round" aria-hidden="true">
+            <path d="${item.icon}"/></svg>
+          <span class="label">${item.label}</span>
+          <kbd>${item.shortcut}</kbd>
+        </button>`)}
+    </div>`)}
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/webui_browser/vis_menu.ts b/chrome/browser/resources/webui_browser/vis_menu.ts
new file mode 100644
index 0000000000..855747b259
--- /dev/null
+++ b/chrome/browser/resources/webui_browser/vis_menu.ts
@@ -0,0 +1,147 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Visibility: the main menu (the "⋮" button), a dark glass dropdown in the
+// style of Visibility 2.1 instead of Chrome's native app menu. Choosing an
+// item fires 'menu-item' with the item's key; the frame decides what to do.
+
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './vis_menu.css.js';
+import {getHtml} from './vis_menu.html.js';
+import {t} from './vis_settings.js';
+
+export interface MenuItem {
+  key: string;
+  label: string;
+  shortcut: string;
+  // SVG path data drawn with the 2.1 icon style (24x24, stroke 2).
+  icon: string;
+}
+
+const RU = t('downloads') === 'Загрузки';
+const L = (ru: string, en: string) => RU ? ru : en;
+
+export const MENU_GROUPS: MenuItem[][] = [
+  [
+    {key: 'newTab', label: L('Новая вкладка', 'New tab'), shortcut: 'Ctrl+T',
+     icon: 'M12 5v14M5 12h14'},
+    {key: 'newWindow', label: L('Новое окно', 'New window'),
+     shortcut: 'Ctrl+N', icon: 'M3 5h18v14H3zM3 9h18'},
+    {key: 'incognito', label: L('Окно инкогнито', 'Incognito window'),
+     shortcut: 'Ctrl+Shift+N',
+     icon: 'M2 15s3 4 10 4 10-4 10-4M7 10a3 3 0 1 0 0 .01M17 10a3 3 0 1 0 0 .01'},
+  ],
+  [
+    {key: 'history', label: L('История', 'History'), shortcut: 'Ctrl+H',
+     icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 6v6l4 2'},
+    {key: 'downloads', label: L('Загрузки', 'Downloads'), shortcut: 'Ctrl+J',
+     icon: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3'},
+    {key: 'bookmarks', label: L('Закладки', 'Bookmarks'),
+     shortcut: 'Ctrl+Shift+O',
+     icon: 'M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z'},
+    {key: 'extensions', label: L('Расширения', 'Extensions'), shortcut: '',
+     icon: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z'},
+  ],
+  [
+    {key: 'find', label: L('Найти на странице', 'Find on page'),
+     shortcut: 'Ctrl+F',
+     icon: 'M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16zM21 21l-4.35-4.35'},
+    {key: 'print', label: L('Печать', 'Print'), shortcut: 'Ctrl+P',
+     icon: 'M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z'},
+    {key: 'save', label: L('Сохранить страницу', 'Save page'),
+     shortcut: 'Ctrl+S',
+     icon: 'M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2zM17 21v-8H7v8M7 3v5h8'},
+    {key: 'fullscreen', label: L('Во весь экран', 'Full screen'),
+     shortcut: 'F11',
+     icon: 'M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3'},
+  ],
+  [
+    {key: 'devtools', label: L('Инструменты разработчика', 'Developer tools'),
+     shortcut: 'Ctrl+Shift+I', icon: 'M16 18l6-6-6-6M8 6l-6 6 6 6'},
+    {key: 'taskManager', label: L('Диспетчер задач', 'Task manager'),
+     shortcut: 'Shift+Esc', icon: 'M22 12h-4l-3 9L9 3l-3 9H2'},
+  ],
+  [
+    {key: 'settings', label: L('Настройки', 'Settings'), shortcut: '',
+     icon: 'M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12'},
+    {key: 'exit', label: L('Выход', 'Exit'), shortcut: '',
+     icon: 'M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9'},
+  ],
+];
+
+export class VisMenuElement extends CrLitElement {
+  static get is() {
+    return 'vis-menu';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      open: {type: Boolean, reflect: true},
+    };
+  }
+
+  accessor open: boolean = false;
+  readonly groups = MENU_GROUPS;
+
+  toggle() {
+    this.open = !this.open;
+    if (this.open) {
+      this.updateComplete.then(() => {
+        this.shadowRoot.querySelector<HTMLElement>('.item')?.focus();
+      });
+    }
+  }
+
+  hide() {
+    this.open = false;
+  }
+
+  // ---------- template handlers ----------
+
+  onBackdropClick() {
+    this.hide();
+  }
+
+  onItemClick(e: Event) {
+    const key = (e.currentTarget as HTMLElement).dataset['key'];
+    this.hide();
+    if (key) {
+      this.fire('menu-item', key);
+    }
+  }
+
+  onKeydown(e: KeyboardEvent) {
+    if (e.key === 'Escape') {
+      e.stopPropagation();
+      this.hide();
+      return;
+    }
+    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') {
+      return;
+    }
+    e.preventDefault();
+    const items =
+        Array.from(this.shadowRoot.querySelectorAll<HTMLElement>('.item'));
+    const index = items.indexOf(this.shadowRoot.activeElement as HTMLElement);
+    const step = e.key === 'ArrowDown' ? 1 : -1;
+    items[(index + step + items.length) % items.length]?.focus();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'vis-menu': VisMenuElement;
+  }
+}
+
+customElements.define(VisMenuElement.is, VisMenuElement);
