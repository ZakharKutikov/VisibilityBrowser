# Development build: fast incremental rebuilds, not for distribution.
is_debug = false
is_component_build = true
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
target_cpu = "x64"

# Visibility: drop Google services that have no place in our browser.
enable_hangout_services_extension = false
enable_service_discovery = false
