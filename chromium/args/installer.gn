# Installer build: a normal optimised (non-component) browser packed into
# mini_installer.exe. Lighter than release.gn (no official-build LTO), so it
# fits in 32 GB of RAM and builds in roughly the time of the first dev build.
is_debug = false
is_component_build = false
is_official_build = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
target_cpu = "x64"

# H.264 / AAC playback. These codecs carry patent licences; see docs/BUILD.md.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

enable_widevine = true
