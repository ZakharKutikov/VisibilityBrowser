{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "3.0.0",
  "default_locale": "ru",
  "minimum_chrome_version": "120",
  "icons": {
    "128": "icons/icon.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "incognito": "split",
  "permissions": [
    "topSites",
    "history",
    "favicon",
    "storage",
    "search"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://ipwhois.app/*",
    "https://wttr.in/*",
    "https://suggestqueries.google.com/*"
  ]
}
